---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import RaceCalendar from "../components/RaceCalendar.astro";
import TwoColumnSection from "../components/TwoColumnSection.astro";
import Standings from "../components/Standings.astro";
import LatestPosts from "../components/LatestPosts.astro";
import FeaturesGrid from "../components/FeaturesGrid.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import race01 from "../assets/section/racei1.jpg";
import race02 from "../assets/section/racei2.jpg";
import aus04 from "../assets/circuits/01australia/aus04.jpg";
import raceseqWebm from "../assets/videos/raceseqComp.webm";
import raceseqMp4 from "../assets/videos/raceseq.mp4";

const features = [
  {
    title: "Driver Profiles",
    description:
      "Explore in-depth profiles of the drivers competing in the FORMULA 1™ championship.",
    icon: "mdi:account-search",
    href: "/seasons/2026/drivers",
  },
  {
    title: "Constructor Profiles",
    description:
      "Discover the constructors shaping the FORMULA 1™ grid in the recent seasons.",
    icon: "mdi:train-car-autorack",
    href: "/seasons/2026/constructors",
  },
  {
    title: "Championship Standings",
    description:
      "Follow the latest driver and constructor standings as the FORMULA 1™ season unfolds.",
    icon: "mdi:format-list-numbered",
    href: "/seasons/2025",
  },
  {
    title: "Race Highlights",
    description:
      "Relive key moments and pivotal decisions from recent FORMULA 1™ races.",
    icon: "mdi:timer",
    href: "/seasons/2025/calendar",
  },
  {
    title: "Season Breakdowns",
    description:
      "Analyze team and driver performances across the FORMULA 1™ season with insights and reviews.",
    icon: "mdi:library-video",
    href: "/seasons",
  },
  {
    title: "F1 Technologies",
    description:
      "Trackside covers the cutting-edge technology driving Formula 1's rapid evolution.",
    icon: "mdi:hammer-wrench",
    href: "/learn/technologies",
  },
  {
    title: "Past Season Archive",
    description:
      "Travel through the rich history of F1 with a look at the 2024 and 2025 seasons.",
    icon: "mdi:box-outline",
    href: "/seasons",
  },
  {
    title: "Fan Community",
    description:
      "Trackside celebrates the passion and excitement of Formula 1 culture.",
    icon: "mdi:account-group",
    href: "/",
  },
];
---

<!doctype html>
<html lang="en" class="bg-zinc-100 dark:bg-zinc-900">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="bg-zinc-100 dark:bg-zinc-900">
      <!-- Hero Section -->
      <section class="bg-zinc-100 pb-10 dark:bg-zinc-900">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="text-center">
            <h1
              class="mx-auto mb-4 max-w-4xl text-4xl font-bold leading-tight text-zinc-900 sm:text-5xl sm:leading-tight lg:text-6xl lg:leading-tight dark:text-zinc-100"
            >
              Your Trackside View of Formula 1
            </h1>
            <p
              class="mx-auto max-w-3xl px-6 text-lg text-zinc-800 dark:text-zinc-300"
            >
              Experience F1 through a fan's perspective. Get the latest race
              insights, driver profiles, and in-depth analysis of the world's
              most exciting motorsport.
            </p>
            <div
              class="mt-9 flex flex-col items-center space-y-4 sm:flex-row sm:justify-center sm:space-x-5 sm:space-y-0"
            >
              <!-- Primary Button -->
              <a
                href="/seasons/2025"
                class="inline-block rounded border-2 border-rose-400 bg-rose-600 px-4 py-2 text-white transition-colors duration-300 hover:bg-rose-700 dark:border-rose-500 dark:hover:border-rose-600 dark:hover:bg-rose-800"
                role="button"
              >
                Explore the 2025 Season
              </a>
              <!-- Secondary Button -->
              <a
                href="/blog"
                class="inline-flex items-center justify-center rounded border-2 border-transparent bg-zinc-600 px-4 py-2 text-white transition-all duration-300 hover:bg-zinc-700 dark:bg-zinc-700 dark:hover:border-zinc-600 dark:hover:bg-zinc-800"
                role="button"
              >
                Read Our Blog
              </a>
            </div>
          </div>
        </div>

        {/* Hero video */}
        <div>
          <div class="relative mx-auto mt-4 overflow-hidden md:mt-8">
            <div class="rounded-xl shadow-lg lg:mx-auto lg:max-w-7xl">
              <video
                class="h-full w-full rounded-xl object-cover"
                autoplay
                muted
                loop
                playsinline
              >
                <source src={raceseqWebm} type="video/webm" />
                <source src={raceseqMp4} type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            </div>
          </div>
        </div>
      </section>

      <!-- Quick Links Section — Timing Board -->
      <section
        class="relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen border-y-2 border-rose-500 bg-zinc-100 dark:border-rose-600 dark:bg-zinc-950"
      >
        <div class="mx-auto grid max-w-7xl grid-cols-2 sm:grid-cols-4">
          <!-- 01 — 2026 Schedule -->
          <a
            href="/seasons/2026"
            class="group relative overflow-hidden border-b border-r border-zinc-300 p-6 transition-colors duration-300 hover:bg-zinc-200/60 sm:border-b-0 sm:p-8 dark:border-zinc-800 dark:hover:bg-zinc-800/50"
          >
            <span
              class="pointer-events-none absolute -right-1 -top-3 select-none text-8xl font-bold leading-none text-zinc-300 transition-colors duration-300 group-hover:text-zinc-400 sm:text-9xl dark:text-zinc-800 dark:group-hover:text-zinc-700"
              style="font-family:'Barlow Condensed',sans-serif;"
              aria-hidden="true">01</span
            >
            <span
              class="w-0.75 absolute left-0 top-0 h-full origin-top scale-y-0 bg-rose-600 transition-transform duration-300 group-hover:scale-y-100"
              aria-hidden="true"></span>
            <div class="relative flex flex-col gap-3">
              <Icon name="mdi:flag-checkered" size={28} class="text-rose-500" />
              <div>
                <p
                  class="text-lg font-bold leading-tight text-zinc-900 sm:text-xl dark:text-zinc-100"
                >
                  2026 Schedule
                </p>
                <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
                  24 races worldwide
                </p>
              </div>
              <span
                class="flex items-center gap-1 text-xs font-semibold tracking-wide text-zinc-600 transition-colors duration-300 group-hover:text-rose-500 dark:text-zinc-500"
              >
                Explore <Icon name="mdi:arrow-right" size={14} />
              </span>
            </div>
          </a>

          <!-- 02 — 2025 Results -->
          <a
            href="/seasons/2025"
            class="group relative overflow-hidden border-b border-zinc-300 p-6 transition-colors duration-300 hover:bg-zinc-200/60 sm:border-b-0 sm:border-r sm:p-8 dark:border-zinc-800 dark:hover:bg-zinc-800/50"
          >
            <span
              class="pointer-events-none absolute -right-1 -top-3 select-none text-8xl font-bold leading-none text-zinc-300 transition-colors duration-300 group-hover:text-zinc-400 sm:text-9xl dark:text-zinc-800 dark:group-hover:text-zinc-700"
              style="font-family:'Barlow Condensed',sans-serif;"
              aria-hidden="true">02</span
            >
            <span
              class="w-0.75 absolute left-0 top-0 h-full origin-top scale-y-0 bg-rose-600 transition-transform duration-300 group-hover:scale-y-100"
              aria-hidden="true"></span>
            <div class="relative flex flex-col gap-3">
              <Icon name="mdi:trophy" size={28} class="text-rose-500" />
              <div>
                <p
                  class="text-lg font-bold leading-tight text-zinc-900 sm:text-xl dark:text-zinc-100"
                >
                  2025 Results
                </p>
                <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
                  Final standings & reviews
                </p>
              </div>
              <span
                class="flex items-center gap-1 text-xs font-semibold tracking-wide text-zinc-600 transition-colors duration-300 group-hover:text-rose-500 dark:text-zinc-500"
              >
                Explore <Icon name="mdi:arrow-right" size={14} />
              </span>
            </div>
          </a>

          <!-- 03 — Latest News -->
          <a
            href="/blog"
            class="group relative overflow-hidden border-r border-zinc-300 p-6 transition-colors duration-300 hover:bg-zinc-200/60 sm:p-8 dark:border-zinc-800 dark:hover:bg-zinc-800/50"
          >
            <span
              class="pointer-events-none absolute -right-1 -top-3 select-none text-8xl font-bold leading-none text-zinc-300 transition-colors duration-300 group-hover:text-zinc-400 sm:text-9xl dark:text-zinc-800 dark:group-hover:text-zinc-700"
              style="font-family:'Barlow Condensed',sans-serif;"
              aria-hidden="true">03</span
            >
            <span
              class="w-0.75 absolute left-0 top-0 h-full origin-top scale-y-0 bg-rose-600 transition-transform duration-300 group-hover:scale-y-100"
              aria-hidden="true"></span>
            <div class="relative flex flex-col gap-3">
              <Icon name="mdi:newspaper" size={28} class="text-rose-500" />
              <div>
                <p
                  class="text-lg font-bold leading-tight text-zinc-900 sm:text-xl dark:text-zinc-100"
                >
                  Latest News
                </p>
                <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
                  Analysis & fan takes
                </p>
              </div>
              <span
                class="flex items-center gap-1 text-xs font-semibold tracking-wide text-zinc-600 transition-colors duration-300 group-hover:text-rose-500 dark:text-zinc-500"
              >
                Explore <Icon name="mdi:arrow-right" size={14} />
              </span>
            </div>
          </a>

          <!-- 04 — Learn F1 -->
          <a
            href="/learn/whatis"
            class="group relative overflow-hidden p-6 transition-colors duration-300 hover:bg-zinc-200/60 sm:p-8 dark:hover:bg-zinc-800/50"
          >
            <span
              class="pointer-events-none absolute -right-1 -top-3 select-none text-8xl font-bold leading-none text-zinc-300 transition-colors duration-300 group-hover:text-zinc-400 sm:text-9xl dark:text-zinc-800 dark:group-hover:text-zinc-700"
              style="font-family:'Barlow Condensed',sans-serif;"
              aria-hidden="true">04</span
            >
            <span
              class="w-0.75 absolute left-0 top-0 h-full origin-top scale-y-0 bg-rose-600 transition-transform duration-300 group-hover:scale-y-100"
              aria-hidden="true"></span>
            <div class="relative flex flex-col gap-3">
              <Icon name="mdi:school" size={28} class="text-rose-500" />
              <div>
                <p
                  class="text-lg font-bold leading-tight text-zinc-900 sm:text-xl dark:text-zinc-100"
                >
                  Learn F1
                </p>
                <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
                  Tech, strategy, history
                </p>
              </div>
              <span
                class="flex items-center gap-1 text-xs font-semibold tracking-wide text-zinc-600 transition-colors duration-300 group-hover:text-rose-500 dark:text-zinc-500"
              >
                Explore <Icon name="mdi:arrow-right" size={14} />
              </span>
            </div>
          </a>
        </div>
      </section>

      <!-- 2025 Highlights Section -->
      <TwoColumnSection
        title="2025 Highlights"
        content="Dive into the most exciting moments of the 2025 Formula 1 season. Explore race highlights, dramatic overtakes, and pivotal decisions that shaped the championship. Watch exclusive clips and read in-depth breakdowns of key races and driver performances."
        ctaText="Explore 2025 Clips & Breakdowns"
        ctaLink="/seasons/2025"
        background="zinc"
        imageSrc={race01}
        imageAlt="F1 Technology"
        imageLoading="eager"
      />

      <!-- Latest Highlight Card -->
      <section class="w-full py-10">
        <div class="mx-auto px-4">
          <a
            href="/seasons/2025"
            class="bg-linear-to-br group relative block overflow-hidden rounded-2xl border border-zinc-300 from-white via-zinc-100 to-zinc-200 shadow-sm transition-all duration-300 hover:shadow-lg dark:border-zinc-700 dark:from-zinc-900 dark:via-zinc-900 dark:to-zinc-800"
          >
            <span
              class="absolute inset-x-0 top-0 h-1 bg-rose-600"
              aria-hidden="true"></span>
            <div class="md:flex">
              <div class="relative md:shrink-0">
                <Image
                  src={aus04}
                  alt="Latest race highlight"
                  widths={[640, 768, 960, 1280, 1536]}
                  sizes="(max-width: 768px) 100vw, (max-width: 1024px) 320px, 384px"
                  quality={92}
                  class="h-64 w-full object-cover md:h-full md:w-80 lg:w-96"
                  loading="eager"
                />
                <div
                  class="bg-linear-to-t absolute inset-x-0 bottom-0 h-24 from-zinc-950/70 to-transparent"
                >
                </div>
              </div>
              <div class="relative px-6 py-8 sm:px-8 sm:py-10">
                <div class="mb-4 flex flex-wrap items-center gap-2">
                  <span
                    class="inline-flex items-center rounded-full border border-rose-300 bg-rose-100 px-2.5 py-1 text-xs font-semibold tracking-wide text-rose-700 dark:border-rose-500/40 dark:bg-rose-900/30 dark:text-rose-300"
                  >
                    Latest Highlight
                  </span>
                  <span
                    class="inline-flex items-center rounded-full border border-zinc-300 bg-zinc-100 px-2.5 py-1 text-xs font-semibold tracking-wide text-zinc-700 dark:border-zinc-600 dark:bg-zinc-800 dark:text-zinc-300"
                  >
                    Round 12
                  </span>
                </div>
                <h3
                  class="text-2xl font-bold leading-tight text-zinc-900 sm:text-3xl dark:text-zinc-100"
                >
                  Latest Highlight: Dramatic Race Moment
                </h3>
                <p class="mt-3 max-w-2xl text-zinc-700 dark:text-zinc-300">
                  A decisive moment from the most recent Grand Prix — an
                  on-track overtake that changed the race outcome. Read the
                  breakdown and see the key moments and analysis.
                </p>
                <div class="mt-6 flex flex-wrap items-center gap-4">
                  <span
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-600 dark:text-zinc-400"
                  >
                    <Icon name="mdi:clock-outline" size={16} />
                    4 min read
                  </span>
                  <span
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-600 dark:text-zinc-400"
                  >
                    <Icon name="mdi:chart-line" size={16} />
                    Strategy Analysis
                  </span>
                </div>
                <div class="mt-7">
                  <span
                    class="inline-flex items-center gap-2 rounded border-2 border-rose-500 bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition-colors duration-200 hover:bg-rose-700 dark:border-rose-500 dark:bg-rose-700 dark:hover:bg-rose-800"
                  >
                    Read Highlight
                    <Icon name="mdi:arrow-right" size={16} />
                  </span>
                </div>
              </div>
            </div>
          </a>
        </div>
      </section>

      <!-- Features Grid Section -->
      <FeaturesGrid
        title="What Trackside is about"
        features={features}
        columns={2}
      />

      <!-- Learn Pages Two-Column Teaser -->
      <TwoColumnSection
        title="Learn about the tech, strategy, and history of F1"
        content={`<p>Explore deep-dive explainers on aerodynamics, simulations, race strategy, and the tech that powers modern Formula 1. Our Learn section breaks complex topics into approachable reads with diagrams and examples.`}
        ctaText="Explore what makes Formula 1"
        ctaLink="/learn/whatis"
        background="zinc"
        imageSrc={race01}
        imageAlt="F1 Technology"
      />

      <!-- Standings Section -->
      <section class="bg-zinc-100 py-16 dark:bg-zinc-900">
        <div class="container mx-auto px-4">
          <header class="mb-8 text-center">
            <p
              class="mb-3 text-sm font-semibold uppercase tracking-[0.28em] text-rose-600 dark:text-rose-400"
            >
              Championship Standings
            </p>
            <h2
              class="text-4xl font-bold leading-none text-zinc-900 sm:text-5xl dark:text-zinc-100"
            >
              2026 Title Race Snapshot
            </h2>
            <p
              class="mx-auto mt-3 max-w-2xl text-base text-zinc-600 dark:text-zinc-300"
            >
              Follow the leading drivers, the constructor battle, and the latest
              completed Grand Prix from the current season.
            </p>
          </header>
          <Standings season="2026" />
        </div>
      </section>

      <!-- Race Spotlight Section -->
      <section class="bg-zinc-100 py-12 dark:bg-zinc-900">
        <div class="container mx-auto px-4">
          <header class="mb-12 text-center">
            <h2 class="text-3xl font-bold dark:text-zinc-100">
              2026 Race Calendar
            </h2>
            <p class="mt-2 text-lg text-zinc-600 dark:text-zinc-300">
              A look at the previous, next, and upcoming races on the 2026
              calendar.
            </p>
          </header>
          <RaceCalendar
            season="2026"
            showAllRaces={false}
            showTitle={true}
            eagerCount={0}
          />
        </div>
      </section>

      <!-- FAQs Teaser -->
      <TwoColumnSection
        title="Have questions?"
        content={`<p>Check our FAQs for details about the site, data sources, and how Trackside is maintained. If you can't find an answer, reach out via the contact link.</p>`}
        ctaText="View FAQs"
        ctaLink="/faqs"
        background="white"
        imageSrc={race01}
        imageAlt="FAQ"
        reversed={true}
      />

      <!-- New Blog Component -->
      <LatestPosts />
    </main>
    <Footer />
  </body>
</html>
