---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";

const links = [
  {
    title: "About",
    href: "/about",
    description: "Learn about our mission and the team behind Trackside",
  },
  {
    title: "Contact",
    href: "/contact",
    description: "Get in touch with us for questions or feedback",
  },
  {
    title: "FAQs",
    href: "/about/faqs",
    description: "Find answers to commonly asked questions about F1",
  },
  {
    title: "Attributions",
    href: "/about/attributions",
    description: "Credits and acknowledgments for content and resources",
  },
  {
    title: "Design System",
    href: "/design-system/",
    description: "Credits and acknowledgments for content and resources",
  },
];
---

<html lang="en" class="bg-zinc-100 dark:bg-zinc-900">
  <head>
    <BaseHead title={`More | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />
    <main class="container mx-auto px-4 py-12">
      <h1 class="mb-8 text-4xl font-bold dark:text-zinc-100">
        Trackside Resources
      </h1>
      <p class="mb-12 text-xl text-zinc-600 dark:text-zinc-300">
        Discover additional resources and information about Trackside and
        Formula 1 racing.
      </p>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          links.map(({ title, href, description }) => (
            <a
              href={href}
              class="group block rounded-lg border border-zinc-200 p-6 transition-all duration-300 hover:border-zinc-400 hover:bg-zinc-200 dark:border-zinc-600 dark:bg-zinc-700 dark:hover:border-zinc-600 dark:hover:bg-zinc-800"
            >
              <h2 class="mb-2 dark:text-zinc-100">{title}</h2>
              <p class="text-zinc-600 dark:text-zinc-300">{description}</p>
            </a>
          ))
        }
      </div>
    </main>
    <Footer />
  </body>
</html>
