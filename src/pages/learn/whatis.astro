---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GridSection from "../../components/GridSection.astro";
import TwoColumnSection from "../../components/TwoColumnSection.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import cn02 from "../../assets/circuits/02china/cn02.jpg";
import intro from "../../assets/section/racei1.jpg";
import machinery from "../../assets/section/racei1.jpg";
import drivers from "../../assets/section/racei1.jpg";
import tracks from "../../assets/section/racei1.jpg";
import LatestPosts from "../../components/LatestPosts.astro";

const pageTitle = "What is Formula 1?";
const description =
  "Discover Formula 1, the pinnacle of motorsport, where speed, innovation, and strategy collide to create the ultimate racing spectacle.";

const f1BasicsItems = [
  {
    title: "The Introduction",
    description:
      "Formula 1, often referred to as F1, is the pinnacle of motorsport and one of the most thrilling and prestigious racing championships in the world.",
    image: intro,
    imageAlt: "What is Formula 1",
    pageLink: "/learn/whatis",
  },
  {
    title: "The Machinery",
    description:
      "Formula 1 cars are open-wheel, single-seater vehicles designed for maximum speed and performance.",
    image: machinery,
    imageAlt: "The Machinery",
    pageLink: "/learn/technologies",
  },
  {
    title: "The Drivers",
    description:
      "Behind the wheel are some of the most talented and daring drivers on the planet, competing for glory in a high-stakes environment.",
    image: drivers,
    imageAlt: "The Drivers",
    pageLink: "/seasons/2025/drivers",
  },
  {
    title: "The Tracks",
    description:
      "Races take place on a variety of circuits, ranging from iconic street tracks like Monaco to purpose-built circuits like Silverstone.",
    image: tracks,
    imageAlt: "The Tracks",
    pageLink: "/seasons/2025/races",
  },
];

const f1EssentialsItems = [
  {
    title: "The Basics",
    description:
      "What makes F1 unique? Dive into its structure, speed, and global appeal.",
    href: "#understanding",
  },
  {
    title: "Behind the Machines",
    description: "How F1 cars push the limits of performance and innovation.",
    href: "#technology",
  },
  {
    title: "Future of Racing",
    description:
      "Explore how AI, data, and sustainability are shaping tomorrow's grid.",
    href: "#future",
  },
  {
    title: "Scoring & Standings",
    description:
      "Learn how championships are won by drivers and constructors throughout the season.",
    href: "/seasons/",
  },
  {
    title: "2025 Highlights",
    description:
      "Highlights from the current year showcasing dramatic stories.",
    href: "#",
  },
  {
    title: "2026 Coverage",
    description: "Up-to-date coverage of the 2026 F1 season.",
    href: "/seasons/2026",
  },
];

const championshipCards = [
  {
    label: "Drivers",
    title: "Drivers Championship",
    description:
      "Awarded to the driver who accumulates the most points throughout the season.",
    icon: "mdi:racing-helmet",
    count: "22",
    countLabel: "Drivers Racing",
    battleLabel: "Driver Battle",
    accentBarClass: "bg-rose-600",
    accentTextClass: "text-rose-600 dark:text-rose-400",
  },
  {
    label: "Constructors",
    title: "Constructors Championship",
    description:
      "Teams compete for this title based on their drivers' combined performance.",
    icon: "mdi:account-group",
    count: "11",
    countLabel: "Teams Racing",
    battleLabel: "Team Battle",
    accentBarClass: "bg-amber-500",
    accentTextClass: "text-amber-600 dark:text-amber-400",
  },
];
---

<!doctype html>
<html lang="en" class="bg-zinc-100 dark:bg-zinc-900">
  <head>
    <BaseHead title={pageTitle} description={description} />
  </head>
  <body>
    <Header />
    <main>
      <!-- Hero Section -->
      <section class="pb-16 text-center">
        <h1
          class="mb-4 text-4xl font-bold text-zinc-900 sm:text-5xl dark:text-zinc-100"
        >
          {pageTitle}
        </h1>
        <div class="mx-auto max-w-3xl">
          <p class="mb-8 leading-loose text-zinc-800 dark:text-zinc-300">
            Formula 1 is the pinnacle of motorsport, where speed, innovation,
            and strategy collide to create the ultimate racing spectacle.
          </p>
        </div>
        <div
          class="mx-auto mb-4 max-w-4xl overflow-hidden rounded-lg shadow-xl dark:shadow-zinc-800"
        >
          <Image
            src={cn02}
            alt="A bird sitting on a nest of eggs."
            loading="eager"
            class="w-full rounded-lg object-cover"
          />
        </div>
      </section>

      <!-- F1 Essentials Guide -->
      <section class="bg-zinc-100 py-16 dark:bg-zinc-900">
        <div class="container mx-auto px-4">
          <div class="mb-12 text-center">
            <h2 class="mb-4 text-3xl font-bold dark:text-zinc-100">
              Your guide to Formula 1 essentials
            </h2>
            <p class="text-zinc-800 dark:text-zinc-300">
              Everything you need to know about the pinnacle of motorsport
            </p>
          </div>

          <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
            {
              f1EssentialsItems.map((item) => (
                <a
                  href={item.href}
                  class="group relative flex h-full flex-col rounded-lg border-l-4 border-l-transparent bg-white p-6 shadow-sm transition-all duration-300 hover:border-l-rose-500 hover:shadow-md dark:bg-zinc-800 dark:hover:shadow-zinc-700/50"
                >
                  <div class="flex items-start justify-between">
                    <h3 class="mb-2 text-lg font-semibold text-zinc-900 group-hover:text-rose-600 dark:text-zinc-100 dark:group-hover:text-rose-400">
                      {item.title}
                    </h3>
                    <Icon
                      name="mdi:chevron-right"
                      class="mt-1 size-6 shrink-0 text-zinc-400 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-rose-500 dark:text-zinc-400"
                    />
                  </div>
                  <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
                    {item.description}
                  </p>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Understanding F1 Section -->
      <section id="understanding" class="bg-zinc-100 dark:bg-zinc-900">
        <GridSection
          title="Understanding the pinnacle of motorsports"
          items={f1BasicsItems}
        />
      </section>

      <!-- Championships Section -->
      <section id="championships" class="bg-zinc-100 py-16 dark:bg-zinc-900">
        <div class="mx-auto max-w-7xl px-4">
          <h2 class="mb-4 text-center text-3xl font-bold dark:text-zinc-100">
            World Championships at stake
          </h2>
          <p
            class="mx-auto mb-12 max-w-4xl leading-loose text-center text-zinc-800 dark:text-zinc-300"
          >
            Formula 1 is not just about individual races; it's a season-long
            competition to crown the best. It is as much about teamwork as
            individual skill, with every point contributing to the season's
            narrative.
          </p>
          <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 md:grid-cols-2">
            {
              championshipCards.map((card, index) => (
                <article
                  class="group relative overflow-hidden rounded-2xl border border-zinc-300 bg-white p-8 shadow-sm transition-colors duration-300 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:hover:bg-zinc-800/80"
                >
                  <span class={`absolute inset-x-0 top-0 h-1 ${card.accentBarClass}`} aria-hidden="true"></span>
                  <span class="pointer-events-none absolute right-5 top-4 text-6xl font-bold leading-none tracking-[-0.06em] text-zinc-200 transition-colors duration-300 group-hover:text-zinc-300 dark:text-zinc-700 dark:group-hover:text-zinc-600" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div class="relative flex h-full flex-col">
                    <div class="mb-6 flex items-center justify-between gap-4">
                      <div class="inline-flex items-center gap-3 rounded-full border border-zinc-300 bg-zinc-100 px-3 py-2 dark:border-zinc-700 dark:bg-zinc-800">
                        <Icon
                          name={card.icon}
                          aria-hidden="true"
                          class="size-5 shrink-0 text-zinc-800 dark:text-zinc-200"
                        />
                        <span class="text-xs font-semibold uppercase tracking-[0.22em] text-zinc-500 dark:text-zinc-400">{card.label}</span>
                      </div>
                    </div>
                    <h3 class="text-3xl font-bold leading-tight text-zinc-900 dark:text-zinc-100">
                      {card.title}
                    </h3>
                    <p class="mt-4 text-zinc-700 dark:text-zinc-300">{card.description}</p>
                    <div class="mt-8 rounded-xl border border-zinc-200 bg-zinc-100 p-5 dark:border-zinc-700 dark:bg-zinc-950">
                      <div class="flex items-end justify-between gap-4">
                        <div>
                          <p class="text-5xl font-bold leading-none text-zinc-900 dark:text-zinc-100">{card.count}</p>
                          <p class="mt-2 text-xs font-semibold uppercase tracking-[0.22em] text-zinc-500 dark:text-zinc-400">{card.countLabel}</p>
                        </div>
                        <p class={`text-sm font-semibold uppercase tracking-[0.2em] ${card.accentTextClass}`}>{card.battleLabel}</p>
                      </div>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Technology Section -->
      <div id="technology">
        <TwoColumnSection
          eyebrow="Engineering"
          title="The Technology"
          content={`
					<p>
						Formula 1 is a testing ground for automotive and engineering innovations that often influence road‑car design and performance—pushing boundaries in efficiency and speed—while recent years have driven a push toward sustainability through hybrid power units and a commitment to 100% sustainable fuels by 2030 to secure the sport’s future and address global environmental challenges.
					</p>
					`}
          imageSrc={cn02}
          imageAlt="F1 Technology"
          tone="neutral"
        />
      </div>

      <!-- Spectacle Section -->
      <div id="spectacle">
        <TwoColumnSection
          eyebrow="Race Weekend"
          title="The Spectacle"
          content={`
						<p>
							A typical F1 race weekend builds from practice sessions—where teams fine‑tune setup and collect data—into a high‑intensity qualifying session (often split into Q1–Q3) that determines the starting grid, and culminates in the Grand Prix itself, where strategy, tire management, pit‑stop timing and split‑second driver decisions combine to decide the result; support races, fan activities and evolving track conditions add context and momentum, creating a continuous rise in tension and excitement across the weekend.
						</p>
					`}
          imageSrc={cn02}
          imageAlt="F1 Race Weekend"
          reversed={true}
          tone="neutral"
        />
      </div>

      <!-- Why It Matters Section -->
      <div id="why-it-matters">
        <TwoColumnSection
          eyebrow="Culture"
          title="Why It Matters"
          content={`
						<p>
							Formula 1 isn't just about racing; it's about pushing boundaries, showcasing human ingenuity, and celebrating the relentless pursuit of excellence, capturing the imagination of fans with its blend of speed, strategy, and high-octane drama—offering something for everyone, whether you're a lifelong fan or new to the sport, and serving as more than a race: a passion, a tradition, and a glimpse into the future of technology and sport.
						</p>
					`}
          imageSrc={cn02}
          imageAlt="F1 Impact"
          tone="neutral"
        />
      </div>

      <!-- The Future Section -->
      <div id="future">
        <TwoColumnSection
          eyebrow="Outlook"
          title="The Future"
          content={`
						<p>
							Formula 1 continues to evolve—driven by advances in hybrid powertrains and sustainable fuels, strengthened safety and technical regulations, and new forms of fan engagement and media innovation—ensuring the sport pushes engineering boundaries, nurtures emerging talent, and broadens its global appeal, positioning it to remain the pinnacle of motorsport for generations to come.
						</p>
						`}
          imageSrc={cn02}
          imageAlt="F1 Race Weekend"
          reversed={true}
          tone="neutral"
        />
      </div>

      <!-- Latest Blog Posts Section -->
      <LatestPosts />
    </main>

    <Footer />
  </body>
</html>
