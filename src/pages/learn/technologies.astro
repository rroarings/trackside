---
import { Icon } from "astro-icon/components";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import TwoColumnSection from "../../components/TwoColumnSection.astro";
import jp02 from "../../assets/circuits/03japan/jp02.jpg";
import raceseqWebm from "../../assets/videos/raceseq.webm";
import raceseqMp4 from "../../assets/videos/raceseq.mp4";

const pageTitle = "Technology of Formula 1";
const description =
  "Formula 1 is at the cutting edge of automotive technology, pushing boundaries in engineering, data analytics, and innovation.";

const technologyItems = [
  {
    title: "Engineering",
    description:
      "Pushing the boundaries of automotive engineering with cutting-edge solutions.",
    icon: "mdi:gear",
    accentClass: "from-yellow-500 to-yellow-300",
    toneClass: "text-yellow-500",
  },
  {
    title: "Sustainability",
    description: "Leading the charge in sustainable racing technologies.",
    icon: "mdi:leaf",
    accentClass: "from-emerald-500 to-emerald-300",
    toneClass: "text-emerald-500",
  },
  {
    title: "Data Analytics",
    description:
      "Real-time data analysis shapes strategy and performance optimization.",
    icon: "mdi:chart-line",
    accentClass: "from-rose-500 to-rose-300",
    toneClass: "text-rose-500",
  },
  {
    title: "Aerodynamics",
    description: "Advanced research in airflow and downforce optimization.",
    icon: "mdi:windy",
    accentClass: "from-cyan-500 to-cyan-300",
    toneClass: "text-cyan-500",
  },
  {
    title: "Performance",
    description: "Maximizing speed and efficiency through innovative solutions.",
    icon: "mdi:car-speed-limiter",
    accentClass: "from-olive-500 to-olive-300",
    toneClass: "text-olive-500",
  },
];

const topRowTechnologyItems = technologyItems.slice(0, 3);
const longRowTechnologyItems = technologyItems.slice(3, 5);


const dataDrivenItems = [
  {
    title: "Real-Time Telemetry",
    description:
      "Live data streams guide every race-day decision, from pit stops to tire choices.",
    icon: "mdi:signal-variant",
    gridClass: "md:col-span-5",
    toneClass: "text-emerald-500",
    chip: "Live Feed",
  },
  {
    title: "Predictive Analytics",
    description:
      "Advanced models forecast tire wear, fuel strategy, and race outcomes for a competitive edge.",
    icon: "mdi:chart-areaspline",
    gridClass: "md:col-span-7",
    toneClass: "text-sky-500",
    chip: "Model Layer",
  },
  {
    title: "Data-Backed Strategy",
    description:
      "Every move is optimized—data turns milliseconds into podiums.",
    icon: "mdi:strategy",
    gridClass: "md:col-span-12",
    toneClass: "text-rose-500",
    chip: "Race Control",
  },
];

const teamworkItems = [
  {
    title: "One Team, One Goal",
    description:
      "From factory to finish line, everyone works toward a single mission: performance. Designers, mechanics, and support staff all play a part. In F1, collaboration and unity turn potential into podiums.",
    icon: "mdi:account-group",
  },
  {
    title: "Behind the Speed",
    description:
      "Race engineers and strategists are the unsung heroes. They analyze live data, adapt to changing conditions, and guide the driver through every lap. Success relies on trust, quick thinking, and seamless communication.",
    icon: "mdi:account-wrench",
  },
  {
    title: "Pit Wall Precision",
    description:
      "Teamwork in F1 is a finely tuned operation. Pit crews execute lightning-fast stops, with each member playing a vital role. One mistake can cost seconds — and the race.",
    icon: "mdi:account-hard-hat",
  },
];

const costCapMetrics = [
  {
    label: "Budget Ceiling",
    value: "$215M base",
    trend: "+ inflation and event adjustments",
    icon: "mdi:piggy-bank",
    accentClass: "from-emerald-500/80 to-emerald-400/30",
    iconClass: "text-emerald-400",
  },
  {
    label: "Race Calendar",
    value: "24 rounds",
    trend: "High-logistics full season",
    icon: "mdi:calendar-multiselect",
    accentClass: "from-sky-500/80 to-sky-400/30",
    iconClass: "text-sky-400",
  },
  {
    label: "Teams Monitored",
    value: "11 teams",
    trend: "New entrant impact in 2026",
    icon: "mdi:account-supervisor",
    accentClass: "from-rose-500/80 to-rose-400/30",
    iconClass: "text-rose-400",
  },
  {
    label: "Compliance Focus",
    value: "Audit-led",
    trend: "Breach risk carries sporting cost",
    icon: "mdi:shield-check",
    accentClass: "from-amber-500/80 to-amber-400/30",
    iconClass: "text-amber-400",
  },
];

const videoFeatureHighlights = [
  {
    label: "Telemetry Stream",
    value: "Live",
    icon: "mdi:signal-variant",
    toneClass: "text-emerald-500",
  },
  {
    label: "Decision Window",
    value: "Seconds",
    icon: "mdi:timer-outline",
    toneClass: "text-sky-500",
  },
  {
    label: "Data Inputs",
    value: "Millions",
    icon: "mdi:chart-timeline-variant",
    toneClass: "text-rose-500",
  },
];
---

<!doctype html>
<html lang="en" class="bg-zinc-100 dark:bg-zinc-900">
  <head>
    <BaseHead title={pageTitle} description={description} />
  </head>
  <body>
    <Header />
    <main>
      <!-- Hero Section -->
      <section class="pb-16">
        <div class="container mx-auto">
          <div class="mb-10 text-center">
            <h1 class="mb-4 text-4xl font-bold md:text-5xl dark:text-zinc-100">
              {pageTitle}
            </h1>
            <p class="text-zinc-800 dark:text-zinc-300">
              Technological prowess drives Formula 1 innovation
            </p>
          </div>

          <!-- Technology Grid Layout -->
          <div class="hero-tech-shell mx-auto max-w-6xl rounded-2xl border border-zinc-300/70 bg-white/80 p-4 shadow-lg backdrop-blur-sm dark:border-zinc-700/80 dark:bg-zinc-900/70">
            <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
              {
                topRowTechnologyItems.map((item) => (
                  <article class="hero-tech-card group relative flex flex-col overflow-hidden rounded-xl border border-zinc-300/70 bg-zinc-50/90 transition-all duration-300 hover:border-zinc-400/80 hover:shadow-md dark:border-zinc-700/70 dark:bg-zinc-800/75 dark:hover:border-zinc-500/80">
                    <div class={`absolute inset-x-0 top-0 h-1.5 bg-linear-to-r ${item.accentClass}`}></div>
                    <div class="flex flex-1 flex-col p-6">
                      <div class="mb-4 flex items-center gap-4">
                        <div class="hero-tech-icon-shell rounded-md border border-zinc-300/80 bg-zinc-100 p-3 transition-colors duration-300 group-hover:bg-zinc-200 dark:border-zinc-700 dark:bg-zinc-900 dark:group-hover:bg-zinc-800">
                          <Icon
                            name={item.icon}
                            class={`h-6 w-6 transition-colors duration-300 ${item.toneClass}`}
                          />
                        </div>
                        <h3 class="text-lg font-bold uppercase tracking-wide text-zinc-900 dark:text-zinc-100">
                          {item.title}
                        </h3>
                      </div>
                      <p class="text-base leading-relaxed text-zinc-600 dark:text-zinc-300">
                        {item.description}
                      </p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="mt-6 flex flex-col gap-6">
              {
                longRowTechnologyItems.map((item) => (
                  <article class="hero-tech-card hero-tech-card-long group relative flex flex-col overflow-hidden rounded-xl border border-zinc-300/70 bg-zinc-50/90 transition-all duration-300 hover:border-zinc-400/80 hover:shadow-md dark:border-zinc-700/70 dark:bg-zinc-800/75 dark:hover:border-zinc-500/80">
                    <div class={`absolute inset-x-0 top-0 h-1.5 bg-linear-to-r ${item.accentClass}`}></div>
                    <div class="flex flex-1 flex-col p-6 md:p-8">
                      <div class="mb-4 flex items-center gap-4">
                        <div class="hero-tech-icon-shell rounded-md border border-zinc-300/80 bg-zinc-100 p-3 transition-colors duration-300 group-hover:bg-zinc-200 dark:border-zinc-700 dark:bg-zinc-900 dark:group-hover:bg-zinc-800">
                          <Icon
                            name={item.icon}
                            class={`h-6 w-6 transition-colors duration-300 ${item.toneClass}`}
                          />
                        </div>
                        <h3 class="text-xl font-bold uppercase tracking-wide text-zinc-900 dark:text-zinc-100">
                          {item.title}
                        </h3>
                      </div>
                      <p class="max-w-4xl text-base leading-relaxed text-zinc-600 dark:text-zinc-300">
                        {item.description}
                      </p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- Simulations Section -->
      <TwoColumnSection
        title="Augmented reality and virtual simulations"
        content={`
        <p>
          Augmented reality and virtual simulations are becoming increasingly important in Formula One, enabling teams to improve design and testing by simulating scenarios and testing components—such as aerodynamic changes—virtually without physical prototypes, while also enhancing the fan experience through apps that let users explore cars and tracks in 3D; these technologies have the potential to transform how Formula One is developed and experienced and are likely to become even more important in the years to come.
        </p>
        `}
        imageSrc={jp02}
        imageAlt="F1 Car Virtual Simulation"
      />

      <!-- Technicalities Section -->
      <TwoColumnSection
        title="Technicalities to talk about"
        content={`
          <p>
            In recent years, Formula 1 has introduced technical changes—such as raising the minimum car weight and tightening rules around wind tunnel and simulator use—to improve safety and competitiveness while encouraging innovation and creativity, helping to ensure F1 remains at the forefront of automotive technology and reinforcing its reputation as one of the most exciting and dynamic motorsports in the world.
          </p>
          `}
        imageSrc={jp02}
        imageAlt="F1 Car Technical Details"
        reversed={true}
      />

      <!-- Video Feature Section -->
      <section class="relative overflow-hidden bg-zinc-100 py-14 dark:bg-zinc-900">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <div class="absolute -left-24 top-6 h-52 w-52 rounded-full bg-sky-500/15 blur-3xl"></div>
          <div class="absolute -right-20 bottom-0 h-56 w-56 rounded-full bg-rose-500/15 blur-3xl"></div>
        </div>
        <div class="container mx-auto px-4">
          <div class="relative mx-auto max-w-6xl rounded-2xl border border-zinc-300/70 bg-white/65 p-4 shadow-lg backdrop-blur-sm dark:border-zinc-700/70 dark:bg-zinc-900/65">
            <div class="mb-8 text-center">
              <p class="text-xs font-semibold uppercase tracking-widest text-zinc-600 dark:text-zinc-300">
                Gameplay Capture
              </p>
              <h2 class="mt-2 text-3xl font-bold text-zinc-900 dark:text-zinc-100 md:text-4xl">
                Experience F1 Technology
              </h2>
              <p class="mx-auto mt-3 max-w-3xl text-zinc-700 dark:text-zinc-300">
                Creator-recorded Formula 1 25 gameplay showing race starts,
                corner sequences, and in-car driver POV with steering wheel
                input.
              </p>
            </div>

            <div class="grid gap-4 lg:grid-cols-12">
              <div class="lg:col-span-8">
                <div class="group relative overflow-hidden rounded-xl border border-zinc-300/70 shadow-xl dark:border-zinc-700/80 dark:shadow-zinc-950/50">
                  <video
                    class="aspect-video h-full w-full rounded-xl object-cover"
                    autoplay
                    muted
                    loop
                    playsinline
                  >
                    <source src={raceseqWebm} type="video/webm" />
                    <source src={raceseqMp4} type="video/mp4" />
                    Your browser does not support the video tag.
                  </video>
                  <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-zinc-950/65 via-transparent to-zinc-950/25"></div>
                  <div class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-md border border-zinc-200/40 bg-zinc-950/60 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-zinc-100">
                    <span class="h-2 w-2 rounded-full bg-rose-500 animate-pulse"></span>
                    Gameplay footage
                  </div>
                  <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-3">
                    <p class="max-w-md text-sm font-medium text-zinc-100">
                      Gameplay clips show how milliseconds are won through line
                      choice, braking control, and driver feedback.
                    </p>
                    <div class="hidden rounded-md border border-zinc-200/40 bg-zinc-950/55 px-3 py-2 text-right text-xs text-zinc-200 md:block">
                      <p class="font-semibold uppercase tracking-wide">Clip</p>
                      <p>Formula 1 25 capture</p>
                    </div>
                  </div>
                </div>
              </div>

              <aside class="lg:col-span-4">
                <div class="h-full rounded-xl border border-zinc-300/70 bg-zinc-50/80 p-4 dark:border-zinc-700/70 dark:bg-zinc-800/70">
                  <h3 class="text-base font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100">
                    Key Signals
                  </h3>
                  <div class="mt-4 space-y-3">
                    {
                      videoFeatureHighlights.map((item, index) => (
                        <div
                          class="animate-video-pill flex items-center justify-between rounded-lg border border-zinc-300/70 bg-white/85 px-3 py-2 dark:border-zinc-700/70 dark:bg-zinc-900/70"
                          style={`animation-delay:${index * 90}ms`}
                        >
                          <div class="flex items-center gap-2">
                            <Icon name={item.icon} class={`h-4 w-4 ${item.toneClass}`} />
                            <span class="text-sm text-zinc-700 dark:text-zinc-300">{item.label}</span>
                          </div>
                          <span class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">{item.value}</span>
                        </div>
                      ))
                    }
                  </div>

                  <div class="mt-5 rounded-lg border border-zinc-300/70 bg-white/85 p-3 dark:border-zinc-700/70 dark:bg-zinc-900/70">
                    <p class="text-xs font-semibold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">
                      Why it matters
                    </p>
                    <p class="mt-2 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
                      Even in sim racing, setup changes, braking precision,
                      throttle control, and race-line choices stack up lap
                      after lap.
                    </p>
                  </div>
                </div>
              </aside>
            </div>

            <p class="mt-4 text-center text-xs tracking-wide text-zinc-600 dark:text-zinc-400">
              Unofficial gameplay footage captured by Trackside. Not affiliated
              with or endorsed by Formula 1, FIA, or Codemasters/EA.
            </p>
          </div>
        </div>
      </section>

      <!-- Cost Cap Section -->
      <section class="relative overflow-hidden bg-zinc-100 py-16 dark:bg-zinc-900">
        <div
          class="pointer-events-none absolute inset-0 opacity-35 dark:opacity-45"
          aria-hidden="true"
        >
         
        </div>
        <div class="container mx-auto px-4">
          <div class="mx-auto max-w-6xl">
            <div class="mb-12 text-center space-y-6">
              <h2
                class="mb-4 text-3xl font-bold md:text-4xl dark:text-zinc-100"
              >
                Cost Cap Impact
              </h2>
              <p
                class="mx-auto text-lg text-zinc-800 dark:text-zinc-300"
              >
                Eleven teams. Zero room for waste. The cost cap turns
                financial discipline into on-track performance.
              </p>
              <p class="mt-3 text-sm font-medium uppercase tracking-[0.16em] text-zinc-700 dark:text-zinc-300">
                Updated for 2026 financial regulations
              </p>
            </div>

            <!-- Telemetry Strip - Key Metrics -->
            <div
              class="relative mb-12 overflow-hidden rounded-2xl border border-zinc-300/70 bg-white/80 p-3 shadow-lg backdrop-blur-sm dark:border-zinc-700/80 dark:bg-zinc-900/75"
            >
              <div class="absolute inset-0 bg-[linear-gradient(120deg,transparent,rgba(255,255,255,0.2),transparent)] motion-safe:animate-[telemetryScan_1.8s_ease-out] dark:bg-[linear-gradient(120deg,transparent,rgba(255,255,255,0.08),transparent)]"></div>
              <div class="relative grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
                {
                  costCapMetrics.map((metric, index) => (
                    <article
                      class="animate-telemetry-card relative overflow-hidden rounded-xl border border-zinc-300/70 bg-zinc-50/85 p-4 dark:border-zinc-700/70 dark:bg-zinc-800/70"
                      style={`animation-delay:${index * 90}ms`}
                    >
                      <div class={`mb-3 h-1.5 w-full rounded-full bg-linear-to-r ${metric.accentClass}`}></div>
                      <div class="flex items-start gap-3">
                        <div class="mt-0.5 rounded-md border border-zinc-300/60 bg-zinc-100 p-2 dark:border-zinc-700 dark:bg-zinc-900">
                          <Icon name={metric.icon} class={`h-5 w-5 ${metric.iconClass}`} />
                        </div>
                        <div class="min-w-0">
                          <p class="text-xs font-semibold uppercase tracking-widest text-zinc-700 dark:text-zinc-300">
                            {metric.label}
                          </p>
                          <p class="mt-1 text-2xl font-black text-zinc-900 dark:text-zinc-100">
                            {metric.value}
                          </p>
                          <p class="mt-2 inline-flex rounded-md border border-zinc-300/80 bg-zinc-100 px-2 py-1 text-xs font-medium text-zinc-700 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300">
                            {metric.trend}
                          </p>
                        </div>
                      </div>
                    </article>
                  ))
                }
              </div>
            </div>

            <!-- Content Grid -->
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
              <div class="rounded-2xl border border-zinc-300/70 bg-white/85 p-6 shadow-sm dark:border-zinc-700/70 dark:bg-zinc-800/70">
                <h3 class="text-xl font-semibold text-zinc-900 dark:text-zinc-200">
                  Why the cap changes the race
                </h3>
                <p class="mt-4 leading-relaxed text-zinc-800 dark:text-zinc-300">
                  Big spend no longer guarantees the front row.
                </p>
                <p class="mt-2 leading-relaxed text-zinc-800 dark:text-zinc-300">
                  Teams win by spending smarter, developing cleaner, and reacting faster.
                </p>
                <p class="mt-2 leading-relaxed text-zinc-800 dark:text-zinc-300">
                  The result is tighter gaps, more strategic variety, and stronger midfield fights.
                </p>
                <ul class="mt-4 space-y-2 text-zinc-800 dark:text-zinc-300">
                  <li class="flex items-center gap-2">
                    <Icon name="mdi:check-bold" size={20} class={"h-5 w-5 text-emerald-500"} />
                    Innovation efficiency matters more than raw cash
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="mdi:check-bold" size={20} class={"h-5 w-5 text-emerald-500"} />
                    Resource discipline shapes weekend performance
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="mdi:check-bold" size={20} class={"h-5 w-5 text-emerald-500"} />
                    Closer performance windows increase unpredictability
                  </li>
                </ul>
              </div>
              <div class="space-y-5">
                <div class="rounded-2xl border border-zinc-300/70 bg-white/85 p-6 shadow-sm dark:border-zinc-700/70 dark:bg-zinc-800/70">
                  <h3 class="text-xl font-semibold text-zinc-900 dark:text-zinc-200">
                    What counts toward the cap
                  </h3>
                  <ul class="mt-4 space-y-2 text-zinc-800 dark:text-zinc-300">
                    <li class="flex items-center gap-2">
                      <Icon name="mdi:chevron-right" class="h-5 w-5 text-sky-500" />
                      Car development and performance upgrades
                    </li>
                    <li class="flex items-center gap-2">
                      <Icon name="mdi:chevron-right" class="h-5 w-5 text-sky-500" />
                      Most operations, manufacturing, and engineering costs
                    </li>
                    <li class="flex items-center gap-2">
                      <Icon name="mdi:chevron-right" class="h-5 w-5 text-sky-500" />
                      Simulation and testing program spend
                    </li>
                  </ul>
                </div>
                <div class="rounded-2xl border border-zinc-300/70 bg-white/85 p-6 shadow-sm dark:border-zinc-700/70 dark:bg-zinc-800/70">
                  <h3 class="text-xl font-semibold text-zinc-900 dark:text-zinc-200">
                    Excluded categories
                  </h3>
                  <ul class="mt-4 space-y-2 text-zinc-800 dark:text-zinc-300">
                    <li class="flex items-center gap-2">
                      <Icon name="mdi:chevron-right" class="h-5 w-5 text-rose-500" />
                      Driver salaries and select senior personnel pay
                    </li>
                    <li class="flex items-center gap-2">
                      <Icon name="mdi:chevron-right" class="h-5 w-5 text-rose-500" />
                      Marketing, heritage, and some non-performance costs
                    </li>
                    <li class="flex items-center gap-2">
                      <Icon name="mdi:chevron-right" class="h-5 w-5 text-rose-500" />
                      Specific regulatory exemptions defined by FIA
                    </li>
                  </ul>
                </div>
              </div>
            </div>

            <p class="mt-8 text-center text-xs tracking-wide text-zinc-700 dark:text-zinc-400">
              Figures shown reflect 2026-era framework messaging: base cap plus regulation-defined adjustments.
            </p>
          </div>
        </div>
      </section>

      <!-- Data-Driven Section -->
      <section class="relative overflow-hidden py-16 dark:bg-zinc-900">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          
        </div>
        <div class="container relative mx-auto px-4">
          <div class="mx-auto max-w-6xl rounded-2xl border border-zinc-300/70 bg-white/85 p-4 shadow-lg backdrop-blur-sm dark:border-zinc-700/80 dark:bg-zinc-900/75">
            <div class="mb-8 text-center">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-zinc-600 dark:text-zinc-400">
                Strategy Interface
              </p>
              <h2 class="mt-2 text-3xl font-black uppercase tracking-tight text-zinc-900 dark:text-zinc-100 md:text-4xl">
                Data-Driven Edge
              </h2>
              <p class="mx-auto mt-3 max-w-3xl text-zinc-700 dark:text-zinc-300">
                Analytics, prediction layers, and telemetry signals shape every millisecond of Formula 1 performance.
              </p>
            </div>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
              {
                dataDrivenItems.map((item, index) => (
                  <article
                    class={`animate-telemetry-card group relative overflow-hidden rounded-xl border border-zinc-300/70 bg-zinc-50/85 p-5 transition-all duration-300 hover:border-zinc-400/80 hover:shadow-md dark:border-zinc-700/70 dark:bg-zinc-800/70 dark:hover:border-zinc-500/80 ${item.gridClass}`}
                    style={`animation-delay:${index * 110}ms`}
                  >
                    <div class="absolute inset-x-0 top-0 h-1 bg-linear-to-r from-transparent via-zinc-400/70 to-transparent dark:via-zinc-500/70"></div>
                    <div class="mb-3 flex items-center justify-between gap-3">
                      <div class="inline-flex items-center gap-2 rounded-md border border-zinc-300/80 bg-white/90 px-2 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-700 dark:border-zinc-700 dark:bg-zinc-900/80 dark:text-zinc-300">
                        <span class={`h-2 w-2 rounded-full ${item.toneClass.replace("text", "bg")}`}></span>
                        {item.chip}
                      </div>
                      <div class="rounded-md border border-zinc-300/80 bg-zinc-100 p-2 dark:border-zinc-700 dark:bg-zinc-900">
                        <Icon
                          name={item.icon}
                          class={`h-5 w-5 ${item.toneClass}`}
                        />
                      </div>
                    </div>
                    <h3 class="text-lg font-bold uppercase tracking-wide text-zinc-900 dark:text-zinc-100">
                      {item.title}
                    </h3>
                    <p class="mt-3 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300 md:text-base">
                      {item.description}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- Teamwork Section -->
      <section class="bg-zinc-100 py-12 dark:bg-zinc-900">
        <div class="container mx-auto px-4">
          <h2 class="mb-12 text-center text-3xl font-bold dark:text-zinc-100">
            Teamwork makes the dream work
          </h2>

          <div
            class="mx-auto mt-8 grid max-w-7xl grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3"
          >
            {
              teamworkItems.map((item) => (
                <div class="group space-y-4">
                  <div class="inline-flex h-16 w-16 items-center justify-center rounded-lg bg-zinc-200 transition-colors duration-300 group-hover:bg-rose-100 dark:bg-zinc-800 dark:group-hover:bg-rose-900/30">
                    <Icon
                      name={item.icon}
                      class="h-8 w-8 text-zinc-700 transition-colors duration-300 group-hover:text-rose-600 dark:text-zinc-300 dark:group-hover:text-rose-400"
                    />
                  </div>
                  <h3 class="dark:text-zinc-200">{item.title}</h3>
                  <p class="leading-loose text-zinc-800 dark:text-zinc-300">
                    {item.description}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .minimal-checker-ribbon {
        background-image:
          linear-gradient(45deg, rgb(24 24 27 / 0.07) 25%, transparent 25%),
          linear-gradient(-45deg, rgb(24 24 27 / 0.07) 25%, transparent 25%),
          linear-gradient(45deg, transparent 75%, rgb(24 24 27 / 0.07) 75%),
          linear-gradient(-45deg, transparent 75%, rgb(24 24 27 / 0.07) 75%);
        background-size: 12px 12px;
        background-position: 0 0, 0 6px, 6px -6px, -6px 0;
        border: 1px solid rgb(24 24 27 / 0.12);
      }

      .hero-tech-shell {
        position: relative;
      }

      .hero-tech-shell::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        border-radius: 1rem;
        background-image: repeating-linear-gradient(
          135deg,
          rgb(24 24 27 / 0.03) 0,
          rgb(24 24 27 / 0.03) 2px,
          transparent 2px,
          transparent 10px
        );
      }

      .hero-tech-card {
        position: relative;
      }

      .hero-tech-card::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(120deg, transparent 0%, rgb(255 255 255 / 0.26) 45%, transparent 70%);
        transform: translateX(-135%);
        transition: transform 380ms ease;
      }

      .hero-tech-card:hover::after {
        transform: translateX(120%);
      }

      .hero-tech-card-long {
        clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 0 100%);
      }

      .hero-tech-icon-shell {
        clip-path: polygon(10% 0, 100% 0, 100% 90%, 90% 100%, 0 100%, 0 10%);
      }

      :global(.dark) .hero-tech-shell::before {
        background-image: repeating-linear-gradient(
          135deg,
          rgb(244 244 245 / 0.04) 0,
          rgb(244 244 245 / 0.04) 2px,
          transparent 2px,
          transparent 10px
        );
      }

      :global(.dark) .minimal-checker-ribbon {
        background-image:
          linear-gradient(45deg, rgb(244 244 245 / 0.13) 25%, transparent 25%),
          linear-gradient(-45deg, rgb(244 244 245 / 0.13) 25%, transparent 25%),
          linear-gradient(45deg, transparent 75%, rgb(244 244 245 / 0.13) 75%),
          linear-gradient(-45deg, transparent 75%, rgb(244 244 245 / 0.13) 75%);
        border-color: rgb(244 244 245 / 0.2);
      }

      

      .animate-telemetry-card {
        opacity: 0;
        transform: translateY(10px) scale(0.99);
        animation: telemetryReveal 450ms ease forwards;
      }

      .animate-video-pill {
        opacity: 0;
        transform: translateY(8px);
        animation: telemetryReveal 420ms ease forwards;
      }

      @keyframes telemetryReveal {
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      @keyframes telemetryScan {
        0% {
          transform: translateX(-100%);
        }
        100% {
          transform: translateX(110%);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .animate-telemetry-card {
          opacity: 1;
          transform: none;
          animation: none;
        }

        .animate-video-pill {
          opacity: 1;
          transform: none;
          animation: none;
        }

        .hero-tech-card::after {
          display: none;
        }
      }
    </style>
  </body>
</html>
