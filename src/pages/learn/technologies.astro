---
import { Icon } from "astro-icon/components";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import TwoColumnSection from "../../components/TwoColumnSection.astro";
import jp02 from "../../assets/circuits/03japan/jp02.jpg";
import raceseqWebm from "../../assets/videos/raceseq.webm";
import raceseqMp4 from "../../assets/videos/raceseq.mp4";

const pageTitle = "Technology of Formula 1";
const description =
  "Formula 1 is at the cutting edge of automotive technology, pushing boundaries in engineering, data analytics, and innovation.";

const technologyItems = [
  {
    title: "Engineering",
    description:
      "Pushing the boundaries of automotive engineering with cutting-edge solutions",
    icon: "mdi:gear",
    gridClass: "",
  },
  {
    title: "Sustainability",
    description: "Leading the charge in sustainable racing technologies",
    icon: "mdi:leaf",
    gridClass: "md:row-span-2",
  },
  {
    title: "Data Analytics",
    description:
      "Real-time data analysis shapes strategy and performance optimization",
    icon: "mdi:chart-line",
    gridClass: "",
  },
  {
    title: "Aerodynamics",
    description: "Advanced research in airflow and downforce optimization",
    icon: "mdi:windy",
    gridClass: "",
  },
  {
    title: "Performance",
    description: "Maximizing speed and efficiency through innovative solutions",
    icon: "mdi:car-speed-limiter",
    gridClass: "",
  },
  {
    title: "Innovation",
    description:
      "Where engineering meets innovation to create the future of motorsport",
    icon: "mdi:brain",
    gridClass: "md:col-span-2 lg:col-span-3",
  },
];

const dataDrivenItems = [
  {
    title: "Real-Time Telemetry",
    description:
      "Live data streams guide every race-day decision, from pit stops to tire choices.",
    icon: "mdi:signal-variant",
  },
  {
    title: "Predictive Analytics",
    description:
      "Advanced models forecast tire wear, fuel strategy, and race outcomes for a competitive edge.",
    icon: "mdi:chart-areaspline",
  },
  {
    title: "Data-Backed Strategy",
    description:
      "Every move is optimized—data turns milliseconds into podiums.",
    icon: "mdi:strategy",
  },
];

const teamworkItems = [
  {
    title: "One Team, One Goal",
    description:
      "From factory to finish line, everyone works toward a single mission: performance. Designers, mechanics, and support staff all play a part. In F1, collaboration and unity turn potential into podiums.",
    icon: "mdi:account-group",
  },
  {
    title: "Behind the Speed",
    description:
      "Race engineers and strategists are the unsung heroes. They analyze live data, adapt to changing conditions, and guide the driver through every lap. Success relies on trust, quick thinking, and seamless communication.",
    icon: "mdi:account-wrench",
  },
  {
    title: "Pit Wall Precision",
    description:
      "Teamwork in F1 is a finely tuned operation. Pit crews execute lightning-fast stops, with each member playing a vital role. One mistake can cost seconds — and the race.",
    icon: "mdi:account-hard-hat",
  },
];
---

<!doctype html>
<html lang="en" class="bg-zinc-100 dark:bg-zinc-900">
  <head>
    <BaseHead title={pageTitle} description={description} />
  </head>
  <body>
    <Header />
    <main>
      <!-- Hero Section -->
      <section class="pb-16">
        <div class="container mx-auto">
          <div class="mb-10 text-center">
            <h1 class="mb-4 text-4xl font-bold md:text-5xl dark:text-zinc-100">
              {pageTitle}
            </h1>
            <p class="text-zinc-800 dark:text-zinc-300">
              Technological prowess drives Formula 1 innovation
            </p>
          </div>

          <!-- Technology Grid Layout -->
          <div
            class="mx-auto grid max-w-6xl grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"
          >
            {
              technologyItems.map((item) => (
                <div
                  class={`group relative flex flex-col overflow-hidden rounded-xl  bg-white shadow-sm transition-all duration-300  hover:shadow-md dark:bg-zinc-800 dark:hover:shadow-zinc-700/50 ${item.gridClass}`}
                >
                  <div class="flex flex-1 flex-col p-6">
                    <div class="mb-4 flex items-center gap-4">
                      <div class="rounded-full bg-zinc-100 p-3 transition-colors duration-300 group-hover:bg-sky-100 dark:bg-zinc-700 dark:group-hover:bg-sky-900/30">
                        <Icon
                          name={item.icon}
                          class="h-6 w-6 text-zinc-700 transition-colors duration-300 group-hover:text-sky-600 dark:text-zinc-300 dark:group-hover:text-sky-400"
                        />
                      </div>
                      <h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">
                        {item.title}
                      </h3>
                    </div>
                    <p class="text-base leading-relaxed text-zinc-600 dark:text-zinc-300">
                      {item.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Simulations Section -->
      <TwoColumnSection
        title="Augmented reality and virtual simulations"
        content={`
        <p>
          Augmented reality and virtual simulations are becoming increasingly important in Formula One, enabling teams to improve design and testing by simulating scenarios and testing components—such as aerodynamic changes—virtually without physical prototypes, while also enhancing the fan experience through apps that let users explore cars and tracks in 3D; these technologies have the potential to transform how Formula One is developed and experienced and are likely to become even more important in the years to come.
        </p>
        `}
        imageSrc={jp02}
        imageAlt="F1 Car Virtual Simulation"
      />

      <!-- Technicalities Section -->
      <TwoColumnSection
        title="Technicalities to talk about"
        content={`
          <p>
            In recent years, Formula 1 has introduced technical changes—such as raising the minimum car weight and tightening rules around wind tunnel and simulator use—to improve safety and competitiveness while encouraging innovation and creativity, helping to ensure F1 remains at the forefront of automotive technology and reinforcing its reputation as one of the most exciting and dynamic motorsports in the world.
          </p>
          `}
        imageSrc={jp02}
        imageAlt="F1 Car Technical Details"
        reversed={true}
      />

      <!-- Video Feature Section -->
      <section class="bg-zinc-100 py-12 dark:bg-zinc-900">
        <div class="container mx-auto px-4">
          <div class="mx-auto max-w-4xl">
            <h2 class="mb-12 text-center text-3xl font-bold dark:text-zinc-100">
              Experience F1 Technology
            </h2>
            <div
              class="overflow-hidden rounded-xl shadow-lg dark:shadow-zinc-700"
            >
              <video
                class="h-full w-full rounded-xl object-cover"
                autoplay
                muted
                loop
                playsinline
              >
                <source src={raceseqWebm} type="video/webm" />
                <source src={raceseqMp4} type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            </div>

            <div class="mt-8 text-center">
              <p class="mx-auto max-w-2xl text-zinc-800 dark:text-zinc-300">
                Explore the cutting-edge technology that powers modern Formula 1
                cars, from advanced aerodynamics to hybrid power units.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Cost Cap Section -->
      <section class="bg-zinc-100 py-16 dark:bg-zinc-900">
        <div class="container mx-auto px-4">
          <div class="mx-auto">
            <div class="mb-12 text-center">
              <h2
                class="mb-4 text-3xl font-bold md:text-4xl dark:text-zinc-100"
              >
                Cost Cap Impact
              </h2>
              <p
                class="mx-auto max-w-3xl text-lg text-zinc-800 dark:text-zinc-300"
              >
                Transforming F1's financial landscape with a $140M cost cap,
                creating a more competitive and sustainable future for the
                sport.
              </p>
            </div>

            <!-- Stats Bar - Key Metrics -->
            <div
              class="mb-12 grid grid-cols-2 gap-4 md:grid-cols-2 lg:grid-cols-4"
            >
              <div class="mx-auto rounded-xl p-6">
                <div class="flex items-center gap-4">
                  <div class="rounded-lg bg-green-100 p-3 dark:bg-green-300">
                    <Icon
                      name="mdi:piggy-bank"
                      class="inline-block text-2xl text-green-600 dark:text-green-900"
                    />
                  </div>
                  <div>
                    <p class="text-sm text-zinc-800 dark:text-zinc-300">
                      Annual Budget
                    </p>
                    <p class="text-2xl font-bold dark:text-zinc-200">$140M</p>
                  </div>
                </div>
              </div>
              <div class="mx-auto rounded-xl p-6">
                <div class="flex items-center gap-4">
                  <div class="rounded-lg bg-blue-100 p-3 dark:bg-blue-300">
                    <Icon
                      name="mdi:calendar-multiselect"
                      class="inline-block text-2xl text-blue-600 dark:text-blue-900"
                    />
                  </div>
                  <div>
                    <p class="text-sm text-zinc-800 dark:text-zinc-300">
                      Race Calendar
                    </p>
                    <p class="text-2xl font-bold dark:text-zinc-200">
                      24 races
                    </p>
                  </div>
                </div>
              </div>
              <div class="mx-auto rounded-xl p-6">
                <div class="flex items-center gap-4">
                  <div class="rounded-lg bg-rose-100 p-3 dark:bg-rose-300">
                    <Icon
                      name="mdi:account-supervisor"
                      class="inline-block text-2xl text-rose-600 dark:text-rose-900"
                    />
                  </div>
                  <div>
                    <p class="text-sm text-zinc-800 dark:text-zinc-300">
                      Teams
                    </p>
                    <p class="text-2xl font-bold dark:text-zinc-200">11</p>
                  </div>
                </div>
              </div>
              <div class="mx-auto rounded-xl p-6">
                <div class="flex items-center gap-4">
                  <div class="rounded-lg bg-orange-100 p-3 dark:bg-orange-300">
                    <Icon
                      name="mdi:arrow-compress-all"
                      class="inline-block text-2xl text-orange-600 dark:text-orange-900"
                    />
                  </div>
                  <div>
                    <p class="text-sm text-zinc-800 dark:text-zinc-300">
                      Pressure
                    </p>
                    <p class="text-2xl font-bold dark:text-zinc-200">100%</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Content Grid -->
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
              <div class="space-y-4">
                <h3
                  class="text-xl font-semibold text-zinc-900 dark:text-zinc-200"
                >
                  Financial Equality
                </h3>
                <p class="leading-loose text-zinc-800 dark:text-zinc-300">
                  The introduction of a cost cap in Formula One marks a
                  significant shift towards financial sustainability. Teams are
                  now restricted to $140 million per year for car development,
                  leveling the playing field between established powerhouses and
                  smaller teams. This cap ensures that success is determined
                  more by innovation and efficiency than by financial might.
                </p>
                <ul class="space-y-2 text-zinc-800 dark:text-zinc-300">
                  <li class="flex items-center gap-2">
                    <Icon
                      name="mdi:check-bold"
                      size={24}
                      class={"h-6 w-6 text-green-600"}
                    />
                    Balanced competition across all teams
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon
                      name="mdi:check-bold"
                      size={24}
                      class={"h-6 w-6 text-green-600"}
                    />
                    Focus on technical innovation
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon
                      name="mdi:check-bold"
                      size={24}
                      class={"h-6 w-6 text-green-600"}
                    />
                    Sustainable business model
                  </li>
                </ul>
              </div>
              <div class="space-y-4">
                <h3
                  class="text-xl font-semibold text-zinc-900 dark:text-zinc-200"
                >
                  Impact on Competition
                </h3>
                <p class="leading-loose text-zinc-800 dark:text-zinc-300">
                  This new approach prevents financial dominance from
                  determining championship outcomes. Teams must now prioritize
                  efficiency and strategic resource allocation, leading to more
                  unpredictable and exciting races. The cost cap has already
                  shown signs of narrowing the performance gap between teams,
                  creating more opportunities for midfield teams to compete for
                  podiums.
                </p>
                <ul class="space-y-2 text-zinc-800 dark:text-zinc-300">
                  <li class="flex items-center gap-2">
                    <Icon
                      name="mdi:check-bold"
                      size={24}
                      class={"h-6 w-6 text-green-600"}
                    />
                    Closer racing battles
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon
                      name="mdi:check-bold"
                      size={24}
                      class={"h-6 w-6 text-green-600"}
                    />
                    Efficient resource management
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon
                      name="mdi:check-bold"
                      size={24}
                      class={"h-6 w-6 text-green-600"}
                    />
                    More competitive midfield
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Data-Driven Section -->
      <section class="py-16 dark:bg-zinc-900">
        <div class="container mx-auto px-4">
          <div class="mb-10 text-center">
            <h2 class="text-3xl font-bold text-zinc-900 dark:text-zinc-100">
              Data-Driven Edge
            </h2>
            <p class="mx-auto mt-2 text-zinc-800 dark:text-zinc-300">
              How analytics and telemetry shape every millisecond of F1
              performance
            </p>
          </div>
          <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 md:grid-cols-3">
            {
              dataDrivenItems.map((item) => (
                <div class="group relative flex flex-col items-center rounded-xl bg-white p-8 text-center shadow-sm transition-all duration-300 hover:shadow-md dark:bg-zinc-800 dark:hover:shadow-sky-600/50">
                  <div class="mb-4 rounded-full bg-zinc-100 p-4 transition-colors duration-300 group-hover:bg-sky-100 dark:bg-zinc-700 dark:group-hover:bg-sky-900/30">
                    <Icon
                      name={item.icon}
                      class="h-8 w-8 text-zinc-700 transition-colors duration-300 group-hover:text-sky-600 dark:text-zinc-300 dark:group-hover:text-sky-400"
                    />
                  </div>
                  <h3 class="mb-2 text-lg font-semibold text-zinc-900 dark:text-zinc-100">
                    {item.title}
                  </h3>
                  <p class="text-base leading-relaxed text-zinc-600 dark:text-zinc-300">
                    {item.description}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Teamwork Section -->
      <section class="bg-zinc-100 py-12 dark:bg-zinc-900">
        <div class="container mx-auto px-4">
          <h2 class="mb-12 text-center text-3xl font-bold dark:text-zinc-100">
            Teamwork makes the dream work
          </h2>

          <div
            class="mx-auto mt-8 grid max-w-7xl grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3"
          >
            {
              teamworkItems.map((item) => (
                <div class="group space-y-4">
                  <div class="inline-flex h-16 w-16 items-center justify-center rounded-lg bg-zinc-200 transition-colors duration-300 group-hover:bg-sky-100 dark:bg-zinc-800 dark:group-hover:bg-sky-900/30">
                    <Icon
                      name={item.icon}
                      class="h-8 w-8 text-zinc-700 transition-colors duration-300 group-hover:text-sky-600 dark:text-zinc-300 dark:group-hover:text-sky-400"
                    />
                  </div>
                  <h3 class="dark:text-zinc-200">{item.title}</h3>
                  <p class="leading-loose text-zinc-800 dark:text-zinc-300">
                    {item.description}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
