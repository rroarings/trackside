---
import BaseHead from "../components/BaseHead.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts"

const links = [
	{
		title: "About",
		href: "/about",
		description: "Learn about our mission and the team behind F1 Guide",
	},
	{
		title: "Contact",
		href: "/contact",
		description: "Get in touch with us for questions or feedback",
	},
	{
		title: "FAQs",
		href: "/about/faqs",
		description: "Find answers to commonly asked questions about F1",
	},
	{
		title: "Attributions",
		href: "/about/attributions",
		description: "Credits and acknowledgments for content and resources",
	},
]
---

<html
	lang="en"
	class="bg-gray-100 dark:bg-slate-950">
	<head>
		<BaseHead
			title={`More | ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
		/>
	</head>

	<body>
		<Header />
		<main class="container mx-auto px-4 py-12">
			<h1 class="mb-8 text-4xl font-bold dark:text-slate-100">More F1 Resources</h1>
			<p class="mb-12 text-xl text-slate-600 dark:text-slate-400">
				Discover additional resources and information about Formula 1 racing.
			</p>

			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{
					links.map(({ title, href, description }) => (
						<a
							href={href}
							class="block rounded-lg border-2 border-transparent bg-slate-300 p-6 transition-all duration-300 hover:border-gray-300 hover:bg-gray-700 dark:bg-slate-700 dark:hover:border-slate-600 dark:hover:bg-slate-800">
							<h2 class="mb-2 text-2xl font-bold dark:text-slate-100">{title}</h2>
							<p class="text-slate-600 dark:text-slate-300">{description}</p>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
