---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import LatestPosts from "../../components/LatestPosts.astro";
import Standings from "../../components/Standings.astro";
import RaceCalendar from "../../components/RaceCalendar.astro";
import { SITE_TITLE } from "../../consts";
import { Image } from "astro:assets";
import teams25Img from "../../assets/circuits/06miami/mi04.jpg";
import teams24Img from "../../assets/circuits/08monaco/mc02.jpg";
import { Icon } from "astro-icon/components";
---

<!doctype html>
<html lang="en" class="bg-zinc-100 dark:bg-zinc-900">
  <head>
    <BaseHead
      title={`F1 Seasons | ${SITE_TITLE}`}
      description="Formula 1 seasons coverage and archives"
    />
  </head>
  <body>
    <Header />
    <main>
      <!-- Seasons Overview Header -->
      <section class="py-16 text-center">
        <div class="mx-auto">
          <h1 class="mb-4 text-4xl font-bold dark:text-zinc-100">
            Formula 1 Seasons
          </h1>
          <p class="text-lg text-zinc-700 dark:text-zinc-300">
            Comprehensive coverage of F1 seasons, drivers, and teams
          </p>
        </div>
      </section>

      <!-- Seasons Grid -->
      <section class="mx-auto py-8">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <!-- 2026 Season -->
          <div class="md:col-span-2 dark:text-zinc-100">
            <Image
              src={teams25Img}
              alt="2026 F1 Season Miami"
              class="w-full rounded"
              loading="eager"
            />
            <div class="flex grow flex-col py-4">
              <h2 class="mb-2 text-2xl font-bold">2026 Formula 1 Season</h2>
              <p class="mb-4 grow text-zinc-700 dark:text-zinc-300">
                The current Formula 1 season with the latest races, driver
                standings, and championship battles.
              </p>
              <div class="space-y-2">
                <a
                  href="/seasons/2026"
                  class="block flex-1 rounded border-2 border-transparent bg-rose-600 px-4 py-2 text-center text-white transition-all duration-300 hover:bg-rose-700 dark:bg-rose-600 dark:text-zinc-100 dark:hover:border-rose-500 dark:hover:bg-rose-700"
                >
                  View 2026 Season
                </a>
                <div class="flex gap-2">
                  <a
                    href="/seasons/2026/drivers"
                    class="block flex-1 rounded border-2 border-transparent bg-zinc-600 px-4 py-2 text-center text-white transition-all duration-300 hover:bg-zinc-700 dark:bg-zinc-700 dark:hover:border-zinc-600 dark:hover:bg-zinc-800"
                  >
                    Drivers
                  </a>
                  <a
                    href="/seasons/2026/constructors"
                    class="flex-1 rounded border-2 border-transparent bg-zinc-600 px-4 py-2 text-center text-white transition-all duration-300 hover:bg-zinc-700 dark:bg-zinc-700 dark:hover:border-zinc-600 dark:hover:bg-zinc-800"
                  >
                    Constructors
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- 2025 Season -->
          <div class="dark:text-zinc-100">
            <Image
              src={teams25Img}
              alt="2025 F1 Season China"
              class="w-full rounded"
              loading="eager"
            />
            <div class="flex grow flex-col py-4">
              <h2 class="mb-2 text-2xl font-bold">2025 Formula 1 Season</h2>
              <p class="mb-4 grow text-zinc-700 dark:text-zinc-300">
                The 2025 Formula 1 season, featuring final race results, driver
                standings, and championship outcomes.
              </p>
              <div class="space-y-2">
                <a
                  href="/seasons/2025"
                  class="block rounded border-2 border-transparent bg-zinc-600 px-4 py-2 text-center text-white transition-all duration-300 hover:bg-zinc-700 dark:bg-zinc-700 dark:hover:border-zinc-600 dark:hover:bg-zinc-800"
                >
                  View 2025 Season
                </a>
                <div class="flex gap-2">
                  <a
                    href="/seasons/2025/drivers"
                    class="block flex-1 rounded border-2 border-transparent bg-zinc-600 px-4 py-2 text-center text-white transition-all duration-300 hover:bg-zinc-700 dark:bg-zinc-700 dark:hover:border-zinc-600 dark:hover:bg-zinc-800"
                  >
                    Drivers
                  </a>
                  <a
                    href="/seasons/2025/constructors"
                    class="flex-1 rounded border-2 border-transparent bg-zinc-600 px-4 py-2 text-center text-white transition-all duration-300 hover:bg-zinc-700 dark:bg-zinc-700 dark:hover:border-zinc-600 dark:hover:bg-zinc-800"
                  >
                    Constructors
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- 2024 Season -->
          <div class="dark:text-zinc-100">
            <Image
              src={teams24Img}
              alt="2024 F1 Season Monaco"
              class="w-full rounded"
              loading="eager"
            />
            <div class="py-4">
              <h2 class="mb-2 text-2xl font-bold">2024 Formula 1 Season</h2>
              <p class="mb-4 text-zinc-700 dark:text-zinc-300">
                Complete coverage of the 2024 season including race results,
                championship standings, and season highlights.
              </p>
              <div class="space-y-2">
                <a
                  href="/seasons/2024"
                  class="block rounded border-2 border-transparent bg-zinc-600 px-4 py-2 text-center text-white transition-all duration-300 hover:bg-zinc-700 dark:bg-zinc-700 dark:hover:border-zinc-600 dark:hover:bg-zinc-800"
                >
                  View 2024 Season
                </a>
                <div class="flex gap-2">
                  <a
                    href="/seasons/2024/drivers"
                    class="flex-1 rounded border-2 border-transparent bg-zinc-600 px-4 py-2 text-center text-white transition-all duration-300 hover:bg-zinc-700 dark:bg-zinc-700 dark:hover:border-zinc-600 dark:hover:bg-zinc-800"
                  >
                    Drivers
                  </a>
                  <a
                    href="/seasons/2024/constructors"
                    class="flex-1 rounded border-2 border-transparent bg-zinc-600 px-4 py-2 text-center text-white transition-all duration-300 hover:bg-zinc-700 dark:bg-zinc-700 dark:hover:border-zinc-600 dark:hover:bg-zinc-800"
                  >
                    Constructors
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Features Section -->
      <section class="bg-zinc-100 py-12 dark:bg-zinc-900">
        <div class="mx-auto px-4">
          <h2 class="mb-8 text-center text-3xl font-bold dark:text-zinc-100">
            What You'll Find
          </h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-3 dark:text-zinc-200">
            <div class="text-center">
              <Icon
                name="mdi:calendar-range-outline"
                class="mx-auto mb-4 text-4xl text-zinc-700 dark:text-zinc-200"
              />
              <h3 class="mb-2 text-xl font-bold">Race Calendars</h3>
              <p class="text-zinc-600 dark:text-zinc-300">
                Complete schedules with dates, circuits, and race information
              </p>
            </div>
            <div class="text-center">
              <Icon
                name="mdi:person-card-details-outline"
                class="mx-auto mb-4 text-4xl text-zinc-700 dark:text-zinc-200"
              />
              <h3 class="mb-2 text-xl font-bold">Driver Profiles</h3>
              <p class="text-zinc-600 dark:text-zinc-300">
                In-depth coverage of all Formula 1 drivers and their statistics
              </p>
            </div>
            <div class="text-center">
              <Icon
                name="mdi:chart-waterfall"
                class="mx-auto mb-4 text-4xl text-zinc-700 dark:text-zinc-200"
              />
              <h3 class="mb-2 text-xl font-bold">Team Analysis</h3>
              <p class="text-zinc-600 dark:text-zinc-300">
                Constructor teams, their cars, and performance insights
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Standings Section -->
      <section class="bg-zinc-100 py-16 dark:bg-zinc-900">
        <div class="container mx-auto px-4">
          <h2 class="mb-6 text-center text-2xl font-bold dark:text-zinc-100">
            2025 Championship Standings
          </h2>

          <Standings season="2025" />
        </div>
      </section>

      <!-- Race Spotlight Section -->
      <section class="bg-zinc-100 py-12 dark:bg-zinc-900">
        <div class="container mx-auto px-4">
          <header class="mb-12 text-center">
            <h2 class="text-3xl font-bold dark:text-zinc-100">
              Race Spotlight
            </h2>
            <p class="mt-2 text-lg text-zinc-600 dark:text-zinc-300">
              A look at the previous, next, and upcoming races on the 2026
              calendar.
            </p>
          </header>
          <RaceCalendar
            season="2026"
            showAllRaces={false}
            showTitle={true}
            eagerCount={0}
          />
        </div>
      </section>

      <!-- Latest Blog Posts Section -->
      <LatestPosts />
    </main>
    <Footer />
  </body>
</html>
