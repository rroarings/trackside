---
import BaseHead from "../../../../components/BaseHead.astro"
import Header from "../../../../components/Header.astro"
import Footer from "../../../../components/Footer.astro"
import Breadcrumbs from "../../../../components/Breadcrumbs.astro"
import SeasonButtons from "../../../../components/SeasonButtons.astro"
import StatCard from "../../../../components/StatCard.astro"
import DriverCard from "../../../../components/DriverCard.astro"
import { SITE_TITLE } from "../../../../consts"
import { getCollection } from "astro:content"

export async function getStaticPaths() {
	const teams = await getCollection("constructors", ({ data }) => data.season === "2025")
	return teams.map((team) => {
		const slug = team.id.split("/").pop()
		return {
			params: { slug },
			props: { team },
		}
	})
}

const { team } = Astro.props
// Import the Content component separately
import { render } from "astro:content"
import { Image } from "astro:assets"
import { teamBgMap } from "../../../../utils/teamBgMap"
const { Content } = await render(team)

// Get all drivers for 2025 season
const drivers = await getCollection("drivers", ({ data }) => data.season === "2025")
// Map drivers by full name for easy lookup
const driverMap = new Map()
drivers.forEach((driver) => {
	const fullName = `${driver.data.driverFirstName} ${driver.data.driverLastName}`
	driverMap.set(fullName, driver)
})
---

<!doctype html>
<html
	lang="en"
	class="bg-gray-100 dark:bg-slate-950">
	<head>
		<BaseHead
			title={`2025 ${team.data.constructorName} Team Profile | ${SITE_TITLE}`}
			description={`2025 F1 team profile for ${team.data.constructorName} with their ${team.data.carModel} car`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<Breadcrumbs
				items={[
					{ text: "Formula 1", href: "/" },
					{ text: "Seasons", href: "/seasons/" },
					{ text: "2025 Season", href: "/seasons/2025/" },
					{ text: "Constructors", href: "/seasons/2025/constructors" },
					{ text: `${team.data.constructorName}` },
				]}
			/>
			<!-- Team Profile Header -->
			<section class="mb-8 mt-12 rounded-2xl bg-white p-6 shadow-lg dark:bg-slate-900">
				<div class="grid grid-cols-1 items-center gap-8 md:grid-cols-2">
					<!-- Left: Car Image -->
					<div class="flex">
						<Image
							src={team.data.carImageLarge || team.data.carImage}
							alt={team.data.carImageLargeAlt || team.data.carImageAlt}
							width={600}
							height={600}
							class="rounded-2xl border-4 border-gray-200 object-cover dark:border-slate-800"
						/>
					</div>
					<!-- Right: Driver Info & Stats -->
					<div>
						<h1 class="mb-2 text-4xl font-bold text-gray-900 dark:text-slate-100">
							{team.data.constructorName}
						</h1>
						<div class="mb-6 flex flex-wrap gap-4">
							<span
								class="inline-flex items-center rounded-full bg-gray-100 px-4 py-1 text-lg text-blue-700 dark:bg-slate-800 dark:text-slate-300">
								{team.data.carModel}
							</span>
							<span
								class="inline-flex items-center rounded-full bg-gray-100 px-4 py-1 text-lg text-gray-700 dark:bg-slate-800 dark:text-slate-300">
								Engine: {team.data.engineSupplier}
							</span>
							<span
								class="inline-flex items-center rounded-full bg-gray-100 px-4 py-1 text-lg text-green-700 dark:bg-slate-800 dark:text-slate-300">
								Principal: {team.data.teamPrincipal}
							</span>
						</div>
						<!-- Stats Grid -->
						<div class="grid grid-cols-2 gap-4">
							<div class="rounded-xl bg-gray-50 p-4 text-center dark:bg-slate-800">
								<div class="text-2xl font-bold text-gray-900 dark:text-slate-100">
									{team.data.constructorPoints}
								</div>
								<div class="text-sm text-gray-500 dark:text-slate-400">Points</div>
							</div>
							<div class="rounded-xl bg-gray-50 p-4 text-center dark:bg-slate-800">
								<div class="text-2xl font-bold text-gray-900 dark:text-slate-100">
									{team.data.podiumPositions}
								</div>
								<div class="text-sm text-gray-500 dark:text-slate-400">Podiums</div>
							</div>
							<div class="rounded-xl bg-gray-50 p-4 text-center dark:bg-slate-800">
								<div class="text-2xl font-bold text-gray-900 dark:text-slate-100">
									{team.data.grandPrixWins}
								</div>
								<div class="text-sm text-gray-500 dark:text-slate-400">Grand Prix Wins</div>
							</div>
							<div class="rounded-xl bg-gray-50 p-4 text-center dark:bg-slate-800">
								<div class="text-2xl font-bold text-gray-900 dark:text-slate-100">
									{team.data.careerStats?.constructorChampionships || 0}
								</div>
								<div class="text-sm text-gray-500 dark:text-slate-400">
									Constructor Championships
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Team Drivers Section -->
			<section class="bg-white py-12 dark:bg-slate-950">
				<div class="container mx-auto">
					<h2 class="mb-8 text-center text-3xl font-bold dark:text-slate-200">Team Drivers</h2>
					<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-2">
						{
							team.data.teamDrivers.map((driverName, i) => {
								const driver = driverMap.get(driverName)
								return driver ?
										<DriverCard
											driver={driver}
											index={i}
											year={team.data.season}
											eagerCount={2}
										/>
									:	null
							})
						}
					</div>
				</div>
			</section>

			<!-- Two Column Statistics Section -->
			<section class="bg-slate-100 p-8 py-12 dark:bg-slate-950">
				<div class="container mx-auto">
					<h2 class="mb-8 text-center text-3xl font-bold dark:text-slate-200">Team Statistics</h2>
					<div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 md:grid-cols-2">
						{/* Team Statistics Column */}
						<div>
							<h3 class="mb-4 text-center text-xl font-semibold dark:text-slate-100">
								2025 Season Statistics
							</h3>
							{/* 2025 Season Statistics Column */}
							<div class="-mx-2 flex flex-wrap">
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.championshipPosition}
										label="Championship Position"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.constructorPoints}
										label="Constructor Points"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.grandPrixWins}
										label="Grand Prix Wins"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.polePositions}
										label="Pole Positions"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.fastestLaps}
										label="Fastest Laps"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.sprintPodiums}
										label="Sprint Podiums"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.sprintPoints}
										label="Sprint Points"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.sprintWins}
										label="Sprint Wins"
									/>
								</div>
							</div>
						</div>
						{/* Lifetime Statistics Column */}
						<div>
							<h3 class="mb-4 text-center text-xl font-semibold dark:text-slate-100">
								Lifetime Statistics
							</h3>
							<div class="-mx-2 flex flex-wrap">
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.careerStats?.driverChampionships}
										label="Driver Championships"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.careerStats?.constructorChampionships}
										label="Constructor Championships"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.careerStats?.firstEntry}
										label="First Entry"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.careerStats?.racesEntered}
										label="Races Entered"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.careerStats?.grandPrixWins}
										label="Grand Prix Wins"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.careerStats?.careerPoints}
										label="Career Points"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.careerStats?.polePositions}
										label="Pole Positions"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={team.data.careerStats?.podiumPositions}
										label="Podiums"
									/>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Team Information -->
			<section class="bg-gray-100 py-12 dark:bg-slate-950">
				<div class="container mx-auto">
					<div class="prose prose-lg dark:prose-invert max-w-none">
						<Content />
					</div>
				</div>
			</section>

			<!-- Back Links -->
			<SeasonButtons season="2025" />
		</main>
		<Footer />
	</body>
</html>
