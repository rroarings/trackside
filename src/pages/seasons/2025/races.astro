---
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import RaceCalendar from "../../../components/RaceCalendar.astro";
import SeasonButtons from "../../../components/SeasonButtons.astro";
import { SITE_TITLE } from "../../../consts";
---

<!doctype html>
<html lang="en" class="bg-gray-100 dark:bg-slate-950">
  <head>
    <BaseHead
      title={`2025 F1 Races | ${SITE_TITLE}`}
      description="Complete list of races for the 2025 Formula 1 season"
    />
  </head>
  <body>
    <Header />
    <main>
      <!-- 2025 Races Header -->
      <section class="pb-6 pt-6 text-center">
        <div class="container mx-auto px-4">
          <h1 class="mb-4 text-4xl font-bold dark:text-slate-100">
            2025 Formula 1 Races
          </h1>
          <p class="text-lg text-gray-700 dark:text-slate-400">
            Complete race calendar for the 2025 season
          </p>
        </div>
      </section>

      <!-- Race Calendar -->
      <section class="py-6">
        <div class="container mx-auto px-4">
          <RaceCalendar season="2025" showAllRaces={true} eagerCount={6} />
        </div>
      </section>

      <!-- Back Link -->
      <SeasonButtons season="2025" />
    </main>
    <Footer />
  </body>
</html>
