---
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { SITE_TITLE } from "../../../consts";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SeasonNavCards from "../../../components/SeasonNavCards.astro";
import Standings from "../../../components/Standings.astro";
import RaceCalendar from "../../../components/RaceCalendar.astro";
import LatestPosts from "../../../components/LatestPosts.astro";

const isDevMode = import.meta.env.DEV;
---

<!doctype html>
<html lang="en" class="bg-zinc-100 dark:bg-zinc-900">
  <head>
    <BaseHead
      title={`2026 F1 Season | ${SITE_TITLE}`}
      description="Complete 2026 Formula 1 race calendar and season overview"
    />
  </head>
  <body>
s    <Header />
    <main>
      <Breadcrumbs
        items={[
          { text: "Home", href: "/" },
          { text: "Seasons", href: "/seasons" },
          { text: "2026", href: "/seasons/2026/" },
        ]}
      />

      <!-- 2025 Season Header -->
      <section class="pb-6 pt-6 text-center dark:text-zinc-100">
        <div class="container mx-auto px-4">
          <h1 class="mb-4 text-4xl font-bold">State of the Season</h1>
          <p class="mx-auto max-w-3xl text-lg leading-loose text-zinc-800 dark:text-zinc-300">
            The 2026 season is shaping up to be a thriller. With new regulations
            shaking up the grid and fierce rivalries igniting, follow along for
            real-time standings, race results, and in-depth analysis.
          </p>
        </div>
      </section>

      <!-- Driver / Constructor Nav Cards -->
      <SeasonNavCards season="2026" />

      <!-- Standings Section -->
      <section class="bg-zinc-100 py-16 dark:bg-zinc-900">
        <div class="container mx-auto px-4">
          <h2 class="mb-6 text-center text-2xl font-bold dark:text-zinc-100">
            2026 Championship Standings
          </h2>
          <Standings season="2026" imageLoading="eager" />
        </div>
      </section>

      <!-- Race Calendar -->
      <section class="bg-zinc-100 py-16 dark:bg-zinc-900">
        <div class="container mx-auto px-4">
          <h2 class="mb-8 text-center text-2xl font-bold dark:text-zinc-100">
            2026 Race Calendar Preview
          </h2>
          <RaceCalendar
            season="2026"
            showAllRaces={false}
            showTitle={true}
            eagerCount={0}
          />
        </div>
      </section>

      <!-- Latest Blog Posts Section -->
      <LatestPosts />
    </main>
    <Footer />
  </body>
</html>
