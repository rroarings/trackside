---
import BaseHead from "../../../../components/BaseHead.astro"
import Header from "../../../../components/Header.astro"
import Footer from "../../../../components/Footer.astro"
import BreakpointIndicator from "../../../../components/BreakpointIndicator.astro"
import Breadcrumbs from "../../../../components/Breadcrumbs.astro"
import StatCard from "../../../../components/StatCard.astro"
import SeasonButtons from "../../../../components/SeasonButtons.astro"
import SeasonButtonsModular from "../../../../components/SeasonButtonsModular.astro"
import FormattedDate from "../../../../components/FormattedDate.astro"
import { SITE_TITLE } from "../../../../consts"
import { getCollection } from "astro:content"

export async function getStaticPaths() {
	const drivers = await getCollection("drivers", ({ data }) => data.season === "2026")
	return drivers.map((driver) => {
		const slug = (driver as any).slug ?? driver.id.split("/").pop()
		return {
			params: { slug },
			props: { driver },
		}
	})
}

const { driver } = Astro.props
// Import the Content component separately
import { render } from "astro:content"
import { Image } from "astro:assets"
import { teamBgMap } from "../../../../utils/teamBgMap"
const { Content } = await render(driver)
// team background for driver's team
const teamBg = teamBgMap[driver.data.driverTeam] || null
---

<!doctype html>
<html
	lang="en"
	class="bg-slate-100 dark:bg-slate-900">
	<head>
		<BaseHead
			title={`2026 ${driver.data.driverFirstName} ${driver.data.driverLastName} Driver Profile | ${SITE_TITLE}`}
			description={`2026 F1 driver profile for ${driver.data.driverFirstName} ${driver.data.driverLastName} driving for ${driver.data.driverTeam}`}
		/>
	</head>
	<body>
		<Header />
		<BreakpointIndicator />
		<main>
			<Breadcrumbs
				items={[
					{ text: "Home", href: "/" },
					{ text: "Seasons", href: "/seasons/" },
					{ text: "2026", href: "/seasons/2026/" },
					{ text: "Drivers", href: "/seasons/2026/drivers" },
					{
						text: `${driver.data.driverFirstName} ${driver.data.driverLastName}`,
					},
				]}
			/>

			<!-- driver slug hero -->
			<section class="mb-8 mt-12 rounded-2xl bg-white p-6 shadow-lg dark:bg-slate-950">
				<div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
					<!-- Left: Driver Image with team background -->
					<div
						class="flex flex-1 overflow-hidden rounded-2xl"
						style={teamBg ? `background-image: url('${teamBg.src}'); background-size: cover;` : ""}>
						<div class="flex flex-1 justify-end">
							<Image
								src={driver.data.profileImageLarge || driver.data.profileImage}
								alt={driver.data.profileImageLargeAlt || driver.data.profileImageAlt}
								width={400}
								height={400}
								class="h-full object-contain"
								loading="eager"
							/>
						</div>
					</div>
					<!-- Right: Driver Info & Stats -->
					<div>
						<h1 class="mb-2 text-4xl font-bold text-slate-900 dark:text-slate-100">
							{driver.data.driverFirstName}
							{driver.data.driverLastName}
						</h1>

						<!-- Stats Grid -->
						<div class="grid grid-cols-2 gap-4">
							<div class="rounded-xl bg-slate-200/50 p-4 text-center dark:bg-slate-800">
								<div class="text-2xl font-bold text-slate-900 dark:text-slate-100">
									{driver.data.driverTeam}
								</div>
								<div class="text-base text-slate-500 dark:text-slate-400">Team</div>
							</div>
							<div class="rounded-xl bg-slate-200/50 p-4 text-center dark:bg-slate-800">
								<div class="text-2xl font-bold text-slate-900 dark:text-slate-100">
									{driver.data.age}
								</div>
								<div class="text-base text-slate-500 dark:text-slate-400">Age</div>
							</div>
							<div class="rounded-xl bg-slate-200/50 p-4 text-center dark:bg-slate-800">
								<div class="text-2xl font-bold text-slate-900 dark:text-slate-100">
									{driver.data.championshipPosition}
								</div>
								<div class="text-base text-slate-500 dark:text-slate-400">
									Championship Position
								</div>
							</div>
							<div class="rounded-xl bg-slate-200/50 p-4 text-center dark:bg-slate-800">
								<div class="text-2xl font-bold text-slate-900 dark:text-slate-100">
									{driver.data.driverPoints}
								</div>
								<div class="text-base text-slate-500 dark:text-slate-400">Points</div>
							</div>

							<div class="rounded-xl bg-slate-200/50 p-4 text-center dark:bg-slate-800">
								<div class="text-2xl font-bold text-slate-900 dark:text-slate-100">
									{driver.data.grandPrixWins}
								</div>
								<div class="text-base text-slate-500 dark:text-slate-400">Grand Prix Wins</div>
							</div>
							<div class="rounded-xl bg-slate-200/50 p-4 text-center dark:bg-slate-800">
								<div class="text-2xl font-bold text-slate-900 dark:text-slate-100">
									{driver.data.nationality}
								</div>
								<div class="text-base text-slate-500 dark:text-slate-400">Nationality</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Two Column Statistics Section -->
			<section class="bg-slate-100 p-8 py-12 dark:bg-slate-900">
				<div class="container mx-auto">
					<h2 class="mb-8 text-center text-3xl font-bold dark:text-slate-200">Driver Statistics</h2>
					<div class="mx-auto grid grid-cols-1 gap-8 lg:grid-cols-2">
						{/* Team Statistics Column */}
						<div class="p-6">
							<h3 class="mb-4 text-center text-xl font-semibold dark:text-slate-100">
								2026 Season
							</h3>
							<div class="-mx-2 flex flex-wrap">
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={driver.data.championshipPosition}
										label="Championship Position"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={driver.data.driverPoints}
										label="Driver Points"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={driver.data.grandPrixWins}
										label="Grand Prix Wins"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={driver.data.polePositions}
										label="Pole Positions"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={driver.data.fastestLaps}
										label="Fastest Laps"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={driver.data.podiums}
										label="Podiums"
									/>
								</div>
							</div>
						</div>
						{/* Lifetime Statistics Column */}
						<div class="rounded bg-slate-200/50 p-6 dark:bg-slate-500/50">
							<h3 class="mb-4 text-center text-xl font-semibold dark:text-slate-100">Lifetime</h3>
							<div class="-mx-2 flex flex-wrap">
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={driver.data.careerStats?.championships}
										label="Championships"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={driver.data.careerStats?.careerPoints}
										label="Career Points"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={driver.data.careerStats?.grandPrixWins}
										label="Grand Prix Wins"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={driver.data.careerStats?.polePositions}
										label="Pole Positions"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={driver.data.careerStats?.fastestLaps}
										label="Fastest Laps"
									/>
								</div>
								<div class="mb-6 w-1/2 px-2 md:w-1/2">
									<StatCard
										value={driver.data.careerStats?.podiumPositions}
										label="Podiums"
									/>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Driver Biography -->
			<section class="bg-slate-100 py-12 dark:bg-slate-900">
				<div class="container mx-auto">
					<div class="prose prose-lg dark:prose-invert max-w-fit">
						<Content />
					</div>
				</div>
			</section>

			<!-- Back Link -->
			<SeasonButtonsModular
				leftHref="/seasons/2026/drivers/"
				leftText="Back to 2026 Drivers"
				rightHref="/seasons"
				rightText="Back to Seasons"
			/>

			{/* Last Updated Section */}
			<section class="pt-12 text-center">
				<p class="text-slate-600 dark:text-slate-400">
					{
						driver.data.updatedDate && (
							<>
								Last updated: <FormattedDate date={new Date(driver.data.updatedDate)} />
							</>
						)
					}
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
