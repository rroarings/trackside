---
import BaseHead from "../components/BaseHead.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { Image } from "astro:assets"
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts"
import AboutHeroImage from "../assets/blog-placeholder-about.jpg"
import "../styles/global.css"
---

<!doctype html>
<html
	lang="en"
	class="bg-slate-100 dark:bg-slate-900">
	<head>
		<BaseHead
			title={`About | ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section -->
			<section
				class="h-87.5 md:h-112.5 relative mb-12 flex w-full items-center justify-center overflow-hidden">
				<Image
					src={AboutHeroImage}
					alt="About hero"
					class="absolute inset-0 z-0 h-full w-full object-cover object-center brightness-75"
					loading="eager"
				/>
				<div
					class="relative z-10 flex h-full w-full flex-col items-center justify-center text-center">
					<h1 class="mb-4 font-extrabold text-white drop-shadow-lg md:text-5xl">About Trackside</h1>
					<p class="mx-auto text-lg text-white/90 drop-shadow-md md:text-2xl">
						Your home for Formula 1 stats, schedules, and stories.
					</p>
				</div>
				<div class="z-1 bg-linear-to-b absolute inset-0 from-black/40 to-transparent"></div>
			</section>

			<!-- Mission Section -->
			<section class="py-12">
				<div class="mx-auto max-w-3xl text-center">
					<h3 class="mb-4 text-2xl font-bold text-slate-900 md:text-3xl dark:text-slate-300">
						Trackside: For the Fans, By a Fan
					</h3>

					<p class="mt-4 text-slate-900 dark:text-slate-400">
						Trackside is my way of sharing the thrill of Formula 1 with the world. I want to make it
						easy, fun, and beautiful for fans to follow the sport we love.
					</p>
				</div>
			</section>

			<!-- Profile Section -->
			<section class="flex flex-col items-center gap-4 py-6">
				<Image
					src={AboutHeroImage}
					alt="About hero"
					class="h-32 w-32 rounded-full border-4 border-blue-500 object-cover shadow-md"
					loading="eager"
				/>
				<h2 class="text-3xl font-bold text-slate-900 dark:text-slate-200">Nick Calvo</h2>
				<p class="text-lg text-slate-600 dark:text-slate-400">
					F1 Fan • Web Developer • Creator of Trackside
				</p>
				<div class="mt-2 flex gap-4">
					<a
						href="mailto:nick@example.com"
						class="text-slate-600 hover:underline"
						>Email</a
					>
					<a
						href="https://twitter.com/yourhandle"
						class="text-slate-600 hover:underline"
						>Twitter</a
					>
					<a
						href="https://github.com/rroarings/trackside"
						class="text-slate-600 hover:underline"
						>GitHub</a
					>
					<a
						href="/contact"
						class="text-slate-600 hover:underline"
						>Contact</a
					>
				</div>
			</section>

			<!-- About & Mission Section -->
			<section class="prose prose-lg dark:prose-invert max-w-fit py-12">
				<h2 class="">👋 Welcome!</h2>
				<p class="">
					Trackside is built for Formula 1 fans who want a clean, modern way to follow the season.
					Explore race calendars, team and driver stats, and more—all in one place.
				</p>
				<div>
					<h3 class="">🚦 What is Trackside?</h3>
					<p class="">
						Trackside is your digital paddock: a place to check race schedules, explore team and
						driver stats, and discover stories from the world of Formula 1. My goal is to make
						following F1 easier, more fun, and more engaging for everyone.
					</p>
				</div>
				<div>
					<h3 class="">🛠️ How is it built?</h3>
					<p class="">
						Trackside is built with Astro, Tailwind CSS, and a modern JavaScript stack. The site is
						designed for speed, performance, optimization, accessibility, and a great experience on
						any device.
					</p>
					<p class="">
						<a href="https://github.com/rroarings/trackside"
							>Explore the project behind the scenes on GitHub.</a
						>
					</p>
				</div>
			</section>

			<!-- Fun Facts Section -->
			<section class="py-12">
				<h2 class="mb-8 text-center text-2xl font-bold text-slate-900 dark:text-slate-200">
					Fun Facts
				</h2>
				<div class="flex flex-col items-stretch justify-center gap-6 md:flex-row">
					<div class="flex-1 rounded-lg bg-slate-50 p-6 text-center dark:bg-slate-700">
						<div class="mb-2 text-4xl">🏁</div>
						<div class="mb-1 text-lg font-bold dark:text-slate-300">Favorite Track</div>
						<div class="text-slate-700 dark:text-slate-300">Circuit of the Americas / COTA</div>
					</div>
					<div class="flex-1 rounded-lg bg-slate-50 p-6 text-center dark:bg-slate-700">
						<div class="mb-2 text-4xl">🥇</div>
						<div class="mb-1 text-lg font-bold dark:text-slate-300">All-Time Favorite Driver</div>
						<div class="text-slate-700 dark:text-slate-300">Fernando Alonso</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
