---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AboutHeroImage from "../assets/blog-placeholder-about.jpg";
import "../styles/global.css";

const funFacts = [
  {
    title: "Fan Since",
    description: "2019 — started with Drive to Survive 😎",
    emoji: "📺",
    color: "amber",
  },
  {
    title: "Favorite Track",
    description: "Circuit of the Americas (COTA)",
    emoji: "🏁",
    color: "red",
  },
  {
    title: "Favorite Drivers",
    description: "🇪🇸 Fernando Alonso, Carlos Sainz",
    emoji: "🥇",
    color: "green",
  },
  {
    title: "Favorite Team",
    description: "Aston Martin F1 Team",
    emoji: "🧢",
    color: "green",
  },
  {
    title: "Races Attended",
    description: "1 GP - Texas Rules 🤠",
    emoji: "🏟️",
    color: "purple",
  },
  {
    title: "Sim Racing",
    description: "F1 25, Assetto Corsa enthusiast",
    emoji: "🎮",
    color: "sky",
  },
];
---

<!doctype html>
<html lang="en" class="bg-zinc-100 dark:bg-zinc-900">
  <head>
    <BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <!-- Hero Section -->
      <section
        class="h-87.5 md:h-112.5 relative mb-12 flex w-full items-center justify-center overflow-hidden"
      >
        <Image
          src={AboutHeroImage}
          alt="About hero"
          class="absolute inset-0 z-0 h-full w-full object-cover object-center brightness-75"
          loading="eager"
        />
        <div
          class="relative z-10 flex h-full w-full flex-col items-center justify-center text-center"
        >
          <h1 class="mb-4 font-extrabold text-white drop-shadow-lg md:text-5xl">
            About Trackside
          </h1>
          <p class="mx-auto text-lg text-white/90 drop-shadow-md md:text-2xl">
            Your home for Formula 1 stats, schedules, and stories.
          </p>
        </div>
        <div
          class="z-1 bg-linear-to-b absolute inset-0 from-black/40 to-transparent"
        >
        </div>
      </section>

      <!-- Mission Section -->
      <section class="py-12">
        <div class="mx-auto max-w-3xl text-center">
          <h3
            class="mb-4 text-2xl font-bold text-zinc-900 md:text-3xl dark:text-zinc-300"
          >
            Trackside: For the Fans, By a Fan
          </h3>

          <p class="mt-4 text-zinc-900 dark:text-zinc-300">
            Trackside is my way of sharing the thrill of Formula 1 with the
            world. I want to make it easy, fun, and beautiful for fans to follow
            the sport we love.
          </p>
        </div>
      </section>

      <!-- Profile Section -->
      <section class="flex flex-col items-center gap-4 py-6">
        <Image
          src={AboutHeroImage}
          alt="About hero"
          class="h-32 w-32 rounded-full border-4 border-blue-500 object-cover shadow-md"
          loading="eager"
        />
        <h2 class="text-3xl font-bold text-zinc-900 dark:text-zinc-200">
          Nick Calvo
        </h2>
        <p class="text-lg text-zinc-600 dark:text-zinc-300">
          F1 Fan • Web Developer • Creator of Trackside
        </p>
        <div class="mt-2 flex gap-4">
          <a
            href="mailto:nick@example.com"
            class="text-zinc-800 transition-colors duration-200 hover:text-sky-600 hover:underline dark:text-zinc-300 hover:dark:text-zinc-200"
            >Email</a
          >
          <a
            href="https://github.com/rroarings/trackside"
            class="text-zinc-800 transition-colors duration-200 hover:text-sky-600 hover:underline dark:text-zinc-300 hover:dark:text-zinc-200"
            >GitHub</a
          >
          <a
            href="/contact"
            class="text-zinc-800 transition-colors duration-200 hover:text-sky-600 hover:underline dark:text-zinc-300 hover:dark:text-zinc-200"
            >Contact</a
          >
        </div>
      </section>

      <!-- About & Mission Section -->
      <section class="py-16">
        <div class="mx-auto max-w-4xl px-4">
          <div class="mb-10 text-center">
            <h2 class="text-3xl font-bold text-zinc-900 dark:text-zinc-100">
              Welcome to Trackside
            </h2>
            <p class="mx-auto mt-3 max-w-2xl text-zinc-600 dark:text-zinc-300">
              Built for Formula 1 fans who want a clean, modern way to follow
              the season.
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            <!-- What is Trackside Card -->
            <div
              class="group rounded-xl border-l-4 border-l-rose-500 bg-white p-6 shadow-sm transition-all duration-300 hover:shadow-md dark:bg-zinc-800"
            >
              <div class="mb-4 flex items-center gap-3">
                <div
                  class="rounded-full bg-rose-100 p-3 transition-colors duration-300 group-hover:bg-rose-200 dark:bg-rose-900/30 dark:group-hover:bg-rose-900/50"
                >
                  <Icon
                    name="mdi:flag-checkered"
                    class="h-6 w-6 text-rose-600 dark:text-rose-400"
                  />
                </div>
                <h3
                  class="text-lg font-semibold text-zinc-900 dark:text-zinc-100"
                >
                  What is Trackside?
                </h3>
              </div>
              <p class="leading-relaxed text-zinc-600 dark:text-zinc-300">
                Your digital paddock—check race schedules, explore team and
                driver stats, and discover stories from Formula 1. My goal is to
                make following F1 easier, more fun, and more engaging for
                everyone.
              </p>
            </div>

            <!-- How is it Built Card -->
            <div
              class="group rounded-xl border-l-4 border-l-sky-500 bg-white p-6 shadow-sm transition-all duration-300 hover:shadow-md dark:bg-zinc-800"
            >
              <div class="mb-4 flex items-center gap-3">
                <div
                  class="rounded-full bg-sky-100 p-3 transition-colors duration-300 group-hover:bg-sky-200 dark:bg-sky-900/30 dark:group-hover:bg-sky-900/50"
                >
                  <Icon
                    name="mdi:hammer-wrench"
                    class="h-6 w-6 text-sky-600 dark:text-sky-400"
                  />
                </div>
                <h3
                  class="text-lg font-semibold text-zinc-900 dark:text-zinc-100"
                >
                  How is it built?
                </h3>
              </div>
              <p class="leading-relaxed text-zinc-600 dark:text-zinc-300">
                Trackside is built with Astro, Tailwind CSS, and a modern
                JavaScript stack. Designed for speed, performance,
                accessibility, and a great experience on any device.
              </p>
            </div>

            <!-- Open Source Card -->
            <a
              href="https://github.com/rroarings/trackside"
              target="_blank"
              rel="noopener noreferrer"
              class="group rounded-xl border-l-4 border-l-emerald-500 bg-white p-6 shadow-sm transition-all duration-300 hover:shadow-md md:col-span-2 dark:bg-zinc-800"
            >
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div
                    class="rounded-full bg-emerald-100 p-3 transition-colors duration-300 group-hover:bg-emerald-200 dark:bg-emerald-900/30 dark:group-hover:bg-emerald-900/50"
                  >
                    <Icon
                      name="mdi:github"
                      class="h-6 w-6 text-emerald-600 dark:text-emerald-400"
                    />
                  </div>
                  <div>
                    <h3
                      class="text-lg font-semibold text-zinc-900 dark:text-zinc-100"
                    >
                      Explore on GitHub
                    </h3>
                    <p class="text-sm text-zinc-600 dark:text-zinc-300">
                      View the source code and contribute to the project
                    </p>
                  </div>
                </div>
                <Icon
                  name="mdi:arrow-right"
                  class="h-6 w-6 text-zinc-400 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-emerald-500 dark:text-zinc-500"
                />
              </div>
            </a>
          </div>
        </div>
      </section>

      <!-- Personal Fun Facts -->
      <section class="py-12">
        <h2
          class="mb-8 text-center text-2xl font-bold text-zinc-900 dark:text-zinc-200"
        >
          Personal Fun Facts
        </h2>
        <div class="mx-auto grid max-w-4xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            funFacts.map((fact) => (
              <div
                class:list={[
                  "group relative overflow-hidden rounded-xl border-l-4 bg-white p-6 shadow-md transition-all duration-300 hover:-translate-y-1 hover:shadow-xl dark:bg-zinc-800",
                  `border-${fact.color}-500 dark:border-${fact.color}-400`,
                ]}
              >
                <div
                  class:list={[
                    "mb-3 inline-flex h-12 w-12 items-center justify-center rounded-full text-2xl transition-transform duration-300 group-hover:scale-110",
                    `bg-${fact.color}-100 dark:bg-${fact.color}-900/30`,
                  ]}
                >
                  {fact.emoji}
                </div>
                <h3 class="mb-1 font-bold text-zinc-900 dark:text-zinc-100">
                  {fact.title}
                </h3>
                <p class="text-sm text-zinc-600 dark:text-zinc-300">
                  {fact.description}
                </p>
              </div>
            ))
          }
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
