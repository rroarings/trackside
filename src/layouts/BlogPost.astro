---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { Image } from "astro:assets";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import BlogButtons from "../components/BlogButtons.astro";
import "../styles/global.css";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en" class="bg-gray-100 dark:bg-slate-950">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      main {
        width: 1200px;
        max-width: calc(100% - 2em);
        margin: auto;
      }
      .hero-image {
        width: 100%;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }
      .prose {
        width: 1200px;
        max-width: calc(100% - 2em);
        line-height: 1.7;
      }
      .title {
        padding: 1em 0;
        text-align: left;
        line-height: 1;
      }
      .title h1 {
        margin: 0.8em 0 0.2em 0;
      }
      .last-updated-on {
        margin-top: 0.5em;
      }
      .post-tags {
        margin-top: 0.75em;
        margin-bottom: 0.75em;
      }
      .tag-pill {
        display: inline-block;
      }
      .dark .tag-pill {
        background-color: #0f1724; /* dark background in dark mode */
        color: #cbd5e1; /* light text in dark mode */
      }
      .date {
        margin-top: 1.4em;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <Breadcrumbs
        items={[
          { text: "Home", href: "/" },
          { text: "Blog", href: "/blog" },
          {
            text: `${Astro.props.title}`,
          },
        ]}
      />
      <article>
        {
          heroImage && (
            <div class="hero-image">
              <Image src={heroImage} alt={title} />
            </div>
          )
        }
        <div class="prose dark:prose-invert">
          <div class="title">
            <h1 class="title-heading tracking-tight dark:text-slate-100">
              {title}
            </h1>
            {
              Astro.props.tags && Astro.props.tags.length > 0 && (
                <div
                  class="post-tags mt-2 flex flex-wrap gap-2"
                  aria-hidden="true"
                >
                  {Astro.props.tags.map((tag) => (
                    <span class="rounded bg-slate-300 px-4 py-2 tracking-wide text-slate-800">
                      {tag}
                    </span>
                  ))}
                </div>
              )
            }
            <div class="date dark:text-slate-300">
              Published <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
          </div>
          <slot />
        </div>
        <BlogButtons />
      </article>
    </main>
    <Footer />
  </body>
</html>
