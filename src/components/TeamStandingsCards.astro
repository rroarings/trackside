---
import type { CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import { teamBgMap } from "../utils/teamBgMap";
import placeholderBG from "../assets/component/teamCard-placeholder.png";

interface Props {
  season: "2024" | "2025" | "2026";
  imageLoading?: "eager" | "lazy";
  sortedTeams: CollectionEntry<"constructors">[];
}

const { season, imageLoading = "lazy", sortedTeams } = Astro.props;

const topThree = sortedTeams.slice(0, 3);

const displayOrder =
  topThree.length === 3 ? [topThree[0], topThree[1], topThree[2]] : topThree;

const podiumAccentClasses = ["bg-amber-400", "bg-zinc-300", "bg-orange-500"];
const podiumLabelClasses = [
  "border-amber-300/70 bg-amber-400/20 text-amber-100",
  "border-zinc-200/70 bg-zinc-200/15 text-zinc-100",
  "border-orange-300/70 bg-orange-400/20 text-orange-100",
];

// Pre-process background images to WebP format
const optimizedBgImages = await Promise.all(
  displayOrder.map(async (team) => {
    const teamBg = teamBgMap[team.data.constructorName];
    if (teamBg) {
      const optimized = await getImage({
        src: teamBg,
        format: "webp",
        width: 800,
      });
      return optimized.src;
    }
    return null;
  }),
);

const gridClasses = [
  "md:col-span-2 md:row-start-1 lg:col-span-1 lg:row-start-auto",
  "md:col-start-1 md:row-start-2 lg:col-span-1 lg:row-start-auto",
  "md:col-start-2 md:row-start-2 lg:col-span-1 lg:row-start-auto",
];
---

<div
  class="grid grid-cols-1 gap-4 pb-16 md:grid-cols-2 md:grid-rows-2 lg:grid-cols-3 lg:grid-rows-1"
>
  {
    displayOrder.map((team, index) => {
      const bgUrl = optimizedBgImages[index];
      const teamSlug = (team as any).slug ?? team.id.split("/").pop();

      return (
        <div class={gridClasses[index]}>
          <a href={`/seasons/${season}/constructors/${teamSlug}`} class="block">
            <article
              class="group relative flex h-96 flex-row overflow-hidden rounded-2xl border border-zinc-200/20 px-6 py-5 transition-shadow duration-300 hover:shadow-2xl"
              style={
                bgUrl
                  ? `background-image: url('${bgUrl}'); background-size: cover; background-position: center;`
                  : ""
              }
            >
              <div
                class={`absolute inset-x-0 top-0 h-1 ${podiumAccentClasses[index]}`}
              />
              <div class="bg-linear-to-b pointer-events-none absolute inset-0 from-zinc-950/30 via-zinc-950/20 to-zinc-950/70" />
              <div class="relative z-10 flex h-full flex-1 flex-col justify-between">
                <div>
                  <div class="mb-4 flex items-start justify-between gap-4">
                    <div>
                      <p class="text-[4.5rem] font-bold leading-none tracking-[-0.06em] text-white/90 sm:text-[5.5rem]">
                        {team.data.championshipPosition}
                      </p>
                    </div>
                    <p class="pt-3 text-right text-2xl font-bold text-white">
                      {team.data.constructorPoints}
                      <span class="ml-1 text-sm font-medium uppercase tracking-[0.18em] text-zinc-200">
                        PTS
                      </span>
                    </p>
                  </div>

                  <h3 class="text-3xl font-bold leading-none text-white transition-colors duration-300 group-hover:text-rose-300 sm:text-4xl">
                    {team.data.constructorName}
                  </h3>
                  <div class="mt-3 flex flex-col gap-1">
                    {team.data.teamDrivers.map((driver: string) => (
                      <p class="text-sm font-semibold uppercase tracking-[0.22em] text-zinc-200">
                        {driver}
                      </p>
                    ))}
                  </div>
                </div>
                <div class="flex items-end justify-end">
                  <Image
                    src={team.data.carImage || placeholderBG}
                    alt={`Car for ${team.data.constructorName}`}
                    class="sm:max-h-68 max-h-60 object-contain"
                    width={400}
                    height={400}
                    loading={imageLoading}
                  />
                </div>
              </div>
            </article>
          </a>
        </div>
      );
    })
  }
</div>
