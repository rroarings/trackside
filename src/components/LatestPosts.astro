---
import { getCollection } from "astro:content"
import { Image } from "astro:assets"
import FormattedDate from "../components/FormattedDate.astro"

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
const latestPosts = posts.slice(0, 3)
---

<section class="bg-gray-100 py-12 dark:bg-gray-950">
	<div class="container mx-auto">
		<header class="mb-6 flex items-center gap-3">
			<h2 class="text-2xl font-bold dark:text-slate-100">Recent Posts</h2>
		</header>
		<ul class="grid grid-cols-1 gap-6 md:grid-cols-3">
			{latestPosts.map((post) => (
				<li>
					<article class="rounded-xl bg-white/80 dark:bg-slate-900/70 p-4 flex flex-col h-full">
						<a
							href={`/blog/${post.id}/`}
							aria-label={`Read post: ${post.data.title}`}
							class="block group focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500 rounded-xl"
						>
							{post.data.heroImage && (
								<Image
									width={720}
									height={360}
									src={post.data.heroImage}
									alt={post.data.title}
									class="rounded-lg mb-4 transition group-hover:opacity-90"
								/>
							)}
							<h3 class="mt-2 text-lg font-semibold text-gray-900 dark:text-slate-100 group-hover:underline">
								{post.data.title}
							</h3>
						</a>
						<p class="date mt-2 text-sm text-gray-500 dark:text-slate-400">
							<FormattedDate date={post.data.pubDate} />
						</p>
					</article>
				</li>
			))}
		</ul>
		<div class="mt-8 text-center">
			<a
				href="/blog"
				class="rounded border-2 border-transparent bg-gray-600 px-4 py-2 text-white transition-all duration-300 hover:bg-gray-700 dark:bg-slate-700 dark:hover:border-slate-600 dark:hover:bg-slate-800">
				Explore the blog
			</a>
		</div>
	</div>
</section>
