---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 3);
---

<style>
  @reference "../styles/global.css";
  @reference "tailwindcss";
  h3 {
    @apply m-0 text-xl tracking-tight dark:text-zinc-200;
  }

  @media (min-width: 768px) {
    h3 {
      @apply text-2xl;
    }
  }

  @media (min-width: 1024px) {
    h3 {
      @apply text-3xl;
    }
  }
</style>
<section class="bg-zinc-100 py-12 dark:bg-zinc-900">
  <div class="container mx-auto px-4">
    <header class="mb-6 flex items-center gap-3">
      <h2 class="text-2xl font-bold dark:text-zinc-100">Recent Posts</h2>
    </header>
    <ul class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        latestPosts.map((post) => (
          <li>
            <article class="flex h-full flex-col rounded-xl p-4 dark:bg-zinc-900/70">
              <a
                href={`/blog/${post.id}/`}
                aria-label={`Read post: ${post.data.title}`}
                class="group block rounded-xl focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2"
              >
                {post.data.heroImage && (
                  <div class="mb-4 overflow-hidden rounded-lg">
                    <Image
                      width={720}
                      height={360}
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="h-40 w-full object-cover transition group-hover:opacity-90"
                      loading="lazy"
                    />
                  </div>
                )}
                <h3 class="text-zinc-900 group-hover:underline dark:text-zinc-100">
                  {post.data.title}
                </h3>
              </a>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="mt-2 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="rounded bg-zinc-300 px-3 py-1 text-sm text-zinc-800 dark:bg-zinc-700 dark:text-zinc-300">
                      {tag}
                    </span>
                  ))}
                </div>
              )}

              <p class="date mt-2 text-sm text-zinc-600 dark:text-zinc-300">
                <FormattedDate date={post.data.pubDate} />
              </p>
            </article>
          </li>
        ))
      }
    </ul>
    <div class="mt-8 text-center">
      <a
        href="/blog"
        class="rounded border-2 border-transparent bg-zinc-600 px-4 py-2 text-white transition-all duration-300 hover:bg-zinc-700 dark:bg-zinc-700 dark:hover:border-zinc-600 dark:hover:bg-zinc-800"
      >
        Explore the blog
      </a>
    </div>
  </div>
</section>
