---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GridItem {
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt?: string;
  pageLink?: string;
}

interface Props {
  title: string;
  items: GridItem[];
}

const { title, items } = Astro.props;
---

<section class="container mx-auto px-4 py-12">
  <div class="space-y-8">
    <h2 class="text-3xl font-bold dark:text-slate-100">{title}</h2>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        items.map((item) => (
          <div class="group overflow-hidden rounded-lg transition-all duration-300">
            <div class="flex h-full flex-col p-6">
              <h3 class="mb-3 text-xl dark:text-slate-200">
                {item.title}
              </h3>
              <p class="mb-4 text-slate-800 dark:text-slate-400">
                {item.description}
              </p>
              <a
                href={item.pageLink}
                class="mb-6 text-slate-900 transition-colors duration-300 hover:text-blue-600 hover:underline dark:text-slate-400"
                target="_blank"
                rel="noopener noreferrer"
              >
                Read more...
              </a>
              <div class="relative mt-auto overflow-hidden rounded-lg">
                <Image
                  src={item.image}
                  alt={item.imageAlt || item.title}
                  class="h-48 w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  width={800}
                  height={400}
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
