---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";

interface GridItem {
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt?: string;
  pageLink?: string;
}

interface Props {
  title: string;
  items: GridItem[];
}

const { title, items } = Astro.props;
---

<section class="container mx-auto px-4 py-16">
  <div class="space-y-10">
    <div class="border-b border-zinc-300 pb-4 dark:border-zinc-700">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.28em] text-rose-600 dark:text-rose-400">
        Trackside Briefing
      </p>
      <h2 class="text-4xl font-bold leading-none text-zinc-900 sm:text-5xl dark:text-zinc-100">{title}</h2>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        items.map((item, index) => (
          <article class="group relative overflow-hidden rounded-2xl border border-zinc-300 bg-white shadow-sm transition-colors duration-300 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:hover:bg-zinc-800/80">
            <span class="absolute inset-x-0 top-0 h-1 bg-rose-600" aria-hidden="true"></span>
            <span class="pointer-events-none absolute right-4 top-3 text-6xl font-bold leading-none tracking-[-0.06em] text-zinc-200 transition-colors duration-300 group-hover:text-zinc-300 dark:text-zinc-700 dark:group-hover:text-zinc-600" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="relative flex h-full flex-col p-6">
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-zinc-400 dark:text-zinc-500">Module</p>
              <h3 class="mb-3 text-2xl font-bold leading-tight text-zinc-900 dark:text-zinc-100">{item.title}</h3>
              <p class="mb-5 text-zinc-700 dark:text-zinc-300">{item.description}</p>

              {
                item.pageLink && (
                  <a
                    href={item.pageLink}
                    class="mb-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-zinc-500 transition-colors duration-300 hover:text-rose-500 group-hover:text-rose-500 dark:text-zinc-400 dark:hover:text-rose-500 dark:group-hover:text-rose-500"
                  >
                    Read Briefing
                     <Icon
                    name="mdi:arrow-right"
                    size="1.2em"
                    class="text-zinc-500 transition-colors duration-300 group-hover:text-rose-500 dark:text-zinc-400 dark:group-hover:text-rose-500"
                  />
                  </a>
                )
              }

              <div class="relative mt-auto overflow-hidden rounded-xl border border-zinc-200 dark:border-zinc-700">
                <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-16 bg-linear-to-t from-zinc-950/45 to-transparent"></div>
                <Image
                  src={item.image}
                  alt={item.imageAlt || item.title}
                  class="h-52 w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  widths={[640, 960, 1280]}
                  sizes="(max-width: 768px) 100vw, 50vw"
                  width={800}
                  height={400}
                />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
