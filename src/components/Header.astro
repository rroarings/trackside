---
import HeaderLink from "./HeaderLink.astro"
import { SITE_TITLE } from "../consts"
import { Icon } from "astro-icon/components"
import { Image } from "astro:assets"
import tracksideLogo from "/src/assets/logos/trackside-logoblack.png"
import tracksideLogoWhite from "/src/assets/logos/trackside-logowhite.png"
---

<header class="sticky top-0 z-50 bg-white dark:bg-slate-900 shadow-sm py-2">
	<nav class="container mx-auto px-4">
		<div class="flex items-center justify-between h-16">
			<!-- Logo -->
			<div class="flex-shrink-0">
				<a
					href="/"
					class="text-xl font-bold">
					<Image
						src={tracksideLogo}
						alt="Trackside Logo"
						class="size-48 block dark:hidden"
					/>
					<Image
						src={tracksideLogoWhite}
						alt="Trackside Logo (White)"
						class="size-48 hidden dark:block"
					/>
				</a>
			</div>

			<!-- Desktop Navigation -->
			<div class="hidden md:flex md:items-center md:space-x-4">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>

				<!-- Seasons Dropdown -->
				<div class="relative group">
					<HeaderLink
						href="/seasons"
						class="inline-flex items-center">
						<span>Seasons</span>
						<Icon
							name="mdi:chevron-down"
							size={16}
							class="ml-1"
						/>
					</HeaderLink>
					<div class="hidden group-hover:block absolute left-0 top-full pt-2 w-48">
						<div
							class="bg-white border dark:bg-slate-800 dark:border-slate-600 border-gray-200 rounded-md shadow-lg">
							<a
								href="/seasons/2025"
								class="block px-4 py-2 dark:text-slate-300 dark:hover:bg-slate-600 hover:bg-gray-200"
								>2025 Season</a
							>
							<a
								href="/seasons/2024"
								class="block px-4 py-2 dark:text-slate-300 dark:hover:bg-slate-600 hover:bg-gray-200"
								>2024 Season</a
							>
						</div>
					</div>
				</div>

				<!-- Learn Dropdown -->
				<div class="relative group">
					<HeaderLink
						href="/about/whatis"
						class="inline-flex items-center">
						<span>Learn</span>
						<Icon
							name="mdi:chevron-down"
							size={16}
							class="ml-1"
						/>
					</HeaderLink>
					<div class="hidden group-hover:block absolute left-0 top-full pt-2 w-48">
						<div
							class="bg-white border dark:bg-slate-800 border-gray-200 dark:border-slate-600 rounded-md shadow-lg">
							<a
								href="/about/whatis"
								class="block px-4 py-2 dark:text-slate-300 dark:hover:bg-slate-600 hover:bg-gray-200"
								>What is F1</a
							>
							<a
								href="/about/technologies"
								class="block px-4 py-2 dark:text-slate-300 dark:hover:bg-slate-600 hover:bg-gray-200"
								>Technology of F1</a
							>
							<a
								href="/about/future"
								class="block px-4 py-2 dark:text-slate-300 dark:hover:bg-slate-600 hover:bg-gray-200"
								>Future of F1</a
							>
						</div>
					</div>
				</div>

				<!-- More Dropdown -->
				<div class="relative group">
					<HeaderLink
						href="/about/more"
						class="inline-flex items-center">
						<span>More</span>
						<Icon
							name="mdi:chevron-down"
							size={16}
							class="ml-1"
						/>
					</HeaderLink>
					<div class="hidden group-hover:block absolute right-0 top-full pt-2 w-48">
						<div
							class="bg-white border dark:bg-slate-800 border-gray-200 dark:border-slate-600 rounded-md shadow-lg">
							<a
								href="/about"
								class="block px-4 py-2 dark:text-slate-300 dark:hover:bg-slate-600 hover:bg-gray-200"
								>About</a
							>
							<a
								href="/attributions"
								class="block px-4 py-2 dark:text-slate-300 dark:hover:bg-slate-600 hover:bg-gray-200"
								>Attributions</a
							>
							<a
								href="/contact"
								class="block px-4 py-2 dark:text-slate-300 dark:hover:bg-slate-600 hover:bg-gray-200"
								>Contact</a
							>
							<a
								href="/faqs"
								class="block px-4 py-2 dark:text-slate-300 dark:hover:bg-slate-600 hover:bg-gray-200"
								>FAQs</a
							>
							
						</div>
					</div>
				</div>
			</div>

			<!-- Mobile Navigation Button -->
			<div class="md:hidden">
				<button
					type="button"
					class="mobile-menu-button inline-flex items-center justify-center p-2 rounded-md text-gray-700 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-500">
					<span class="sr-only">Open main menu</span>
					<Icon
						name="mdi:menu"
						size={24}
						aria-hidden="true"
					/>
				</button>
			</div>
		</div>

		<!-- Mobile Menu -->
		<div class="hidden md:hidden mobile-menu">
			<div class="px-2 pt-2 pb-3 space-y-1">
				<a
					href="/"
					class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50"
					>Home</a
				>
				<a
					href="/blog"
					class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50"
					>Blog</a
				>

				<!-- Mobile Seasons Section -->
				<div class="mobile-dropdown">
					<button
						class="w-full text-left px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50 flex justify-between items-center">
						Seasons
						<Icon
							name="mdi:chevron-down"
							size={16}
							class="transform transition-transform"
						/>
					</button>
					<div class="hidden pl-4">
						<a
							href="/seasons/2025"
							class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-200"
							>2025 Season</a
						>
						<a
							href="/seasons/2024"
							class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-200"
							>2024 Season</a
						>
					</div>
				</div>

				<!-- Mobile Learn Section -->
				<div class="mobile-dropdown">
					<button
						class="w-full text-left px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50 flex justify-between items-center">
						Learn
						<Icon
							name="mdi:chevron-down"
							size={16}
							class="transform transition-transform"
						/>
					</button>
					<div class="hidden pl-4">
						<a
							href="/about/whatis"
							class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-200"
							>What is F1</a
						>
						<a
							href="/about/technologies"
							class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-200"
							>Technology</a
						>
						<a
							href="/about/future"
							class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-200"
							>Future of F1</a
						>
					</div>
				</div>

				<a
					href="/about"
					class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50"
					>About</a
				>
				<a
					href="/contact"
					class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50"
					>Contact</a
				>
				<a
					href="/components"
					class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50"
					>Components</a
				>
			</div>
		</div>
	</nav>
</header>

<script>
	// Add this script for mobile menu functionality
	document.addEventListener("DOMContentLoaded", () => {
		// Mobile menu toggle
		const mobileMenuButton = document.querySelector(".mobile-menu-button")
		const mobileMenu = document.querySelector(".mobile-menu")

		mobileMenuButton?.addEventListener("click", () => {
			mobileMenu?.classList.toggle("hidden")
		})

		// Mobile dropdowns
		const mobileDropdowns = document.querySelectorAll(".mobile-dropdown")
		mobileDropdowns.forEach((dropdown) => {
			const button = dropdown.querySelector("button")
			const content = dropdown.querySelector("div")
			const arrow = button?.querySelector("svg")

			button?.addEventListener("click", () => {
				content?.classList.toggle("hidden")
				arrow?.classList.toggle("rotate-180")
			})
		})
	})
</script>

<style>
	/* Remove most existing styles as we're using Tailwind classes */
	.social-links {
		display: none;
	}

	@media (min-width: 768px) {
		.social-links {
			display: flex;
		}
	}
</style>
