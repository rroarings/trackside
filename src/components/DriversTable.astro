---
import type { CollectionEntry } from "astro:content";
import DataTable, { type TableColumn, type TableRow } from "./DataTable.astro";
import { buildSeasonEntityPath } from "../utils/slugUtils";

type DriverEntry = CollectionEntry<"drivers">;

interface Props {
  drivers: DriverEntry[];
}

const { drivers } = Astro.props;

// Transform driver entries into table row format
interface DriverRow extends TableRow {
  entry: DriverEntry;
  position: number | string;
  name: string;
  team: string;
  points: number;
}

const rows: DriverRow[] = drivers.map((driver) => ({
  entry: driver,
  position: driver.data.championshipPosition ?? "-",
  name:
    `${driver.data.driverFirstName ?? ""} ${driver.data.driverLastName ?? ""}`.trim() ||
    "Unknown driver",
  team: driver.data.driverTeam ?? "N/A",
  points: driver.data.driverPoints ?? 0,
}));

const columns: TableColumn<DriverRow>[] = [
  {
    header: "Pos",
    accessor: "position",
    headerClass: "w-16 px-4 py-3 text-left",
  },
  {
    header: "Driver",
    accessor: "name",
    headerClass: "w-1/3 px-4 py-3 text-left",
    isLink: true,
    getHref: (row) => buildSeasonEntityPath(row.entry, "drivers"),
    getAriaLabel: (row) => `View profile for ${row.name}`,
  },
  {
    header: "Team",
    accessor: "team",
    headerClass: "w-1/3 px-4 py-3 text-left",
  },
  {
    header: "Points",
    accessor: "points",
    headerClass: "px-4 py-3 text-right",
    cellClass: "px-4 py-3 text-right",
  },
];
---

<DataTable rows={rows} columns={columns} caption="Driver standings" />
