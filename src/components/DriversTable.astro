---
interface Props {
  drivers: any[];
}
const { drivers } = Astro.props;
---

<table class="w-full dark:text-slate-200">
  <thead>
    <tr class="border-b dark:border-slate-400">
      <th class="w-16 py-2">Pos</th>
      <th class="w-1/3 py-2">Driver</th>
      <th class="w-1/3 py-2">Team</th>
      <th class="py-2 text-right">Points</th>
    </tr>
  </thead>
  <tbody>
    {
      drivers.map((driver) => (
        <tr class="border-b border-gray-300 dark:border-slate-500">
          <td class="py-3">{driver.data.championshipPosition}</td>
          <td class="py-3">
            {driver.data.driverFirstName} {driver.data.driverLastName}
          </td>
          <td class="py-3">{driver.data.driverTeam}</td>
          <td class="py-3 text-right">{driver.data.driverPoints}</td>
        </tr>
      ))
    }
  </tbody>
</table>
