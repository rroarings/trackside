---
/**
 * Generic data table component for displaying standings data
 * Used by DriversTable and ConstructorsTable components
 */

// eslint-disable-next-line @typescript-eslint/no-explicit-any
export interface TableColumn<T = any> {
  /** Header text for the column */
  header: string;
  /** Key to access the value from row data, or a function to compute it */
  accessor: keyof T | ((row: T) => string | number);
  /** Optional CSS class for the header cell */
  headerClass?: string;
  /** Optional CSS class for the data cell */
  cellClass?: string;
  /** Whether this column should be a link */
  isLink?: boolean;
  /** Function to generate the href for link columns */
  getHref?: (row: T) => string;
  /** Function to generate aria-label for link columns */
  getAriaLabel?: (row: T) => string;
}

export interface TableRow {
  [key: string]: unknown;
}

interface Props {
  /** Array of data rows to display */
  rows: TableRow[];
  /** Column definitions - using any to allow generic column types */
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  columns: TableColumn<any>[];
  /** Optional table caption for accessibility */
  caption?: string;
}

const { rows, columns, caption } = Astro.props;

function getValue(
  row: TableRow,
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  accessor: string | ((row: any) => string | number),
): string | number {
  if (typeof accessor === "function") {
    return accessor(row);
  }
  const value = row[accessor];
  return value !== undefined && value !== null ? String(value) : "";
}
---

<table
  class="w-full overflow-hidden rounded-2xl border border-zinc-300 bg-white text-zinc-800 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200"
>
  {caption && <caption class="sr-only">{caption}</caption>}
  <thead>
    <tr
      class="border-b border-zinc-300 bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-950"
    >
      {
        columns.map((col: TableColumn) => (
          <th
            class={`${col.headerClass || "px-6 py-4 text-left"} text-xs font-semibold uppercase tracking-[0.22em] text-zinc-500 dark:text-zinc-400`}
          >
            {col.header}
          </th>
        ))
      }
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row: TableRow) => (
        <tr class="border-b border-zinc-200 text-base transition-colors duration-200 hover:bg-zinc-100 dark:border-zinc-800 dark:hover:bg-zinc-800/70">
          {columns.map((col: TableColumn) => {
            const value = getValue(
              row,
              col.accessor as string | ((row: TableRow) => string | number),
            );
            const cellClass = col.cellClass || "px-6 py-4";
            const isPositionColumn = col.accessor === "position";
            const isPointsColumn = col.accessor === "points";

            if (col.isLink && col.getHref) {
              const href = col.getHref(row);
              const ariaLabel = col.getAriaLabel?.(row) || String(value);
              return (
                <td class={cellClass}>
                  <a
                    href={href}
                    aria-label={ariaLabel}
                    class="block w-full font-semibold text-zinc-900 transition-colors duration-200 hover:text-rose-600 focus:outline-none focus:ring-2 focus:ring-rose-400 dark:text-zinc-100 dark:hover:text-rose-400"
                  >
                    {value || "Unknown"}
                  </a>
                </td>
              );
            }

            return (
              <td
                class={`${cellClass} ${isPointsColumn ? "font-semibold text-zinc-700 dark:text-zinc-300" : "text-zinc-700 dark:text-zinc-300"}`}
              >
                {isPositionColumn ? (
                  <span class="inline-flex min-w-9 items-center justify-center rounded-full border border-zinc-300 bg-zinc-100 px-2 py-1 text-sm font-bold text-zinc-900 dark:border-zinc-600 dark:bg-zinc-800 dark:text-zinc-100">
                    {value}
                  </span>
                ) : (
                  value
                )}
              </td>
            );
          })}
        </tr>
      ))
    }
  </tbody>
</table>
