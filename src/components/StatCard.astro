---
interface Props {
  value?: number | string;
  label: string;
}
const { value = "-", label } = Astro.props;
---

<div class="group h-full rounded-lg bg-gray-300/50 dark:bg-gray-800">
  <div class="flex flex-col flex-wrap items-center justify-center p-4">
    <div class="mb-2 text-4xl font-bold dark:text-gray-200">{value}</div>
    <div
      class="text-center text-sm tracking-wide text-gray-800 dark:text-gray-400"
    >
      {label}
    </div>
  </div>
</div>
