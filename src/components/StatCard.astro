---
interface Props {
  value?: number | string;
  label: string;
}
const { value = "-", label } = Astro.props;
---

<div class="group h-full min-h-28 rounded-lg bg-gray-300/50 dark:bg-gray-800">
  <div class="flex h-full w-full flex-col items-center justify-center p-4">
    <div class="mb-2 text-4xl font-bold dark:text-gray-200">{value}</div>
    <div class="text-center text-sm tracking-wide text-gray-800 dark:text-gray-300">{label}</div>
  </div>
</div>
