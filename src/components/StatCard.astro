---
interface Props {
  value?: number | string;
  label: string;
}
const { value = "-", label } = Astro.props;
---

<div class="group h-full min-h-28 rounded-lg bg-zinc-300/50 dark:bg-zinc-800">
  <div class="flex h-full w-full flex-col items-center justify-center p-4">
    <div class="mb-2 text-4xl font-bold dark:text-zinc-200">{value}</div>
    <div
      class="text-center text-sm tracking-wide text-zinc-800 dark:text-zinc-300"
    >
      {label}
    </div>
  </div>
</div>
