---
interface Props {
  value?: number | string;
  label: string;
}
const { value = "-", label } = Astro.props;
---

<div class="group h-full rounded-lg bg-slate-200 dark:bg-slate-800">
  <div class="flex flex-col flex-wrap items-center justify-center p-4">
    <div class="mb-2 text-4xl font-bold dark:text-slate-200">{value}</div>
    <div
      class="text-center text-sm tracking-wide text-slate-600 transition-colors duration-300 dark:text-slate-400"
    >
      {label}
    </div>
  </div>
</div>
