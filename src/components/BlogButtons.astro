---
const buttonClass =
  "inline-block border-2 border-transparent transition-colors duration-300 py-2 px-4 rounded text-white";
const backBlogClass = `${buttonClass} bg-rose-600 border-rose-400 dark:border-rose-500 dark:hover:bg-rose-800 dark:hover:border-rose-600 hover:bg-rose-700`;
const backHomeClass = `${buttonClass} bg-slate-600 dark:border-slate-500 dark:hover:bg-slate-800 hover:bg-slate-700`;
---

<section class="text-center space-x-2 py-8">
  <a href={`/blog`} class={backBlogClass}> Back to Blog </a>
  <a href="/" class={backHomeClass}>Back to Home </a>
</section>
