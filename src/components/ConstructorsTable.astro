---
import type { CollectionEntry } from "astro:content"

type ConstructorEntry = CollectionEntry<"constructors">

interface Props {
	teams: ConstructorEntry[]
}

const { teams } = Astro.props as Props
---

<table class="w-full border border-slate-300 dark:text-slate-200">
	<thead>
		<tr class="border-b dark:border-slate-400">
			<th class="w-16 px-4 py-3">Pos</th>
			<th class="w-1/3 px-4 py-3">Team</th>
			<th class="w-1/3 px-4 py-3">Drivers</th>
			<th class="px-4 py-3 text-right">Points</th>
		</tr>
	</thead>
	<tbody>
		{
			teams.map((team) => {
				const rawId = (team && (team as any).id) || ""
				const teamSlug = String(rawId).replace(/\/+$/, "").split("/").pop() || ""
				const year = (team.data && team.data.season) || "2025"
				const href = `/seasons/${year}/constructors/${teamSlug}`

				const position = team.data?.championshipPosition ?? "-"
				const name = team.data?.constructorName ?? "Unknown Team"
				const drivers =
					team.data?.teamDrivers && Array.isArray(team.data.teamDrivers) ?
						team.data.teamDrivers.join(", ")
					:	(team.data?.teamDrivers ?? "N/A")
				const points = team.data?.constructorPoints ?? 0

				return (
					<tr class="border-b border-slate-300 transition-colors duration-150 hover:bg-slate-300 dark:border-slate-500 dark:hover:bg-slate-800">
						<td class="px-4 py-3">{position}</td>
						<td class="px-4 py-3">
							<a
								href={href}
								aria-label={`View constructor ${name}`}
								class="block w-full focus:outline-none focus:ring-2 focus:ring-rose-400">
								{name}
							</a>
						</td>
						<td class="px-4 py-3">{drivers}</td>
						<td class="px-4 py-3 text-right">{points}</td>
					</tr>
				)
			})
		}
	</tbody>
</table>
