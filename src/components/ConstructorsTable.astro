---
import type { CollectionEntry } from "astro:content";
import DataTable, { type TableColumn, type TableRow } from "./DataTable.astro";
import { buildSeasonEntityPath } from "../utils/slugUtils";

type ConstructorEntry = CollectionEntry<"constructors">;

interface Props {
  teams: ConstructorEntry[];
}

const { teams } = Astro.props;

// Transform constructor entries into table row format
interface ConstructorRow extends TableRow {
  entry: ConstructorEntry;
  position: number | string;
  name: string;
  drivers: string;
  points: number;
}

const rows: ConstructorRow[] = teams.map((team) => ({
  entry: team,
  position: team.data.championshipPosition ?? "-",
  name: team.data.constructorName ?? "Unknown Team",
  drivers:
    team.data.teamDrivers && Array.isArray(team.data.teamDrivers)
      ? team.data.teamDrivers.join(", ")
      : "N/A",
  points: team.data.constructorPoints ?? 0,
}));

const columns: TableColumn<ConstructorRow>[] = [
  {
    header: "Pos",
    accessor: "position",
    headerClass: "w-16 px-4 py-3 text-left",
  },
  {
    header: "Team",
    accessor: "name",
    headerClass: "w-1/3 px-4 py-3 text-left",
    isLink: true,
    getHref: (row) => buildSeasonEntityPath(row.entry, "constructors"),
    getAriaLabel: (row) => `View constructor ${row.name}`,
  },
  {
    header: "Drivers",
    accessor: "drivers",
    headerClass: "w-1/3 px-4 py-3 text-left",
  },
  {
    header: "Points",
    accessor: "points",
    headerClass: "px-4 py-3 text-right",
    cellClass: "px-4 py-3 text-right",
  },
];
---

<DataTable rows={rows} columns={columns} caption="Constructor standings" />
