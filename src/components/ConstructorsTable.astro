---
interface Props {
  teams: any[];
}
const { teams } = Astro.props;
---

<table class="w-full text-left dark:text-slate-200">
  <thead>
    <tr class="border-b">
      <th class="w-16 py-2">Pos</th>
      <th class="w-1/3 py-2">Team</th>
      <th class="w-1/3 py-2">Drivers</th>
      <th class="py-2 text-right">Points</th>
    </tr>
  </thead>
  <tbody>
    {
      teams.map((team) => (
        <tr class="border-b border-slate-300">
          <td class="py-3">{team.data.championshipPosition}</td>
          <td class="py-3">{team.data.constructorName}</td>
          <td class="py-3">{team.data.teamDrivers.join(", ")}</td>
          <td class="py-3 text-right">{team.data.constructorPoints}</td>
        </tr>
      ))
    }
  </tbody>
</table>
