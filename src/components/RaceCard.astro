---
import { type CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import { Image } from "astro:assets";

interface Props {
  race: CollectionEntry<"races">;
  completedRaces?: CollectionEntry<"races">[];
  isNextRace?: boolean;
  loading?: "eager" | "lazy";
}

const { race, completedRaces = [], isNextRace, loading = "lazy" } = Astro.props;

const parts = race.id.split("/");
const raceSlug = parts[parts.length - 1].replace(/\.(md|mdx)$/, "");

const toUTCMidnight = (date: Date) => {
  const d = new Date(date);
  d.setUTCHours(0, 0, 0, 0);
  return d;
};

const nowUTC = toUTCMidnight(new Date());
const raceDateUTC = toUTCMidnight(new Date(race.data.raceDate));
const sevenDaysFromNowUTC = new Date(nowUTC);
sevenDaysFromNowUTC.setDate(nowUTC.getDate() + 7);

const lastCompletedRaceDate =
  completedRaces.length > 0
    ? Math.max(
        ...completedRaces.map((r) =>
          toUTCMidnight(new Date(r.data.raceDate)).getTime(),
        ),
      )
    : 0;
// Only mark as previous race if in current season
const currentSeason = new Date().getFullYear().toString();
const isCurrentSeason = race.data.season === currentSeason;
const isPreviousRace =
  isCurrentSeason &&
  race.data.raceCompleted &&
  raceDateUTC.getTime() === lastCompletedRaceDate;

const getStatusLabel = () => {
  if (isNextRace) {
    return {
      label: "Next",
      class: "bg-red-500 text-white motion-safe:animate-pulse",
    };
  }
  if (isPreviousRace) {
    return { label: "Previous", class: "bg-blue-500 text-white" };
  }
  if (race.data.raceCompleted) {
    return { label: "Completed", class: "bg-green-600 text-white" };
  }
  return { label: "Upcoming", class: "bg-amber-500 text-white" };
};

const { label: statusLabel, class: statusLabelClass } = getStatusLabel();
---

<a href={`/seasons/${race.data.season}/races/${raceSlug}`} class="block h-full">
  <div
    class:list={[
      "group h-full overflow-hidden rounded-lg border transition-shadow duration-200 hover:shadow-md",
      {
        "border-red-200 bg-red-200/30 dark:border-red-600 dark:bg-red-900":
          isNextRace,
        "border-blue-200 bg-blue-100/30 dark:border-blue-600 dark:bg-blue-900":
          isPreviousRace,
        "border-green-200 bg-green-100/30 dark:border-green-600 dark:bg-green-900":
          race.data.raceCompleted && !isPreviousRace,
        "border-amber-200 bg-amber-100/30 dark:border-amber-600 dark:bg-amber-900":
          !isNextRace && !isPreviousRace && !race.data.raceCompleted,
      },
    ]}
  >
    {
      race.data.trackImage && (
        <Image
          src={race.data.trackImage}
          alt={race.data.trackImageAlt ?? `${race.data.trackName} circuit`}
          class="h-48 w-full object-cover"
          loading={loading}
        />
      )
    }
    <div class="flex items-center justify-between p-4">
      {
        statusLabel && (
          <span
            class={`rounded-full px-3 py-1 text-sm tracking-wide transition-colors duration-200 ${statusLabelClass}`}
          >
            {statusLabel}
          </span>
        )
      }
      <span class="text-sm text-gray-700 dark:text-slate-200"
        >Round {race.data.raceNumber}</span
      >
    </div>

    <div class="p-6 pt-2">
      <h4 class="mb-1 dark:text-slate-100">
        {race.data.trackCountry}
      </h4>
      <p class="mb-2 uppercase text-sm group-hover:underline dark:text-slate-100">
        {race.data.raceName}
      </p>

      <dl
        class="mb-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm dark:text-slate-200"
      >
        <dt class="font-medium">Date:</dt>
        <dd><FormattedDate date={race.data.raceDate} /></dd>

        {
          race.data.raceCompleted && (
            <>
              <dt class="">Winner:</dt>
              <dd class="">
                <span>{race.data.winningDriver}</span>
              </dd>
            </>
          )
        }
      </dl>
    </div>
  </div>
</a>
