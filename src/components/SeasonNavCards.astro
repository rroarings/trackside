---
interface Props {
  season: "2024" | "2025";
}

const { season } = Astro.props;
---

<section class="bg-gray-100 py-12 dark:bg-slate-900">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:grid-rows-2">
      {/* Drivers Card */}
      <a href={`/seasons/${season}/drivers`} class="group block h-full">
        <div
          class="h-full rounded-lg border border-gray-200 p-6 dark:border-slate-700"
        >
          <div class="mb-4 flex items-center justify-between">
            <h3
              class="text-2xl font-bold transition-colors duration-300 dark:text-slate-100"
            >
              Drivers
            </h3>
            <span
              class="text-gray-500 transition-colors duration-300 dark:text-slate-400"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                class="h-6 w-6 transition-colors duration-300 xl:size-8"
                ><path
                  fill="currentColor"
                  d="M5 17.85q1.35-1.325 3.138-2.087T12 15t3.863.763T19 17.85V5H5zM12 13q1.45 0 2.475-1.025T15.5 9.5t-1.025-2.475T12 6T9.525 7.025T8.5 9.5t1.025 2.475T12 13m-7 8q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h14q.825 0 1.413.588T21 5v14q0 .825-.587 1.413T19 21zm1.725-2h10.55q-1.1-.975-2.488-1.487T12 17t-2.812.513T6.725 19M12 11q-.625 0-1.062-.437T10.5 9.5t.438-1.062T12 8t1.063.438T13.5 9.5t-.437 1.063T12 11m0 .425"
                ></path></svg
              ></span
            >
          </div>
          <p class="text-gray-600 dark:text-slate-400">
            View all Formula 1 drivers competing in the {season} championship season.
            Explore driver profiles, statistics, and current championship standings.
          </p>
        </div>
      </a>

      {/* Races Card */}
      <a href={`/seasons/${season}/constructors`} class="group block h-full">
        <div
          class="h-full rounded-lg border border-gray-200 p-6 dark:border-slate-700"
        >
          <div class="mb-4 flex items-center justify-between">
            <h3
              class="text-2xl font-bold transition-colors duration-300 dark:text-slate-100"
            >
              Constructors
            </h3>
            <span
              class="text-gray-500 transition-colors duration-300 dark:text-slate-400"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                class="h-6 w-6 transition-colors duration-300 xl:size-8"
                ><path
                  fill="currentColor"
                  d="M6 19v1q0 .425-.288.713T5 21H4q-.425 0-.712-.288T3 20v-8l2.1-6q.15-.45.538-.725T6.5 5h11q.475 0 .863.275T18.9 6l2.1 6v8q0 .425-.287.713T20 21h-1q-.425 0-.712-.288T18 20v-1zm-.2-9h12.4l-1.05-3H6.85zM5 12v5zm2.5 4q.625 0 1.063-.437T9 14.5t-.437-1.062T7.5 13t-1.062.438T6 14.5t.438 1.063T7.5 16m9 0q.625 0 1.063-.437T18 14.5t-.437-1.062T16.5 13t-1.062.438T15 14.5t.438 1.063T16.5 16M5 17h14v-5H5z"
                ></path></svg
              ></span
            >
          </div>
          <p class="text-gray-600 dark:text-slate-400">
            Discover the {season} Formula 1 constructor teams, their cars, and current
            standings. Learn about team principals, engines, and technical developments.
          </p>
        </div>
      </a>

      {/* Races Card */}
      <a
        href={`/seasons/${season}/races`}
        class="group block h-full md:col-span-2 md:row-start-2"
      >
        <div
          class="h-full rounded-lg border border-gray-200 p-6 dark:border-slate-700"
        >
          <div class="mb-4 flex items-center justify-between">
            <h3
              class="text-2xl font-bold transition-colors duration-300 dark:text-slate-100"
            >
              Races
            </h3>
            <span
              class="text-gray-500 transition-colors duration-300 dark:text-slate-400"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                class="h-6 w-6 transition-colors duration-300 xl:size-8"
                ><path
                  fill="currentColor"
                  d="M6 19v1q0 .425-.288.713T5 21H4q-.425 0-.712-.288T3 20v-8l2.1-6q.15-.45.538-.725T6.5 5h11q.475 0 .863.275T18.9 6l2.1 6v8q0 .425-.287.713T20 21h-1q-.425 0-.712-.288T18 20v-1zm-.2-9h12.4l-1.05-3H6.85zM5 12v5zm2.5 4q.625 0 1.063-.437T9 14.5t-.437-1.062T7.5 13t-1.062.438T6 14.5t.438 1.063T7.5 16m9 0q.625 0 1.063-.437T18 14.5t-.437-1.062T16.5 13t-1.062.438T15 14.5t.438 1.063T16.5 16M5 17h14v-5H5z"
                ></path></svg
              ></span
            >
          </div>
          <p class="text-gray-600 dark:text-slate-400">
            Discover the {season} Formula 1 constructor teams, their cars, and current
            standings. Learn about team principals, engines, and technical developments.
          </p>
        </div>
      </a>
    </div>
  </div>
</section>
