---
import { Icon } from "astro-icon/components";

interface Props {
  season: "2024" | "2025" | "2026";
}

const { season } = Astro.props;

const navCards = [
  {
    title: "Drivers",
    href: `/seasons/${season}/drivers`,
    icon: "mdi:racing-helmet",
    description: `View all Formula 1 drivers competing in the ${season} championship season. Explore driver profiles, statistics, and current championship standings.`,
    gridClass: "",
  },
  {
    title: "Constructors",
    href: `/seasons/${season}/constructors`,
    icon: "mdi:car-convertible",
    description: `Discover the ${season} Formula 1 constructor teams, their cars, and current standings. Learn about team principals, engines, and technical developments.`,
    gridClass: "",
  },
  {
    title: "Races",
    href: `/seasons/${season}/races`,
    icon: "mdi:calendar-month",
    description: `Explore the complete ${season} Formula 1 race calendar. View circuit details, race results, and upcoming Grand Prix events.`,
    gridClass: "md:col-span-2 md:row-start-2",
  },
];
---

<section class="bg-zinc-100 py-12 dark:bg-zinc-900">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:grid-rows-2">
      {
        navCards.map((card) => (
          <a
            href={card.href}
            class:list={["group block h-full", card.gridClass]}
          >
            <div class="h-full rounded-lg border border-zinc-200 p-6 transition-all duration-300 hover:border-zinc-400 hover:bg-zinc-200 dark:border-zinc-600 dark:bg-zinc-700 dark:hover:border-zinc-600 dark:hover:bg-zinc-800">
              <div class="mb-4 flex items-center justify-between">
                <h3 class="text-2xl font-bold transition-colors duration-300 dark:text-zinc-100">
                  {card.title}
                </h3>
                <Icon
                  name={card.icon}
                  aria-hidden="true"
                  class="size-10 shrink-0 text-zinc-600 transition-all duration-200 group-hover:text-sky-600 dark:text-zinc-300 dark:group-hover:text-sky-400"
                />
              </div>
              <p class="text-zinc-600 transition-colors duration-300 group-hover:text-zinc-800 dark:text-zinc-300 group-hover:dark:text-zinc-100">
                {card.description}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
