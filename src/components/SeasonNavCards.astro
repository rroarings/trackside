---
import { Icon } from "astro-icon/components";

interface Props {
  season: "2024" | "2025" | "2026";
}

const { season } = Astro.props;
---

<section class="bg-slate-100 py-12 dark:bg-slate-900">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:grid-rows-2">
      {/* Drivers Card */}
      <a href={`/seasons/${season}/drivers`} class="group block h-full">
        <div
          class="h-full rounded-lg border border-slate-200 p-6 transition-all duration-300 hover:border-slate-400 hover:bg-slate-200 dark:border-slate-600 dark:bg-slate-700 dark:hover:border-slate-600 dark:hover:bg-slate-800"
        >
          <div class="mb-4 flex items-center justify-between">
            <h3
              class="text-2xl font-bold transition-colors duration-300 dark:text-slate-100"
            >
              Drivers
            </h3>
            <span
              class="text-slate-500 transition-colors duration-300 dark:text-slate-300"
            >
              <Icon
                name="mdi:racing-helmet"
                aria-hidden="true"
                class="size-10 shrink-0 text-slate-400 transition-all duration-200 group-hover:text-sky-400"
              /></span
            >
          </div>
          <p
            class="group text-slate-600 transition-colors duration-300 group-hover:text-slate-800 dark:text-slate-300 group-hover:dark:text-slate-100"
          >
            View all Formula 1 drivers competing in the {season} championship season.
            Explore driver profiles, statistics, and current championship standings.
          </p>
        </div>
      </a>

      {/* Races Card */}
      <a href={`/seasons/${season}/constructors`} class="group block h-full">
        <div
          class="h-full rounded-lg border border-slate-200 p-6 transition-all duration-300 hover:border-slate-400 hover:bg-slate-200 dark:border-slate-600 dark:bg-slate-700 dark:hover:border-slate-600 dark:hover:bg-slate-800"
        >
          <div class="mb-4 flex items-center justify-between">
            <h3
              class="text-2xl font-bold transition-colors duration-300 dark:text-slate-100"
            >
              Constructors
            </h3>
            <span
              class="text-slate-500 transition-colors duration-300 dark:text-slate-300"
            >
              <Icon
                name="mdi:car-convertible"
                aria-hidden="true"
                class="size-10 shrink-0 text-slate-400 transition-all duration-200 group-hover:text-sky-400"
              /></span
            >
          </div>
          <p
            class="group text-slate-600 transition-colors duration-300 group-hover:text-slate-800 dark:text-slate-300 group-hover:dark:text-slate-100"
          >
            Discover the {season} Formula 1 constructor teams, their cars, and current
            standings. Learn about team principals, engines, and technical developments.
          </p>
        </div>
      </a>

      {/* Races Card */}
      <a
        href={`/seasons/${season}/races`}
        class="group block h-full md:col-span-2 md:row-start-2"
      >
        <div
          class="h-full rounded-lg border border-slate-200 p-6 transition-all duration-300 hover:border-slate-400 hover:bg-slate-200 dark:border-slate-600 dark:bg-slate-700 dark:hover:border-slate-600 dark:hover:bg-slate-800"
        >
          <div class="mb-4 flex items-center justify-between">
            <h3
              class="text-2xl font-bold transition-colors duration-300 dark:text-slate-100"
            >
              Races
            </h3>
            <span
              class="text-slate-500 transition-colors duration-300 dark:text-slate-300"
            >
              <Icon
                name="mdi:calendar-month"
                aria-hidden="true"
                class="size-10 shrink-0 text-slate-400 transition-all duration-200 group-hover:text-sky-400"
              /></span
            >
          </div>
          <p
            class="group text-slate-600 transition-colors duration-300 group-hover:text-slate-800 dark:text-slate-300 group-hover:dark:text-slate-100"
          >
            Discover the {season} Formula 1 constructor teams, their cars, and current
            standings. Learn about team principals, engines, and technical developments.
          </p>
        </div>
      </a>
    </div>
  </div>
</section>
