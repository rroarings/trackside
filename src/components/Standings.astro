---
import { getCollection } from "astro:content";
import { toUTCMidnight } from "../utils/dateUtils";
import RaceCard from "./RaceCard.astro";
import StandingsCard from "./StandingsCard.astro";
import TeamStandingsCards from "./TeamStandingsCards.astro";
import DriversTable from "./DriversTable.astro";
import ConstructorsTable from "./ConstructorsTable.astro";

interface Props {
  season: "2024" | "2025" | "2026";
  imageLoading?: "eager" | "lazy";
}

const { season, imageLoading = "lazy" } = Astro.props;

// Drivers
const drivers = await getCollection(
  "drivers",
  ({ data }) => data.season === season,
);
const sortedDrivers = drivers.sort(
  (a, b) => a.data.championshipPosition - b.data.championshipPosition,
);
const top5Drivers = sortedDrivers.slice(0, 5);

// Constructors (Teams)
const teams = await getCollection(
  "constructors",
  ({ data }) => data.season === season,
);
const sortedTeams = teams.sort(
  (a, b) => a.data.championshipPosition - b.data.championshipPosition,
);
const top5Teams = sortedTeams.slice(0, 5);

// Last Race
const races = await getCollection(
  "races",
  ({ data }) => data.season === season,
);
const nowUTC = toUTCMidnight(new Date());
const completedRaces = races
  .filter(
    (race) =>
      race.data.raceCompleted ||
      toUTCMidnight(new Date(race.data.raceDate)) < nowUTC,
  )
  .sort(
    (a, b) =>
      new Date(b.data.raceDate).getTime() - new Date(a.data.raceDate).getTime(),
  );

const lastRace = completedRaces.length > 0 ? completedRaces[0] : null;

// Unique IDs for tabs
const driversTabId = `drivers-tab-${season}`;
const constructorsTabId = `constructors-tab-${season}`;
const lastRaceTabId = `last-race-tab-${season}`;
---

<div
  class="standings-component mx-auto w-full max-w-6xl overflow-hidden rounded-2xl border border-zinc-300 bg-white shadow-sm dark:border-zinc-700 dark:bg-zinc-900"
>
  <!-- Hidden radio buttons for state management -->
  <input
    type="radio"
    name="standings-tab-{season}"
    id={driversTabId}
    class="hidden"
    checked
  />
  <input
    type="radio"
    name="standings-tab-{season}"
    id={constructorsTabId}
    class="hidden"
  />
  {
    lastRace && (
      <input
        type="radio"
        name="standings-tab-{season}"
        id={lastRaceTabId}
        class="hidden"
      />
    )
  }

  <!-- Tabs -->
  <div
    class="tab-list flex flex-wrap gap-2 border-b border-zinc-300 bg-zinc-100 p-3 dark:border-zinc-700 dark:bg-zinc-950"
  >
    <label
      for={driversTabId}
      class="tab-button drivers-label cursor-pointer rounded-full px-5 py-2.5 text-sm font-semibold uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-300"
      >Drivers</label
    >
    <label
      for={constructorsTabId}
      class="tab-button constructors-label cursor-pointer rounded-full px-5 py-2.5 text-sm font-semibold uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-300"
      >Constructors</label
    >
    {
      lastRace && (
        <label
          for={lastRaceTabId}
          class="tab-button last-race-label cursor-pointer rounded-full px-5 py-2.5 text-sm font-semibold uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-300"
        >
          Last Race
        </label>
      )
    }
  </div>

  <!-- Tab Content -->
  <div class="p-6 sm:p-8">
    <!-- Drivers Table -->
    <div class="tab-content drivers-content">
      <StandingsCard
        season={season}
        imageLoading={imageLoading}
        sortedDrivers={sortedDrivers}
      />
      <DriversTable drivers={top5Drivers} />
      <div class="mt-10 text-center">
        <a
          href={`/seasons/${season}/drivers`}
          class="inline-flex items-center gap-2 rounded border-2 border-rose-500 bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition-colors duration-300 hover:bg-rose-700 dark:bg-rose-700 dark:hover:bg-rose-800"
          >View All Drivers</a
        >
      </div>
    </div>

    <!-- Constructors Table -->
    <div class="tab-content constructors-content">
      <TeamStandingsCards season={season} sortedTeams={sortedTeams} />
      <ConstructorsTable teams={top5Teams} />
      <div class="mt-10 text-center">
        <a
          href={`/seasons/${season}/constructors`}
          class="inline-flex items-center gap-2 rounded border-2 border-rose-500 bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition-colors duration-300 hover:bg-rose-700 dark:bg-rose-700 dark:hover:bg-rose-800"
          >View All Constructors</a
        >
      </div>
    </div>

    <!-- Last Race -->
    {
      lastRace && (
        <div class="tab-content last-race-content">
          <RaceCard race={lastRace} />
        </div>
      )
    }
  </div>
</div>

<style>
  .tab-content {
    display: none;
  }
  .tab-button {
    border: 1px solid transparent;
    transition:
      color 0.2s ease-in-out,
      background-color 0.2s ease-in-out,
      border-color 0.2s ease-in-out,
      box-shadow 0.2s ease-in-out;
  }
  .standings-component input[id^="drivers-tab"]:checked ~ .p-6 .drivers-content,
  .standings-component
    input[id^="constructors-tab"]:checked
    ~ .p-6
    .constructors-content,
  .standings-component
    input[id^="last-race-tab"]:checked
    ~ .p-6
    .last-race-content {
    display: block;
  }
  .standings-component
    input[id^="drivers-tab"]:checked
    ~ .tab-list
    .drivers-label,
  .standings-component
    input[id^="constructors-tab"]:checked
    ~ .tab-list
    .constructors-label,
  .standings-component
    input[id^="last-race-tab"]:checked
    ~ .tab-list
    .last-race-label {
    font-weight: 600;
    color: #fff;
    background: linear-gradient(90deg, #e11d48 0%, #be123c 100%);
    border-color: rgba(225, 29, 72, 0.65);
    box-shadow: 0 10px 24px rgba(225, 29, 72, 0.22);
  }
  .tab-button:hover {
    color: #18181b;
    background-color: rgba(244, 244, 245, 0.9);
    border-color: rgba(212, 212, 216, 0.9);
  }
  .dark .tab-button:hover {
    color: #fff;
    background-color: rgba(39, 39, 42, 0.95);
    border-color: rgba(63, 63, 70, 1);
  }
</style>
