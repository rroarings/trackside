---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  content?: string;
  description?: string;
  ctaText?: string;
  ctaLink?: string;
  imageSrc?: ImageMetadata;
  imageAlt?: string;
  reversed?: boolean;
  background?: "white" | "zinc";
  imageLoading?: "eager" | "lazy";
}

const {
  title,
  content,
  description,
  ctaText,
  ctaLink,
  imageSrc,
  imageAlt = "",
  reversed = false,
  imageLoading = "lazy",
} = Astro.props;
---

<section class="overflow-x-hidden bg-zinc-100 py-12 dark:bg-zinc-900">
  <div class="mx-auto max-w-7xl px-4">
    <div
      class={`w-full flex flex-col md:flex-row lg:flex-row gap-8 items-center md:items-start ${reversed ? "md:flex-row-reverse lg:flex-row-reverse" : ""}`}
    >
      <!-- Text Content -->
      <div class={`flex-1 md:w-1/2 min-w-0 w-full space-y-6 `}>
        <h2 class="font-bold dark:text-zinc-100">{title}</h2>
        {
          content ? (
            <div
              class="leading-loose text-zinc-800 dark:text-zinc-300"
              set:html={content}
            />
          ) : description ? (
            <p class="text-zinc-600 dark:text-zinc-300">{description}</p>
          ) : null
        }
        {
          ctaText && ctaLink && (
            <a
              href={ctaLink}
              class="inline-flex items-center rounded border-2 border-transparent bg-zinc-600 px-4 py-2 text-white transition-all duration-300 hover:bg-zinc-700 dark:bg-zinc-700 dark:hover:border-zinc-600 dark:hover:bg-zinc-800"
            >
              <span>{ctaText}</span>
              <Icon
                name="mdi:chevron-right"
                aria-hidden="true"
                class="h-6 w-6 shrink-0 text-zinc-50 transition-all duration-200"
              />
            </a>
          )
        }
      </div>

      <!-- Image -->
      <div class={`flex-1 md:flex-none md:w-1/2 min-w-0 w-full space-y-6 `}>
        {
          imageSrc ? (
            <Image
              src={imageSrc}
              alt={imageAlt}
              widths={[640, 960, 1344]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 672px"
              class="h-64 w-full max-w-2xl rounded-lg object-cover md:h-80 lg:h-96"
              loading={imageLoading}
            />
          ) : (
            <div class="flex h-96 w-full max-w-2xl items-center justify-center rounded-3xl border-4 border-white bg-zinc-200 dark:border-zinc-900">
              <span class="text-lg text-zinc-400">[Placeholder Image]</span>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
