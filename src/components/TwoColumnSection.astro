---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  content?: string;
  description?: string;
  ctaText?: string;
  ctaLink?: string;
  imageSrc?: ImageMetadata;
  imageAlt?: string;
  reversed?: boolean;
  background?: "white" | "gray";
  imageLoading?: "eager" | "lazy";
}

const {
  title,
  content,
  description,
  ctaText,
  ctaLink,
  imageSrc,
  imageAlt = "",
  reversed = false,
  imageLoading = "lazy",
} = Astro.props;
---

<section class="bg-gray-100 py-12 dark:bg-slate-950">
  <div class="container mx-auto">
    <div
      class={`flex flex-col lg:flex-row gap-8 items-center ${reversed ? "lg:flex-row-reverse" : ""}`}
    >
      <!-- Text Content -->
      <div class={`flex-1 space-y-6 `}>
        <h2 class="font-bold dark:text-slate-100">{title}</h2>
        {
          content ? (
            <div
              class="prose prose-lg max-w-none text-gray-800 dark:text-slate-400"
              set:html={content}
            />
          ) : description ? (
            <p class="text-gray-600 dark:text-slate-400">{description}</p>
          ) : null
        }
        {
          ctaText && ctaLink && (
            <a
              href={ctaLink}
              class="inline-flex items-center rounded border border-gray-800 px-6 py-2 text-gray-800 transition-all duration-300 hover:bg-gray-200 hover:text-red-600 hover:underline dark:text-slate-300 dark:hover:text-sky-500"
            >
              <span>{ctaText}</span>
              <svg
                class="ml-2 h-5 w-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </a>
          )
        }
      </div>

      <!-- Image -->
      <div class={`flex-1 space-y-6 `}>
        {
          imageSrc ? (
            <Image
              src={imageSrc}
              alt={imageAlt}
              class="h-100 w-full max-w-2xl rounded-lg object-cover"
              loading={imageLoading}
            />
          ) : (
            <div class="flex h-[400px] w-full max-w-2xl items-center justify-center rounded-3xl border-4 border-white bg-gray-200 dark:border-slate-900">
              <span class="text-lg text-gray-400">[Placeholder Image]</span>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
