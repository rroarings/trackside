---
import { Icon } from "astro-icon/components";

interface Feature {
  title: string;
  description: string;
  icon?: string;
  href?: string;
}

interface Props {
  title?: string;
  features: Feature[];
  columns?: 2 | 3 | 4;
  background?: "white" | "zinc";
}

const { title, features, columns = 2 } = Astro.props;

const gridCols = {
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-3",
  4: "sm:grid-cols-2 lg:grid-cols-4",
}[columns];
---

<style>
  @reference "../styles/global.css";
  @reference "tailwindcss";
  h3 {
    @apply m-0 text-xl tracking-tight dark:text-zinc-200;
  }

  @media (min-width: 768px) {
    h3 {
      @apply text-2xl;
    }
  }

  @media (min-width: 1024px) {
    h3 {
      @apply text-3xl;
    }
  }
</style>
<section class={`py-12 bg-zinc-100 dark:bg-zinc-900`}>
  <div class="mx-auto max-w-7xl px-4">
    {
      title && (
        <div class="mb-6 border-b border-zinc-200 pb-2">
          <h2 class="font-bold dark:text-zinc-100">{title}</h2>
        </div>
      )
    }

    <div class={`grid grid-cols-1 ${gridCols} gap-6`}>
      {
        features.map((feature) => {
          const Wrapper = feature.href ? "a" : "div";
          return (
            <Wrapper
              href={feature.href}
              class={`group flex items-start space-x-4 rounded-lg p-2 transition-colors duration-300 ${feature.href ? "" : ""}`}
            >
              <div class="shrink-0">
                <div class="group-hover:inset-shadow-sm group-hover:inset-shadow-zinc-400 flex size-12 items-center justify-center rounded-lg bg-zinc-900 text-white transition-all duration-300 dark:bg-zinc-700">
                  {feature.icon ? (
                    <Icon name={feature.icon} size="1.6em" />
                  ) : (
                    <Icon name="mdi:asterisk" size="1.6em" />
                  )}
                </div>
              </div>
              <div>
                <h3 class="dark:text-zinc-200">{feature.title}</h3>
                <p class="text-zinc-800 dark:text-zinc-300">
                  {feature.description}
                </p>
              </div>
            </Wrapper>
          );
        })
      }
    </div>
  </div>
</section>
