---
import { getCollection } from "astro:content";
import RaceCard from "./RaceCard.astro";
import { Icon } from "astro-icon/components";
import { toUTCMidnight } from "../utils/dateUtils";

interface Props {
  season: string;
  showAllRaces?: boolean;
  showTitle?: boolean;
  customClass?: string;
  eagerCount?: number;
}

const {
  season,
  showAllRaces = false,
  showTitle = true,
  customClass = "",
  eagerCount = 0,
} = Astro.props;

const races = await getCollection("races", ({ data }) => {
  return data.season === season;
});

const nowUTC = toUTCMidnight(new Date());

const sortedRaces = races.slice().sort((a, b) => {
  const aDate = toUTCMidnight(a.data.raceDate);
  const bDate = toUTCMidnight(b.data.raceDate);
  return aDate.getTime() - bDate.getTime();
});

const completedRaces = sortedRaces.filter((race) => {
  const raceDate = toUTCMidnight(race.data.raceDate);
  return race.data.raceCompleted || raceDate < nowUTC;
});
const upcomingRaces = sortedRaces.filter((race) => {
  const raceDate = toUTCMidnight(race.data.raceDate);
  return !race.data.raceCompleted && raceDate >= nowUTC;
});

const lastCompletedRace = [...completedRaces].reverse().find(Boolean);

const nextTwoRaces = upcomingRaces.slice(0, 2);

const racesToDisplay = showAllRaces
  ? sortedRaces
  : [...(lastCompletedRace ? [lastCompletedRace] : []), ...nextTwoRaces];

const nextUpcomingRace = sortedRaces.find(
  (race) =>
    !race.data.raceCompleted && toUTCMidnight(race.data.raceDate) >= nowUTC,
);
---

<div class={`bg-gray-100 dark:bg-slate-900 rounded ${customClass}`}>
  {
    showTitle && (
      <div class="mb-6 flex items-center justify-end">
        <Icon
          name="mdi:calendar-range-outline"
          class="mr-2 text-3xl text-gray-700 dark:text-slate-400"
        />

        {lastCompletedRace && (
          <a
            href={`/seasons/${season}/races`}
            class="font-medium text-gray-500 transition-colors duration-200 hover:text-red-600 dark:text-slate-400 dark:hover:text-slate-300"
          >
            View All Races
          </a>
        )}
      </div>
    )
  }
  <div class="mb-8 grid grid-cols-1 gap-6 lg:grid-cols-3 lg:gap-4">
    {
      racesToDisplay.map((race, index) => (
        <RaceCard
          race={race}
          completedRaces={completedRaces}
          isNextRace={nextUpcomingRace && race.id === nextUpcomingRace.id}
          loading={index < eagerCount ? "eager" : "lazy"}
        />
      ))
    }
  </div>
</div>
