---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { teamBgMap } from "../utils/teamBgMap";
import placeholderBG from "../assets/component/teamCard-placeholder.png";

interface Props {
  team: CollectionEntry<"constructors">;
  driverMap: Map<
    string,
    { profileImage: string; slug: string; countryCode: string }
  >;
  teamIndex: number;
  eagerCount?: number;
  year?: string;
}

const { team, driverMap, teamIndex, eagerCount = 4, year } = Astro.props;
const teamBg = teamBgMap[team.data.constructorName] || null;
const teamSlug = team.id.split("/").pop();
const resolvedYear = year ?? team.data.season ?? "2025";
---

<a
  href={`/seasons/${resolvedYear}/constructors/${teamSlug}`}
  class="group block h-full"
>
  <article
    class="relative flex h-full flex-col overflow-hidden rounded-lg border border-slate-300 shadow-md transition-shadow hover:shadow-lg dark:border-slate-800"
  >
    {
      teamBg ? (
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 z-0"
          style={`background-image: url('${teamBg.src}'); background-size: cover; background-position: center; transform: scaleX(-1);`}
        />
      ) : null
    }
    <!-- Top overlay to improve legibility for title/avatars -->
    <div
      aria-hidden="true"
      class="z-5 pointer-events-none absolute inset-x-0 top-0 h-1/2"
    >
      <div
        class="h-full w-full bg-gradient-to-b from-black/60 to-transparent backdrop-blur-[3px]"
      >
      </div>
    </div>
    <div class="relative z-10 flex h-full flex-1 flex-col">
      {/* Team Section */}
      <div class="border-b border-slate-100/20 text-slate-100">
        <div class="p-4">
          <h3 class="mb-2 flex items-center justify-between text-lg font-bold">
            <span class="group-hover:underline">
              {team.data.constructorName}
            </span>
            <span class="rounded px-4 py-2 text-2xl font-semibold">
              {team.data.constructorPoints}
              <span class="text-base font-normal">pts</span>
            </span>
          </h3>

          {/* Driver Name + Avatars */}
          <div
            class="mt-2 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-start lg:gap-6"
          >
            {
              team.data.teamDrivers.map((driverName) => {
                let driverInfo = driverMap.get(driverName);
                return (
                  <div class="mb-1 flex items-center gap-2">
                    <div class="flex size-8 flex-shrink-0 items-center justify-center overflow-hidden rounded-full border border-slate-50/30 bg-slate-300/20 lg:size-10">
                      {driverInfo ? (
                        <Image
                          src={driverInfo.profileImage}
                          alt={driverName}
                          class="object-cover"
                          width={96}
                          height={96}
                          loading={teamIndex < eagerCount ? "eager" : "lazy"}
                        />
                      ) : (
                        <Image
                          src={placeholderBG}
                          alt={driverName}
                          class="object-cover"
                          width={32}
                          height={32}
                          loading={teamIndex < eagerCount ? "eager" : "lazy"}
                        />
                      )}
                    </div>
                    <span class="text-sm">{driverName}</span>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>

      {/* Car Image - always flush to bottom, with blur overlay only here */}
      <div class="relative overflow-hidden px-4 pt-8">
        {/* Blurred background layer */}
        <div
          class="pointer-events-none absolute inset-0 z-0 backdrop-blur-[4px]"
        >
        </div>
        {/* Car image stays sharp above the blur */}
        <Image
          src={team.data.carImageLarge || team.data.carImage}
          alt={`${team.data.constructorName} ${team.data.carModel}`}
          class="relative z-10 w-full object-cover"
          loading={teamIndex < eagerCount ? "eager" : "lazy"}
        />
      </div>
    </div>
  </article>
</a>
