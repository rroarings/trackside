---
import type { CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import { teamBgMap } from "../utils/teamBgMap";
import { getSlugFromEntry } from "../utils/slugUtils";
import placeholderBG from "../assets/component/teamCard-placeholder.png";

interface Props {
  team: CollectionEntry<"constructors">;
  driverMap: Map<
    string,
    { profileImage: string; slug: string; countryCode: string }
  >;
  teamIndex: number;
  eagerCount?: number;
  year?: string;
}

const { team, driverMap, teamIndex, eagerCount = 4, year } = Astro.props;
const teamBgRaw = teamBgMap[team.data.constructorName] || null;
const teamBg = teamBgRaw
  ? (await getImage({ src: teamBgRaw, format: "webp", width: 800 })).src
  : null;
const teamSlug = getSlugFromEntry(team);
const resolvedYear = year ?? team.data.season ?? "2025";

const teamAccentMap: Record<string, string> = {
  McLaren: "rgb(249 115 22)",
  Ferrari: "rgb(220 38 38)",
  Mercedes: "rgb(20 184 166)",
  Williams: "rgb(37 99 235)",
  "Red Bull Racing": "rgb(59 130 246)",
  "Kick Sauber": "rgb(34 197 94)",
  "Racing Bulls": "rgb(6 182 212)",
  "Aston Martin": "rgb(16 185 129)",
  Haas: "rgb(239 68 68)",
  Alpine: "rgb(14 165 233)",
  Cadillac: "rgb(244 63 94)",
  Audi: "rgb(220 38 38)",
};

const teamAccent = teamAccentMap[team.data.constructorName] || "rgb(244 63 94)";
const teamCode = team.data.constructorName
  .split(" ")
  .map((word) => word[0])
  .join("")
  .slice(0, 3)
  .toUpperCase();
const cardBackgroundStyle = teamBg
  ? `--team-accent:${teamAccent}; background-image: linear-gradient(to top, rgb(9 9 11 / 0.88), rgb(9 9 11 / 0.24)), url('${teamBg}'); background-size: cover; background-position: center;`
  : `--team-accent:${teamAccent}; background-image: linear-gradient(to top, rgb(9 9 11 / 0.88), rgb(9 9 11 / 0.24));`;
---

<a
  href={`/seasons/${resolvedYear}/constructors/${teamSlug}`}
  class="group block h-full rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500/80 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-100 dark:focus-visible:ring-offset-zinc-900"
>
  <article
    class="team-card relative flex h-full flex-col overflow-hidden rounded-md border border-zinc-300/80 dark:border-zinc-700/70"
    style={cardBackgroundStyle}
  >
    <div class="pointer-events-none absolute inset-0 bg-zinc-900/12 dark:bg-zinc-900/24"></div>
    <div class="team-corner team-corner-top" aria-hidden="true"></div>
    <div class="team-corner team-corner-bottom" aria-hidden="true"></div>
    <div class="h-1.5 w-full bg-linear-to-r from-transparent via-(--team-accent) to-transparent"></div>

    <div class="relative z-10 flex h-full flex-1 flex-col">
      <div class="border-b border-zinc-100/20 text-zinc-100">
        <div class="p-4">
          <div class="mb-2 inline-flex items-center gap-2 rounded-sm border border-zinc-200/30 bg-zinc-950/55 px-2 py-1 text-[10px] font-semibold uppercase tracking-widest text-zinc-100">
            <span class="h-1.5 w-1.5 rounded-full bg-zinc-300"></span>
            Constructor Profile
          </div>

          <h3 class="mb-3 flex items-start justify-between gap-3">
            <span class="text-2xl font-black uppercase tracking-tight text-zinc-100 transition-colors duration-250 group-hover:text-zinc-50 md:text-3xl">
              {team.data.constructorName}
            </span>
            <span class="rounded-md border border-zinc-200/25 bg-zinc-950/55 px-3 py-2 text-right">
              <span class="block text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-300">
                Points
              </span>
              <span class="text-2xl font-black leading-none text-zinc-100">
                {team.data.constructorPoints}
                <span class="text-xs font-semibold uppercase tracking-wider text-zinc-300"> pts</span>
              </span>
            </span>
          </h3>

          <div class="mb-3 font-semibold uppercase tracking-[0.14em] text-zinc-200">
            {team.data.carModel}
          </div>

          <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
            {
              team.data.teamDrivers.map((driverName) => {
                let driverInfo = driverMap.get(driverName);
                return (
                  <div class="flex items-center gap-2 rounded-sm border border-zinc-200/20 bg-zinc-950/45 px-2 py-2">
                    <div class="flex size-8 shrink-0 items-center justify-center overflow-hidden rounded-full border border-zinc-50/30 bg-zinc-300/20">
                      {driverInfo ? (
                        <Image
                          src={driverInfo.profileImage}
                          alt={driverName}
                          class="object-cover"
                          width={96}
                          height={96}
                          loading={teamIndex < eagerCount ? "eager" : "lazy"}
                        />
                      ) : (
                        <Image
                          src={placeholderBG}
                          alt={driverName}
                          class="object-cover"
                          width={96}
                          height={96}
                          loading={teamIndex < eagerCount ? "eager" : "lazy"}
                        />
                      )}
                    </div>
                    <span class="text-sm text-zinc-100">{driverName}</span>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>

      <div class="relative mt-auto overflow-hidden px-4 pt-8">
        
        <Image
          src={team.data.carImageLarge || team.data.carImage}
          alt={`${team.data.constructorName} ${team.data.carModel}`}
          class="team-car-image relative z-10 w-full object-contain"
          loading={teamIndex < eagerCount ? "eager" : "lazy"}
        />
      </div>

      <div class="mx-4 mb-3 mt-1 flex items-center justify-between border-t border-zinc-200/20 pt-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-200">
        <span class="inline-flex items-center gap-1.5 transition-colors duration-250 group-hover:text-rose-400">
          <span class="h-1.5 w-1.5 rounded-full bg-zinc-300"></span>
          View Team Details
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="h-1 w-1 rounded-full bg-zinc-300/90"></span>
          <span class="h-1 w-1 rounded-full bg-zinc-300/65"></span>
          <span class="h-1 w-1 rounded-full bg-zinc-300/40"></span>
        </span>
      </div>
    </div>
  </article>
</a>

<style>
  .team-card {
    background-color: rgb(24 24 27);
    transition:
      transform 250ms ease,
      box-shadow 250ms ease,
      border-color 250ms ease;
  }

  .team-corner {
    position: absolute;
    width: 22px;
    height: 22px;
    border-top: 1px solid rgb(255 255 255 / 0.2);
    z-index: 5;
  }

  .team-corner-top {
    right: 9px;
    top: 9px;
    transform: skew(18deg);
  }

  .team-corner-bottom {
    left: 9px;
    bottom: 9px;
    transform: skew(-18deg);
  }

  .team-car-image {
    transition: transform 240ms ease;
  }

  .group:hover .team-card {
    transform: translateY(-4px);
    border-color: rgb(212 212 216 / 0.45);
    box-shadow: 0 16px 34px rgb(0 0 0 / 0.35);
  }

  .group:hover .team-car-image {
    transform: translateY(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card,
    .team-car-image,
    .group:hover .team-card,
    .group:hover .team-car-image {
      transition: none;
      transform: none;
      box-shadow: none;
    }
  }
</style>
