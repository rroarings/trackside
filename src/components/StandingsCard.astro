---
import type { CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import { teamBgMap } from "../utils/teamBgMap";
import norrisImg from "../assets/constructors/mclaren/drivers/norris-02.png";
import piastriImg from "../assets/constructors/mclaren/drivers/piastri-02.png";
import verstappenImg from "../assets/constructors/red-bull-racing/drivers/verstappen-02.png";
import leclercImg from "../assets/constructors/ferrari/drivers/leclerc-02.png";
import placeholderBG from "../assets/component/teamCard-placeholder.png";

interface Props {
  season: "2024" | "2025" | "2026";
  imageLoading?: "eager" | "lazy";
  sortedDrivers: CollectionEntry<"drivers">[];
}

const { season, imageLoading = "lazy", sortedDrivers } = Astro.props;

const driverImageMap: Record<string, typeof norrisImg> = {
  Norris: norrisImg,
  Piastri: piastriImg,
  Verstappen: verstappenImg,
  Leclerc: leclercImg,
};

const topThree = sortedDrivers.slice(0, 3);

const displayOrder =
  topThree.length === 3 ? [topThree[0], topThree[1], topThree[2]] : topThree;

const podiumAccentClasses = ["bg-amber-400", "bg-zinc-300", "bg-orange-500"];

// Pre-process background images to WebP format
const optimizedBgImages = await Promise.all(
  displayOrder.map(async (driver) => {
    const teamBg = teamBgMap[driver.data.driverTeam];
    if (teamBg) {
      const optimized = await getImage({
        src: teamBg,
        format: "webp",
        width: 800,
      });
      return optimized.src;
    }
    return null;
  }),
);
---

<div
  class="grid grid-cols-1 gap-4 pb-16 md:grid-cols-2 md:grid-rows-2 lg:grid-cols-3 lg:grid-rows-1"
>
  {
    displayOrder.map((driver, index) => {
      const bgUrl = optimizedBgImages[index];
      const slug = (driver as any).slug ?? driver.id.split("/").pop();
      const gridClasses = [
        "md:col-span-2 md:row-start-1 lg:col-span-1 lg:row-start-auto",
        "md:col-start-1 md:row-start-2 lg:col-span-1 lg:row-start-auto",
        "md:col-start-2 md:row-start-2 lg:col-span-1 lg:row-start-auto",
      ];

      return (
        <div class={gridClasses[index]}>
          <a href={`/seasons/${season}/drivers/${slug}`} class="block">
            <article
              class="group relative h-96 overflow-hidden rounded-2xl border border-zinc-200/20 transition-shadow duration-300 hover:shadow-2xl"
              style={
                bgUrl
                  ? `background-image: url('${bgUrl}'); background-size: cover; background-position: center;`
                  : ""
              }
            >
              {/* Podium top accent */}
              <div
                class={`absolute inset-x-0 top-0 z-10 h-1 ${podiumAccentClasses[index]}`}
              />
              {/* Bottom-up darkening gradient */}
              <div class="bg-linear-to-b pointer-events-none absolute inset-0 from-zinc-950/25 via-zinc-950/10 to-zinc-950/75" />
              {/* Driver image — absolutely pinned bottom-right, out of flow */}
              <Image
                src={
                  driver.data.profileImage ||
                  driverImageMap[driver.data.driverLastName as string] ||
                  placeholderBG
                }
                alt={`Portrait of ${driver.data.driverFirstName} ${driver.data.driverLastName}`}
                class="z-1 absolute bottom-0 right-0 h-[110%] w-auto object-contain object-bottom"
                width={400}
                height={400}
                loading={imageLoading}
              />
              {/* Left gradient mask — keeps text readable over the image */}
              <div class="z-2 bg-linear-to-r pointer-events-none absolute inset-y-0 left-0 w-3/5 from-zinc-950/80 to-transparent" />
              {/* Text content */}
              <div class="relative z-10 flex h-full flex-col justify-between px-6 py-5">
                <div>
                  <div class="flex items-start justify-between gap-4">
                    <p class="text-[4.5rem] font-bold leading-none tracking-[-0.06em] text-white/90 sm:text-[5.5rem]">
                      {driver.data.championshipPosition}
                    </p>
                    <p class="pt-3 text-right text-2xl font-bold text-white">
                      {driver.data.driverPoints}
                      <span class="ml-1 text-sm font-medium uppercase tracking-[0.18em] text-zinc-200">
                        PTS
                      </span>
                    </p>
                  </div>
                  <h3 class="text-3xl leading-none text-white sm:text-4xl">
                    {driver.data.driverFirstName}
                  </h3>
                  <h3 class="text-4xl font-bold leading-none text-white transition-colors duration-300 group-hover:text-rose-300 sm:text-5xl">
                    {driver.data.driverLastName}
                  </h3>
                  <p class="mt-3 text-sm font-semibold uppercase tracking-[0.22em] text-zinc-200">
                    {driver.data.driverTeam}
                  </p>
                </div>
              </div>
            </article>
          </a>
        </div>
      );
    })
  }
</div>
