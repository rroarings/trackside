---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import norrisImg from "../assets/constructors/mclaren/drivers/norris-02.png";
import piastriImg from "../assets/constructors/mclaren/drivers/piastri-02.png";
import verstappenImg from "../assets/constructors/red-bull-racing/drivers/verstappen-02.png";
import leclercImg from "../assets/constructors/ferrari/drivers/leclerc-02.png";

interface Props {
  season: "2024" | "2025";
  imageLoading?: "eager" | "lazy";
}

const { season, imageLoading = "lazy" } = Astro.props;

const driverImageMap: Record<string, typeof norrisImg> = {
  Norris: norrisImg,
  Piastri: piastriImg,
  Verstappen: verstappenImg,
  Leclerc: leclercImg,
};

const allDrivers = await getCollection("drivers");
const seasonDrivers = allDrivers.filter(
  (driver) => driver.data.season === season,
);

const sortedDrivers = seasonDrivers.sort(
  (a, b) => a.data.championshipPosition - b.data.championshipPosition,
);

const topThree = sortedDrivers.slice(0, 3);

const displayOrder =
  topThree.length === 3 ? [topThree[1], topThree[0], topThree[2]] : topThree;
---

<div class="grid grid-cols-1 items-center gap-8 pb-16 pt-8 md:grid-cols-3">
  {
    displayOrder.map((driver) => (
      <div
        class:list={[
          "rounded-lg p-6 text-left transition-transform duration-300",
          {
            "border-1 transform border-red-300 md:scale-110 dark:border-slate-500":
              driver.data.championshipPosition === 1,
            "border border-gray-200 dark:border-slate-700":
              driver.data.championshipPosition !== 1,
          },
        ]}
      >
        <Image
          src={
            driverImageMap[driver.data.driverLastName as string] ||
            driver.data.profileImage
          }
          alt={`Portrait of ${driver.data.driverFirstName} ${driver.data.driverLastName}`}
          class="mx-auto mb-4 h-32 w-32 rounded-full object-cover"
          width={128}
          height={128}
          loading={imageLoading}
        />
        <h3 class="text-xl font-bold text-gray-900 dark:text-slate-100">{`${driver.data.driverFirstName} ${driver.data.driverLastName}`}</h3>
        <p class="text-gray-600 dark:text-slate-300">
          {driver.data.driverTeam}
        </p>
        <div class="mt-4 text-center dark:text-slate-100">
          <p class="text-3xl font-bold">
            {driver.data.driverPoints} <span class="text-sm">pts</span>
          </p>
          <p class="text-sm text-gray-500 dark:text-slate-200">
            P{driver.data.championshipPosition}
          </p>
        </div>
      </div>
    ))
  }
</div>
