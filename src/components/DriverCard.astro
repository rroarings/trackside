---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { teamBgMap } from "../utils/teamBgMap";
import { getSlugFromEntry } from "../utils/slugUtils";
import placeholderBG from "../assets/component/teamCard-placeholder.png";

interface Props {
  /** The driver collection entry to display */
  driver: CollectionEntry<"drivers">;
  /** The season year for building the driver profile link (e.g. "2024", "2025", "2026") */
  year: string;
  /** Card index for determining image loading priority */
  index: number;
  /** Number of cards to eagerly load images for (defaults to 0) */
  eagerCount?: number;
}

const { driver, year, index, eagerCount = 0 } = Astro.props;
const teamBg = teamBgMap[driver.data.driverTeam] || null;
const imageLoading = index < eagerCount ? "eager" : "lazy";
const driverSlug = getSlugFromEntry(driver);

const teamAccentMap: Record<string, string> = {
  McLaren: "rgb(249 115 22)",
  Ferrari: "rgb(220 38 38)",
  Mercedes: "rgb(20 184 166)",
  Williams: "rgb(37 99 235)",
  "Red Bull Racing": "rgb(59 130 246)",
  "Kick Sauber": "rgb(34 197 94)",
  "Racing Bulls": "rgb(6 182 212)",
  "Aston Martin": "rgb(16 185 129)",
  Haas: "rgb(239 68 68)",
  Alpine: "rgb(14 165 233)",
  Cadillac: "rgb(244 63 94)",
  Audi: "rgb(220 38 38)",
};

const teamAccent = teamAccentMap[driver.data.driverTeam] || "rgb(236 72 153)";
const driverInitials = `${driver.data.driverFirstName?.[0] ?? ""}${driver.data.driverLastName?.[0] ?? ""}`.toUpperCase();
const cardBackgroundStyle = teamBg
  ? `--driver-accent:${teamAccent}; background-image: linear-gradient(to top, rgb(9 9 11 / 0.82), rgb(9 9 11 / 0.18)), url('${teamBg.src}'); background-size: cover; background-position: center;`
  : `--driver-accent:${teamAccent}; background-image: linear-gradient(to top, rgb(9 9 11 / 0.82), rgb(9 9 11 / 0.18));`;
---

<a
  href={`/seasons/${year}/drivers/${driverSlug}`}
  class="group block h-full rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500/80 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-100 dark:focus-visible:ring-offset-zinc-900"
>
  <article
    class="driver-card relative h-full overflow-hidden rounded-md border border-zinc-300/80 dark:border-zinc-700/70"
    style={cardBackgroundStyle}
  >
    <div class="pointer-events-none absolute inset-0 bg-zinc-900/12 dark:bg-zinc-900/22"></div>
    <div class="driver-corner driver-corner-top" aria-hidden="true"></div>
    <div class="driver-corner driver-corner-bottom" aria-hidden="true"></div>
    <div class="h-1.5 w-full bg-linear-to-r from-transparent via-(--driver-accent) to-transparent"></div>

    <div class="relative z-10 flex h-full flex-col justify-between p-4 pb-0">
      <div class="flex items-start justify-between gap-4">
        <div class="flex flex-col">
          <div class="mb-2 inline-flex w-fit items-center gap-2 rounded-sm border border-zinc-200/30 bg-zinc-950/55 px-2 py-1 text-[10px] font-semibold uppercase tracking-widest text-zinc-100">
            <span class="h-1.5 w-1.5 rounded-full bg-zinc-300"></span>
            Driver Profile
          </div>

          <h3>
            <span class="block text-xl font-semibold uppercase tracking-[0.14em] text-zinc-200">
              {driver.data.driverFirstName}
            </span>
            <span class="block text-3xl font-black uppercase leading-tight tracking-tight text-zinc-100 transition-colors duration-250 group-hover:text-zinc-50 md:text-4xl">
              {driver.data.driverLastName}
            </span>
          </h3>

          <div class="mt-3 flex flex-wrap items-center gap-2">
            <span class="inline-flex rounded-sm border border-zinc-200/25 bg-zinc-950/45 px-2 py-1 text-[11px] font-semibold uppercase tracking-wider text-zinc-200">
              {driver.data.driverTeam}
            </span>
            <span class="inline-flex rounded-sm border border-zinc-200/25 bg-zinc-950/45 px-2 py-1 text-[11px] font-semibold uppercase tracking-wider text-zinc-200">
              #{driver.data.driverNumber}
            </span>
            <span
              class={`fi fi-${driver.data.countryCode} h-4 w-6 rounded-sm border border-zinc-200/70`}
              aria-hidden="true"></span>
          </div>
        </div>

        <div class="rounded-md border border-zinc-200/25 bg-zinc-950/55 px-3 py-2 text-right">
          <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-zinc-300">
            Points
          </p>
          <p class="text-2xl font-black leading-none text-zinc-100">
            {driver.data.driverPoints}
            <span class="text-xs font-semibold uppercase tracking-wider text-zinc-300"></span>
          </p>
        </div>
      </div>

      <div class="relative mt-4 flex justify-end overflow-hidden">
        <p class="pointer-events-none absolute bottom-4 left-1 z-0 text-7xl font-black uppercase tracking-tight text-zinc-100/14 md:text-8xl">
          {driverInitials}
        </p>
        <Image
          src={driver.data.profileImage || placeholderBG}
          alt={`${driver.data.driverFirstName} ${driver.data.driverLastName}`}
          class="driver-image relative z-10 object-contain object-bottom"
          height={400}
          width={400}
          loading={imageLoading}
        />
      </div>

      <div class="mb-3 mt-1 flex items-center justify-between border-t border-zinc-200/20 pt-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-200">
        <span class="inline-flex items-center gap-1.5 transition-colors duration-250 group-hover:text-rose-400">
          <span class="h-1.5 w-1.5 rounded-full bg-zinc-300"></span>
          View Profile
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="h-1 w-1 rounded-full bg-zinc-300/90"></span>
          <span class="h-1 w-1 rounded-full bg-zinc-300/65"></span>
          <span class="h-1 w-1 rounded-full bg-zinc-300/40"></span>
        </span>
      </div>
    </div>
  </article>
</a>

<style>
  .driver-card {
    background-color: rgb(24 24 27);
    transition:
      transform 250ms ease,
      box-shadow 250ms ease,
      border-color 250ms ease;
  }

  .driver-corner {
    position: absolute;
    width: 22px;
    height: 22px;
    border-top: 1px solid rgb(255 255 255 / 0.2);
    z-index: 5;
  }

  .driver-corner-top {
    right: 9px;
    top: 9px;
    transform: skew(18deg);
  }

  .driver-corner-bottom {
    left: 9px;
    bottom: 9px;
    transform: skew(-18deg);
  }

  .driver-image {
    transition: transform 240ms ease;
  }

  .group:hover .driver-card {
    transform: translateY(-4px);
    border-color: rgb(212 212 216 / 0.45);
    box-shadow: 0 16px 34px rgb(0 0 0 / 0.35);
  }

  .group:hover .driver-image {
    transform: translateY(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .driver-card,
    .driver-image,
    .group:hover .driver-card,
    .group:hover .driver-image {
      transition: none;
      transform: none;
      box-shadow: none;
    }
  }
</style>
