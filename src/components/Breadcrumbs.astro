---
interface BreadcrumbItem {
  text: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumbs" class="mb-2">
  <ol
    class="mb-8 flex items-center space-x-2 text-base text-slate-800 dark:text-slate-400"
  >
    {
      items.map((item, index) => (
        <>
          <li>
            {item.href ? (
              <a
                href={item.href}
                class="hover:text-sky-600 dark:hover:text-slate-300"
              >
                {item.text}
              </a>
            ) : (
              <span>{item.text}</span>
            )}
          </li>
          {index < items.length - 1 && (
            <li>
              <span class="">•</span>
            </li>
          )}
        </>
      ))
    }
  </ol>
</nav>
